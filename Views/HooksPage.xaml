<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkanyxxMaui.Views.HooksPage"
             Title="Hooks"
             BackgroundColor="#0a0a0a">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24">

            <!-- Header -->
            <Label Text="Hooks" FontSize="28" FontAttributes="Bold" TextColor="#ffffff"/>

            <!-- Hook Manager Card -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                    <Frame Grid.Column="0" BackgroundColor="#f59e0b" WidthRequest="44" HeightRequest="44"
                           CornerRadius="10" Padding="0" BorderColor="Transparent">
                        <Label Text="⤢" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Hook Manager" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                        <Label Text="Configure automation hooks and event triggers" FontSize="15" TextColor="#808080"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="↻ Refresh" BackgroundColor="#2a2a2a" TextColor="#ffffff"
                            FontSize="14" BorderColor="#404040" BorderWidth="1" CornerRadius="8"
                            HeightRequest="40" VerticalOptions="Center"/>
                    <Button Grid.Column="3" Text="+ Add Hook" BackgroundColor="#6366f1" TextColor="White"
                            FontSize="14" CornerRadius="8" HeightRequest="40" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Hook Types -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <!-- Webhooks -->
                <Frame Grid.Column="0" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="20" CornerRadius="12">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="◎" FontSize="18" TextColor="#808080"/>
                            <Label Text="Webhooks" FontSize="16" FontAttributes="Bold" TextColor="#ffffff"/>
                        </HorizontalStackLayout>
                        <Label Text="0 configured" FontSize="14" TextColor="#808080"/>
                    </VerticalStackLayout>
                </Frame>
                <!-- Event Triggers -->
                <Frame Grid.Column="1" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="20" CornerRadius="12">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⤢" FontSize="18" TextColor="#808080"/>
                            <Label Text="Event Triggers" FontSize="16" FontAttributes="Bold" TextColor="#ffffff"/>
                        </HorizontalStackLayout>
                        <Label Text="0 configured" FontSize="14" TextColor="#808080"/>
                    </VerticalStackLayout>
                </Frame>
                <!-- Scheduled -->
                <Frame Grid.Column="2" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="20" CornerRadius="12">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="◷" FontSize="18" TextColor="#808080"/>
                            <Label Text="Scheduled" FontSize="16" FontAttributes="Bold" TextColor="#ffffff"/>
                        </HorizontalStackLayout>
                        <Label Text="0 configured" FontSize="14" TextColor="#808080"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Empty State -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="60" CornerRadius="12">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Frame BackgroundColor="#2a2a2a" WidthRequest="80" HeightRequest="80"
                           CornerRadius="40" Padding="0" BorderColor="Transparent" HorizontalOptions="Center">
                        <Label Text="⤢" FontSize="36" TextColor="#404040"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="No Hooks Found" FontSize="22" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center"/>
                    <Label Text="Create hooks to automate workflows and trigger actions"
                           FontSize="16" TextColor="#808080" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Button Text="+ Create Your First Hook" BackgroundColor="#6366f1" TextColor="White"
                            FontSize="16" CornerRadius="8" HeightRequest="48" Padding="24,0"
                            HorizontalOptions="Center" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
