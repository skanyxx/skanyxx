<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkanyxxMaui.Views.InvestigatePage"
             Title="Investigate"
             BackgroundColor="#0a0a0a">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="8">
                    <Label Text="Investigation Templates"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#ffffff"/>
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="6 templates available"
                       FontSize="16" TextColor="#808080" VerticalOptions="Center"/>
            </Grid>

            <!-- Production Incident P0 -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="14">
                            <Frame BackgroundColor="#ff4444" WidthRequest="44" HeightRequest="44"
                                   CornerRadius="10" Padding="0" BorderColor="Transparent">
                                <Label Text="!" FontSize="22" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Production Incident" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <Label Text="Immediate response for critical production issues" FontSize="15" TextColor="#808080"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Frame Grid.Column="2" BackgroundColor="#ff4444" Padding="10,6" CornerRadius="6" BorderColor="Transparent">
                            <Label Text="P0" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="✓ k8s-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ observability-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ promql-agent" FontSize="14" TextColor="#00d4aa"/>
                    </HorizontalStackLayout>
                    <Frame BackgroundColor="#2a2a2a" BorderColor="#333333" Padding="12,10" CornerRadius="8">
                        <Label Text="3 of 3 agents available" FontSize="14" TextColor="#808080"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Performance Degradation P1 -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="14">
                            <Frame BackgroundColor="#3b82f6" WidthRequest="44" HeightRequest="44"
                                   CornerRadius="10" Padding="0" BorderColor="Transparent">
                                <Label Text="◧" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Performance Degradation" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <Label Text="Analyze slow response times and resource usage" FontSize="15" TextColor="#808080"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Frame Grid.Column="2" BackgroundColor="#3b82f6" Padding="10,6" CornerRadius="6" BorderColor="Transparent">
                            <Label Text="P1" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="✓ promql-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ observability-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ k8s-agent" FontSize="14" TextColor="#00d4aa"/>
                    </HorizontalStackLayout>
                    <Frame BackgroundColor="#2a2a2a" BorderColor="#333333" Padding="12,10" CornerRadius="8">
                        <Label Text="3 of 3 agents available" FontSize="14" TextColor="#808080"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Deployment Rollback P2 -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="14">
                            <Frame BackgroundColor="#22c55e" WidthRequest="44" HeightRequest="44"
                                   CornerRadius="10" Padding="0" BorderColor="Transparent">
                                <Label Text="↩" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Deployment Rollback" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <Label Text="Investigate failed deployments and rollback" FontSize="15" TextColor="#808080"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Frame Grid.Column="2" BackgroundColor="#22c55e" Padding="10,6" CornerRadius="6" BorderColor="Transparent">
                            <Label Text="P2" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="✓ k8s-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ argo-rollouts-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ helm-agent" FontSize="14" TextColor="#00d4aa"/>
                    </HorizontalStackLayout>
                    <Frame BackgroundColor="#2a2a2a" BorderColor="#333333" Padding="12,10" CornerRadius="8">
                        <Label Text="2 of 3 agents available" FontSize="14" TextColor="#808080"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Network Connectivity P1 -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="14">
                            <Frame BackgroundColor="#22c55e" WidthRequest="44" HeightRequest="44"
                                   CornerRadius="10" Padding="0" BorderColor="Transparent">
                                <Label Text="◎" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Network Connectivity" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <Label Text="Diagnose service mesh and network issues" FontSize="15" TextColor="#808080"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Frame Grid.Column="2" BackgroundColor="#3b82f6" Padding="10,6" CornerRadius="6" BorderColor="Transparent">
                            <Label Text="P1" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="✓ cilium-debug-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ istio-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ kgateway-agent" FontSize="14" TextColor="#808080"/>
                    </HorizontalStackLayout>
                    <Frame BackgroundColor="#2a2a2a" BorderColor="#333333" Padding="12,10" CornerRadius="8">
                        <Label Text="3 of 3 agents available" FontSize="14" TextColor="#808080"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Security Alert P0 -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="14">
                            <Frame BackgroundColor="#ff4444" WidthRequest="44" HeightRequest="44"
                                   CornerRadius="10" Padding="0" BorderColor="Transparent">
                                <Label Text="◇" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Security Alert" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <Label Text="Investigate security incidents and vulnerabilities" FontSize="15" TextColor="#808080"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Frame Grid.Column="2" BackgroundColor="#ff4444" Padding="10,6" CornerRadius="6" BorderColor="Transparent">
                            <Label Text="P0" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="✓ k8s-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ cilium-debug-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ observability-agent" FontSize="14" TextColor="#00d4aa"/>
                    </HorizontalStackLayout>
                    <Frame BackgroundColor="#2a2a2a" BorderColor="#333333" Padding="12,10" CornerRadius="8">
                        <Label Text="3 of 3 agents available" FontSize="14" TextColor="#808080"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Capacity Planning P1 -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="14">
                            <Frame BackgroundColor="#3b82f6" WidthRequest="44" HeightRequest="44"
                                   CornerRadius="10" Padding="0" BorderColor="Transparent">
                                <Label Text="▲" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Capacity Planning" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <Label Text="Resource utilization analysis and scaling" FontSize="15" TextColor="#808080"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <Frame Grid.Column="2" BackgroundColor="#3b82f6" Padding="10,6" CornerRadius="6" BorderColor="Transparent">
                            <Label Text="P1" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="✓ promql-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ observability-agent" FontSize="14" TextColor="#00d4aa"/>
                        <Label Text="✓ k8s-agent" FontSize="14" TextColor="#00d4aa"/>
                    </HorizontalStackLayout>
                    <Frame BackgroundColor="#2a2a2a" BorderColor="#333333" Padding="12,10" CornerRadius="8">
                        <Label Text="3 of 3 agents available" FontSize="14" TextColor="#808080"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
