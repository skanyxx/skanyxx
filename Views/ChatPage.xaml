<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkanyxxMaui.Views.ChatPage"
             Title="Chat"
             BackgroundColor="#0a0a0a">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24">

            <!-- Header -->
            <Label Text="Chat" FontSize="28" FontAttributes="Bold" TextColor="#ffffff"/>

            <!-- Agent: cilium manager agent -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="cilium manager agent" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <BoxView Color="#00d4aa" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="kagent" FontSize="14" TextColor="#808080"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Cilium manager agent knows how to install, configure, monitor, and troubleshoot Cilium in Kubernetes environments"
                           FontSize="15" TextColor="#b3b3b3" LineBreakMode="WordWrap"/>
                    <Button Text="Start Chat" BackgroundColor="#6366f1" TextColor="White" FontSize="15"
                            CornerRadius="8" HeightRequest="44" WidthRequest="120" HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Agent: cilium-policy-agent -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="cilium-policy-agent" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <BoxView Color="#00d4aa" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="kagent" FontSize="14" TextColor="#808080"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Cilium policy agent knows how to create CiliumNetworkPolicy and CiliumClusterwideNetworkPolicy resources from natural language"
                           FontSize="15" TextColor="#b3b3b3" LineBreakMode="WordWrap"/>
                    <Button Text="Start Chat" BackgroundColor="#6366f1" TextColor="White" FontSize="15"
                            CornerRadius="8" HeightRequest="44" WidthRequest="120" HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Agent: istio-agent -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="istio-agent" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <BoxView Color="#00d4aa" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="kagent" FontSize="14" TextColor="#808080"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="An Istio Expert AI Agent specializing in Istio operations, troubleshooting, and maintenance."
                           FontSize="15" TextColor="#b3b3b3" LineBreakMode="WordWrap"/>
                    <Button Text="Start Chat" BackgroundColor="#6366f1" TextColor="White" FontSize="15"
                            CornerRadius="8" HeightRequest="44" WidthRequest="120" HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Agent: k8s-agent -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="k8s-agent" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                                <BoxView Color="#00d4aa" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="kagent" FontSize="14" TextColor="#808080"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="An Kubernetes Expert AI Agent specializing in cluster operations, troubleshooting, and maintenance."
                           FontSize="15" TextColor="#b3b3b3" LineBreakMode="WordWrap"/>
                    <Button Text="Start Chat" BackgroundColor="#6366f1" TextColor="White" FontSize="15"
                            CornerRadius="8" HeightRequest="44" WidthRequest="120" HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
