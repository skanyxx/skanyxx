<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkanyxxMaui.Views.MemoryPage"
             Title="Memory"
             BackgroundColor="#0a0a0a">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24">

            <!-- Header -->
            <Label Text="Memory" FontSize="28" FontAttributes="Bold" TextColor="#ffffff"/>

            <!-- Memory Management Card -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                    <Frame Grid.Column="0" BackgroundColor="#e879f9" WidthRequest="44" HeightRequest="44"
                           CornerRadius="10" Padding="0" BorderColor="Transparent">
                        <Label Text="◉" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Memory Management" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                        <Label Text="Manage knowledge bases and memory providers for persistent context" FontSize="15" TextColor="#808080"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Text="↻ Refresh" BackgroundColor="#2a2a2a" TextColor="#ffffff"
                            FontSize="14" BorderColor="#404040" BorderWidth="1" CornerRadius="8"
                            HeightRequest="40" VerticalOptions="Center"/>
                    <Button Grid.Column="3" Text="+ Add Memory" BackgroundColor="#6366f1" TextColor="White"
                            FontSize="14" CornerRadius="8" HeightRequest="40" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Empty State -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="60" CornerRadius="12">
                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Frame BackgroundColor="#2a2a2a" WidthRequest="80" HeightRequest="80"
                           CornerRadius="40" Padding="0" BorderColor="Transparent" HorizontalOptions="Center">
                        <Label Text="▢" FontSize="36" TextColor="#404040"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="No Memory Providers" FontSize="22" FontAttributes="Bold" TextColor="#ffffff" HorizontalOptions="Center"/>
                    <Label Text="Set up memory providers to enable persistent knowledge storage"
                           FontSize="16" TextColor="#808080" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Button Text="+ Add Memory Provider" BackgroundColor="#6366f1" TextColor="White"
                            FontSize="16" CornerRadius="8" HeightRequest="48" Padding="24,0"
                            HorizontalOptions="Center" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
