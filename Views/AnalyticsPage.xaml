<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkanyxxMaui.Views.AnalyticsPage"
             Title="Analytics"
             BackgroundColor="#0a0a0a">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24">

            <!-- Header -->
            <Label Text="Analytics" FontSize="28" FontAttributes="Bold" TextColor="#ffffff"/>

            <!-- Session Analytics Card -->
            <Frame BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                    <Frame Grid.Column="0" BackgroundColor="#00d4aa" WidthRequest="44" HeightRequest="44"
                           CornerRadius="22" Padding="0" BorderColor="Transparent">
                        <Label Text="◧" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="Session Analytics" FontSize="20" FontAttributes="Bold" TextColor="#ffffff"/>
                        <Label Text="Insights into your investigation patterns and tool usage" FontSize="15" TextColor="#808080"/>
                    </VerticalStackLayout>
                    <Frame Grid.Column="2" BackgroundColor="#2a2a2a" BorderColor="#404040" Padding="12,8" CornerRadius="8">
                        <Label Text="Last 7 days ▼" FontSize="14" TextColor="#ffffff"/>
                    </Frame>
                    <Button Grid.Column="3" Text="↻ Refresh" BackgroundColor="#2a2a2a" TextColor="#ffffff"
                            FontSize="14" BorderColor="#404040" BorderWidth="1" CornerRadius="8"
                            HeightRequest="40" VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Stats Grid -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <!-- Total Sessions -->
                <Frame Grid.Column="0" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="20" CornerRadius="12">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Total Sessions" FontSize="14" TextColor="#808080"/>
                            <Label Text="◎" FontSize="16" TextColor="#808080"/>
                        </HorizontalStackLayout>
                        <Label Text="0" FontSize="36" FontAttributes="Bold" TextColor="#ffffff"/>
                        <Label Text="↗ +12% vs last period" FontSize="13" TextColor="#00d4aa"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Total Messages -->
                <Frame Grid.Column="1" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="20" CornerRadius="12">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Total Messages" FontSize="14" TextColor="#808080"/>
                            <Label Text="◱" FontSize="16" TextColor="#808080"/>
                        </HorizontalStackLayout>
                        <Label Text="0" FontSize="36" FontAttributes="Bold" TextColor="#ffffff"/>
                        <Label Text="↗ +8% vs last period" FontSize="13" TextColor="#00d4aa"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Total Tokens -->
                <Frame Grid.Column="2" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="20" CornerRadius="12">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Total Tokens" FontSize="14" TextColor="#808080"/>
                            <Label Text="◈" FontSize="16" TextColor="#808080"/>
                        </HorizontalStackLayout>
                        <Label Text="0" FontSize="36" FontAttributes="Bold" TextColor="#ffffff"/>
                        <Label Text="↘ -3% vs last period" FontSize="13" TextColor="#ff4444"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Avg Duration -->
                <Frame Grid.Column="3" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="20" CornerRadius="12">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Avg Duration" FontSize="14" TextColor="#808080"/>
                            <Label Text="◷" FontSize="16" TextColor="#808080"/>
                        </HorizontalStackLayout>
                        <Label Text="0m" FontSize="36" FontAttributes="Bold" TextColor="#ffffff"/>
                        <Label Text="↗ +5% vs last period" FontSize="13" TextColor="#00d4aa"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Charts Row -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Most Used Tools -->
                <Frame Grid.Column="0" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                    <VerticalStackLayout Spacing="20">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Most Used Tools" FontSize="18" FontAttributes="Bold" TextColor="#ffffff"/>
                            <Label Text="▲" FontSize="16" TextColor="#808080"/>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40">
                            <Label Text="◧" FontSize="48" TextColor="#404040" HorizontalOptions="Center"/>
                            <Label Text="No tool usage data available" FontSize="15" TextColor="#808080" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Recent Sessions -->
                <Frame Grid.Column="1" BackgroundColor="#1a1a1a" BorderColor="#404040" Padding="24" CornerRadius="12">
                    <VerticalStackLayout Spacing="20">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Recent Sessions" FontSize="18" FontAttributes="Bold" TextColor="#ffffff"/>
                            <Label Text="▤" FontSize="16" TextColor="#808080"/>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" Padding="0,40">
                            <Label Text="▢" FontSize="48" TextColor="#404040" HorizontalOptions="Center"/>
                            <Label Text="No sessions found for this period" FontSize="15" TextColor="#808080" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
