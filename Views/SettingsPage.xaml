<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkanyxxMaui.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="#0a0a0a">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24">

            <!-- Page Title -->
            <Label Text="Settings"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#ffffff"/>

            <!-- Connectors Section -->
            <Frame BackgroundColor="#1a1a1a"
                   BorderColor="#404040"
                   Padding="24"
                   CornerRadius="12">
                <VerticalStackLayout Spacing="20">
                    <Label Text="KAgent Connectors"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#ffffff"/>
                    <Label Text="Manage your KAgent instance connections"
                           FontSize="16"
                           TextColor="#b3b3b3"/>

                    <!-- Connector Item -->
                    <Frame BackgroundColor="#2a2a2a"
                           BorderColor="#333333"
                           Padding="20" CornerRadius="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <BoxView Grid.Column="0"
                                     Color="#00d4aa"
                                     WidthRequest="12" HeightRequest="12"
                                     CornerRadius="6"
                                     VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Production KAgent"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#ffffff"/>
                                <Label Text="https://kagent.prod.company.com"
                                       FontSize="15"
                                       TextColor="#808080"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="Connected"
                                   FontSize="15"
                                   TextColor="#00d4aa"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <Frame BackgroundColor="#2a2a2a"
                           BorderColor="#333333"
                           Padding="20" CornerRadius="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <BoxView Grid.Column="0"
                                     Color="#ffb020"
                                     WidthRequest="12" HeightRequest="12"
                                     CornerRadius="6"
                                     VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Staging KAgent"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#ffffff"/>
                                <Label Text="https://kagent.staging.company.com"
                                       FontSize="15"
                                       TextColor="#808080"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="Connecting..."
                                   FontSize="15"
                                   TextColor="#ffb020"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <Button Text="+ Add Connector"
                            BackgroundColor="#2a2a2a"
                            TextColor="#ffffff"
                            FontSize="16"
                            BorderColor="#404040"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="52"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Application Settings -->
            <Frame BackgroundColor="#1a1a1a"
                   BorderColor="#404040"
                   Padding="24"
                   CornerRadius="12">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Application Settings"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#ffffff"/>

                    <Frame BackgroundColor="#2a2a2a"
                           BorderColor="#333333"
                           Padding="20" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Dark Mode"
                                       FontSize="17"
                                       TextColor="#ffffff"/>
                                <Label Text="Use dark theme throughout the app"
                                       FontSize="15"
                                       TextColor="#808080"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    x:Name="DarkModeSwitch"
                                    IsToggled="True"
                                    OnColor="#6366f1"
                                    ThumbColor="#ffffff"/>
                        </Grid>
                    </Frame>

                    <Frame BackgroundColor="#2a2a2a"
                           BorderColor="#333333"
                           Padding="20" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Notifications"
                                       FontSize="17"
                                       TextColor="#ffffff"/>
                                <Label Text="Receive alerts and notifications"
                                       FontSize="15"
                                       TextColor="#808080"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    x:Name="NotificationsSwitch"
                                    IsToggled="True"
                                    OnColor="#6366f1"
                                    ThumbColor="#ffffff"/>
                        </Grid>
                    </Frame>

                    <Frame BackgroundColor="#2a2a2a"
                           BorderColor="#333333"
                           Padding="20" CornerRadius="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Sound Effects"
                                       FontSize="17"
                                       TextColor="#ffffff"/>
                                <Label Text="Play sounds for alerts"
                                       FontSize="15"
                                       TextColor="#808080"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    x:Name="SoundSwitch"
                                    IsToggled="False"
                                    OnColor="#6366f1"
                                    ThumbColor="#ffffff"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- About Section -->
            <Frame BackgroundColor="#1a1a1a"
                   BorderColor="#404040"
                   Padding="24"
                   CornerRadius="12">
                <VerticalStackLayout Spacing="16">
                    <Label Text="About"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#ffffff"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Skanyxx MAUI"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#ffffff"/>
                        <Label Text="SRE Platform for AI-powered infrastructure management"
                               FontSize="16"
                               TextColor="#b3b3b3"/>
                        <Label Text="Version 1.0.0"
                               FontSize="15"
                               TextColor="#808080"
                               Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
