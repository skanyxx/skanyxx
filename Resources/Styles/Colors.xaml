<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Skanyxx Dark Theme - Professional SRE Design -->

    <!-- Background Colors -->
    <Color x:Key="BgPrimary">#0a0a0a</Color>
    <Color x:Key="BgSecondary">#1a1a1a</Color>
    <Color x:Key="BgTertiary">#2a2a2a</Color>
    <Color x:Key="BgElevated">#333333</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#ffffff</Color>
    <Color x:Key="TextSecondary">#b3b3b3</Color>
    <Color x:Key="TextMuted">#808080</Color>

    <!-- Accent Colors -->
    <Color x:Key="Primary">#6366f1</Color>
    <Color x:Key="Success">#00d4aa</Color>
    <Color x:Key="Warning">#ffb020</Color>
    <Color x:Key="Error">#ff4444</Color>
    <Color x:Key="Info">#3b82f6</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderPrimary">#404040</Color>
    <Color x:Key="BorderSecondary">#333333</Color>

    <!-- Status Colors -->
    <Color x:Key="StatusOnline">#00d4aa</Color>
    <Color x:Key="StatusOffline">#ff4444</Color>
    <Color x:Key="StatusWarning">#ffb020</Color>

    <!-- Required colors for default Styles.xaml -->
    <Color x:Key="PrimaryDark">#4f46e5</Color>
    <Color x:Key="PrimaryDarkText">#ffffff</Color>
    <Color x:Key="Secondary">#818cf8</Color>
    <Color x:Key="SecondaryDarkText">#e0e0e0</Color>
    <Color x:Key="MidnightBlue">#1e3a5f</Color>
    <Color x:Key="Magenta">#6366f1</Color>
    <Color x:Key="OffBlack">#0a0a0a</Color>

    <!-- Legacy mappings for MAUI defaults -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#2a2a2a</Color>
    <Color x:Key="Gray200">#333333</Color>
    <Color x:Key="Gray300">#404040</Color>
    <Color x:Key="Gray400">#666666</Color>
    <Color x:Key="Gray500">#808080</Color>
    <Color x:Key="Gray600">#999999</Color>
    <Color x:Key="Gray900">#e6e6e6</Color>
    <Color x:Key="Gray950">#f5f5f5</Color>

</ResourceDictionary>
