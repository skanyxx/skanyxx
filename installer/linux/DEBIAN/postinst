#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────
# Skanyxx .deb — postinst
# Runs after dpkg places files on disk.
# ─────────────────────────────────────────────────────────────────
set -e

INSTALL_DIR="/usr/share/skanyxx"
CONFIG="$INSTALL_DIR/appsettings.json"
TEMPLATE="$INSTALL_DIR/appsettings.template.json"

# Make the binary executable
chmod +x "$INSTALL_DIR/Skanyxx.Host" 2>/dev/null || true

# Create config from template (once — never overwrites)
# IRREVERSIBLE: once created this file holds the user's API keys
# The service runs as Production, where the owner account can only be created with Identity:BootstrapToken,
# so a fresh config gets a random 48-character one. It is shown once below and stays in the config file.
# Mode 0600 root: the only reader is the systemd service, which runs as root (skanyxx.service has no User=).
BOOTSTRAP_TOKEN=""
NEEDS_TOKEN=""
if [[ ! -f "$CONFIG" ]] && [[ -f "$TEMPLATE" ]]; then
    (umask 077 && cp "$TEMPLATE" "$CONFIG")
    BOOTSTRAP_TOKEN="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    sed -i "s/\"BootstrapToken\": \"\"/\"BootstrapToken\": \"$BOOTSTRAP_TOKEN\"/" "$CONFIG"
    if [[ ${#BOOTSTRAP_TOKEN} -ne 48 ]] || ! grep -q "\"BootstrapToken\": \"$BOOTSTRAP_TOKEN\"" "$CONFIG"; then
        rm -f "$CONFIG"  # so a retry (dpkg --configure) generates it again
        echo "Skanyxx: could not write Identity:BootstrapToken into $CONFIG; the template no longer has" >&2
        echo "  \"BootstrapToken\": \"\"." >&2
        exit 1
    fi
    # A fresh install is the desktop launcher (D200): Remote mode opens the company's Skanyxx, the server is the
    # Helm chart. Same verify-or-remove rule as the token.
    sed -i 's/"Mode": "Server"/"Mode": "Remote"/' "$CONFIG"
    if ! grep -q '"Mode": "Remote"' "$CONFIG"; then
        rm -f "$CONFIG"
        echo "Skanyxx: could not write Skanyxx:Mode into $CONFIG; the template no longer has \"Mode\": \"Server\"." >&2
        exit 1
    fi
elif [[ -f "$CONFIG" ]] && ! grep -q '"BootstrapToken": *"[^"]' "$CONFIG"; then
    # An upgrade from a config written before accounts existed: never edited, only pointed out.
    NEEDS_TOKEN=1
fi
REMOTE=""
DEV_CONSOLE=""
if grep -q '"Mode": *"Remote"' "$CONFIG" 2>/dev/null; then
    REMOTE=1
elif [[ -f "$CONFIG" ]] && ! grep -q '"Mode": *"' "$CONFIG"; then
    # An upgrade from a config written before modes existed: it stays a full Host (Server mode, D204), never edited.
    DEV_CONSOLE=1
fi
NEEDS_PUBLIC_URL=""
if [[ -z "$REMOTE" ]] && [[ -f "$CONFIG" ]] && ! grep -q '"PublicBaseUrl": *"[^"]' "$CONFIG"; then
    # An upgrade from a config written before invites existed: the app starts, invites wait for the setting.
    NEEDS_PUBLIC_URL=1
fi

# Reload systemd if available
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
fi

echo "Skanyxx installed."
if [[ -n "$REMOTE" ]]; then
    echo ""
    echo "  This is the desktop launcher: it opens your company's Skanyxx. The server is the Helm chart."
    echo "  Set Skanyxx:RemoteUrl to your company's Skanyxx address (ask its owner), e.g."
    echo "    \"RemoteUrl\": \"https://skanyxx.example.com\""
    echo "  in $CONFIG"
fi
if [[ -n "$DEV_CONSOLE" ]]; then
    echo ""
    echo "  $CONFIG has no Skanyxx:Mode, so this machine runs a full Skanyxx with its own data: a dev"
    echo "  console, not your company's workspace (D059). To open the company's Skanyxx instead, set"
    echo "  \"Mode\": \"Remote\" and \"RemoteUrl\" under \"Skanyxx\". Data kept here is not moved anywhere."
fi
echo ""
echo "  Start manually:"
echo "    skanyxx"
echo ""
echo "  Enable auto-start on boot:"
echo "    sudo systemctl enable skanyxx"
echo "    sudo systemctl start skanyxx"
echo ""
echo "  Open in browser: http://localhost:5282"
if [[ -z "$REMOTE" ]]; then
    echo "  The model and its API key are set in the app, on the owner's /Model page."
fi
if [[ -n "$BOOTSTRAP_TOKEN" ]] && [[ -z "$REMOTE" ]]; then
    echo ""
    echo "  First run: /Setup asks for this bootstrap token to create the owner account"
    echo "  (also the owner's break-glass token; kept in $CONFIG as Identity:BootstrapToken):"
    echo "    $BOOTSTRAP_TOKEN"
fi
if [[ -n "$NEEDS_TOKEN" ]]; then
    echo ""
    echo "  Set Identity:BootstrapToken in $CONFIG (a random string of at least 32 characters):"
    echo "  the first-run setup page asks for it to create the owner account."
fi
if [[ -n "$NEEDS_PUBLIC_URL" ]]; then
    echo ""
    echo "  To invite people, set Identity:PublicBaseUrl in $CONFIG to the address they use to reach"
    echo "  Skanyxx, e.g. \"PublicBaseUrl\": \"http://localhost:5282\" on this machine (https://... behind a proxy)."
fi
