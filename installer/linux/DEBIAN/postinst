#!/bin/bash
# ─────────────────────────────────────────────────────────────────
# Skanyxx .deb — postinst
# Runs after dpkg places files on disk.
# ─────────────────────────────────────────────────────────────────
set -e

INSTALL_DIR="/usr/share/skanyxx"
CONFIG="$INSTALL_DIR/appsettings.json"
TEMPLATE="$INSTALL_DIR/appsettings.template.json"

[[ "$1" == "configure" ]] || exit 0

chmod +x "$INSTALL_DIR/Skanyxx.Host"

# Create config from template (once — never overwrites).
# A fresh install is the desktop launcher (D200): Remote mode opens the company's Skanyxx, the server is the Helm
# chart. It holds no secret (no BootstrapToken: Remote mode never uses one, D231), so it is 0644: the CLI and the
# desktop entry run as the logged-in user and must be able to read it. -L too: never follow a planted symlink as root.
if [[ ! -e "$CONFIG" && ! -L "$CONFIG" ]] && [[ -f "$TEMPLATE" ]]; then
    CONFIG_TMP="$(mktemp "$INSTALL_DIR/.appsettings.XXXXXX")"
    sed 's/"Mode": "Server"/"Mode": "Remote"/' "$TEMPLATE" > "$CONFIG_TMP"
    # Verify-or-remove: the config is either right or absent, so a retry (dpkg --configure) writes it again.
    if ! grep -q '"Mode": "Remote"' "$CONFIG_TMP"; then
        rm -f "$CONFIG_TMP"
        echo "Skanyxx: could not write Skanyxx:Mode into $CONFIG; the template no longer has \"Mode\": \"Server\"." >&2
        exit 1
    fi
    chown root:root "$CONFIG_TMP"
    chmod 644 "$CONFIG_TMP"
    mv -f "$CONFIG_TMP" "$CONFIG"
fi
REMOTE=""
DEV_CONSOLE=""
if grep -q '"Mode": *"Remote"' "$CONFIG" 2>/dev/null; then
    REMOTE=1
elif [[ -f "$CONFIG" ]] && ! grep -q '"Mode": *"' "$CONFIG"; then
    # An upgrade from a config written before modes existed: it stays a full Host (Server mode, D204), never edited.
    DEV_CONSOLE=1
fi
# A Server-mode config can hold secrets (the first installers wrote it 0644): only root, which runs the service,
# reads it. The mode is tightened, the content never edited.
if [[ -z "$REMOTE" ]] && [[ -f "$CONFIG" && ! -L "$CONFIG" ]]; then
    chmod 600 "$CONFIG"
fi
NEEDS_TOKEN=""
NEEDS_PUBLIC_URL=""
if [[ -z "$REMOTE" ]] && [[ -f "$CONFIG" ]]; then
    # Server-mode upgrades only: never edited, only pointed out. The app starts; setup and invites wait.
    grep -q '"BootstrapToken": *"[^"]' "$CONFIG" || NEEDS_TOKEN=1
    grep -q '"PublicBaseUrl": *"[^"]' "$CONFIG" || NEEDS_PUBLIC_URL=1
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
    # An upgrade restarts a service the admin had running; a fresh install starts nothing.
    if [[ -n "$2" ]]; then
        systemctl try-restart skanyxx 2>/dev/null || true
    fi
fi

echo "Skanyxx installed."
if [[ -n "$REMOTE" ]] && [[ "$(stat -c '%a' "$CONFIG")" != 644 ]]; then
    # A test build before D231 wrote Remote configs 0600 root: the CLI and desktop entry cannot read them. Never edited.
    echo ""
    echo "  $CONFIG is not readable by other accounts, so 'skanyxx' and the desktop entry fail. Remote mode"
    echo "  needs no secret: remove Identity:BootstrapToken from it, then: sudo chmod 644 $CONFIG"
fi
if [[ -n "$REMOTE" ]]; then
    echo ""
    echo "  This is the desktop launcher: it opens your company's Skanyxx. The server is the Helm chart."
    echo "  Set Skanyxx:RemoteUrl to your company's Skanyxx address (ask its owner), e.g."
    echo "    \"RemoteUrl\": \"https://skanyxx.example.com\""
    echo "  in $CONFIG (sudo)"
fi
if [[ -n "$DEV_CONSOLE" ]]; then
    echo ""
    echo "  $CONFIG has no Skanyxx:Mode, so this machine runs a full Skanyxx with its own data: a dev"
    echo "  console, not your company's workspace (D059). To open the company's Skanyxx instead, set"
    echo "  \"Mode\": \"Remote\" and \"RemoteUrl\" under \"Skanyxx\". Data kept here is not moved anywhere."
fi
echo ""
if [[ -n "$REMOTE" ]]; then
    echo "  Start it: the Skanyxx desktop entry, or run: skanyxx"
    echo "  A fixed local address for bookmarks (http://127.0.0.1:5282, shared by every account on this machine):"
    echo "    sudo systemctl enable --now skanyxx"
else
    # Its config is root's only (it can hold secrets), so the root service is the way to run it.
    echo "  Start it (a full Skanyxx runs as the root service): sudo systemctl enable --now skanyxx"
    echo ""
    echo "  Open in browser: http://127.0.0.1:5282"
    echo "  The model and its API key are set in the app, on the owner's /Model page."
fi
if [[ -n "$NEEDS_TOKEN" ]]; then
    echo ""
    echo "  Set Identity:BootstrapToken in $CONFIG (a random string of at least 32 characters,"
    echo "  e.g. openssl rand -hex 24): the first-run setup page asks for it to create the owner account."
fi
if [[ -n "$NEEDS_PUBLIC_URL" ]]; then
    echo ""
    echo "  To invite people, set Identity:PublicBaseUrl in $CONFIG to the address they use to reach"
    echo "  Skanyxx, e.g. \"PublicBaseUrl\": \"http://localhost:5282\" on this machine (https://... behind a proxy)."
fi
