#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────
# Skanyxx .deb — prerm
# Runs before dpkg removes app files.
# ─────────────────────────────────────────────────────────────────
set -e

if command -v systemctl >/dev/null 2>&1; then
    systemctl stop    skanyxx 2>/dev/null || true
    systemctl disable skanyxx 2>/dev/null || true
    systemctl daemon-reload  2>/dev/null || true
fi
