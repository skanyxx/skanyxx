<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The one hardened-runtime exception .NET needs (its JIT; W^X has been the default since .NET 7). Modules are managed
     DLLs, not native code, and every bundled dylib is signed with the same identity, so library validation stays on.
     release.yml signs every Mach-O with this before notarizing. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key> <true/>
</dict>
</plist>
