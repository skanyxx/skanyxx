<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">

    <title>Skanyxx</title>
    <welcome    file="welcome.html"   mime-type="text/html"/>
    <readme     file="readme.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- Minimum macOS version: 15.0 (Sequoia), the oldest .NET 10 supports (dotnet/core release-notes/10.0/supported-os.md) -->
    <os-version min="15.0"/>

    <!-- Installs system-wide (/usr/local): needs an administrator. hostArchitectures is set per build by release.yml. -->
    <options customize="never"
             require-scripts="false"
             allow-external-scripts="false"
             hostArchitectures="arm64,x86_64"/>

    <domains enable_anywhere="false"
             enable_currentUserHome="false"
             enable_localSystem="true"/>

    <pkg-ref id="com.skanyxx.app"/>

    <choices-outline>
        <line choice="com.skanyxx.app"/>
    </choices-outline>

    <choice id="com.skanyxx.app"
            visible="false"
            title="Skanyxx"
            description="Installs the Skanyxx desktop launcher to /usr/local/share/skanyxx.">
        <pkg-ref id="com.skanyxx.app"/>
    </choice>

    <pkg-ref id="com.skanyxx.app"
             version="SKANYXX_VERSION"
             onConclusion="none">Skanyxx.pkg</pkg-ref>

</installer-gui-script>
