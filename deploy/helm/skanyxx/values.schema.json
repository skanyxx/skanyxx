{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Skanyxx umbrella values (D145). Our own sections reject unknown keys; kagent and dragonfly pass through to their charts.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "existingSecret": {"type": "string"},
        "storage": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
        "storageClassName": {"type": "string"},
        "resources": {"type": "object"},
        "adminUsername": {"type": "string", "minLength": 1},
        "adminEmail": {"type": "string", "minLength": 1},
        "rootUrl": {"type": "string"}
      }
    },
    "path": {"type": "string", "pattern": "^/"},
    "byo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string"},
        "bucket": {"type": "string"},
        "url": {"type": "string"},
        "address": {"type": "string"},
        "existingSecret": {"type": "string"}
      }
    }
  },
  "properties": {
    "global": {"type": "object"},
    "kagent-crds": {"type": "object"},
    "skanyxx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "imagePullSecrets": {"type": "array"},
        "replicas": {"type": "integer", "minimum": 0},
        "publicUrl": {"type": "string", "pattern": "^$|^https://|^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/|$)"},
        "allowedOrigins": {"type": "array", "items": {"type": "string"}},
        "extraAllowedHosts": {"type": "array", "items": {"type": "string"}},
        "bootstrapToken": {
          "type": "object", "additionalProperties": false,
          "properties": {"existingSecret": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
        },
        "database": {"type": "object", "additionalProperties": false, "properties": {"existingSecret": {"type": "string"}}},
        "dataProtection": {"type": "object", "additionalProperties": false, "properties": {"certificateSecret": {"type": "string"}}},
        "kagent": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "url": {"type": "string"},
            "tokenSecret": {"type": "string"},
            "modelConfig": {"type": "string"},
            "chatTimeoutSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "tickets": {"type": "object", "additionalProperties": false, "properties": {"source": {"enum": ["jira", "local"]}}},
        "modules": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "extraEnv": {"type": "array"},
        "extraEnvFrom": {"type": "array"},
        "service": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "mcpPort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "resources": {"type": "object"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "dataSizeLimit": {"type": "string"},
        "tmpSizeLimit": {"type": "string"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tls": {"type": "array"},
        "exactPaths": {"type": "array", "items": {"$ref": "#/definitions/path"}},
        "prefixPaths": {"type": "array", "items": {"$ref": "#/definitions/path"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaces": {"type": "array", "items": {"type": "string"}},
        "mcpFrom": {"type": "array", "items": {"type": "object"}},
        "clusterCidrs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
        "modelEgress": {
          "type": "object", "additionalProperties": false, "required": ["ports", "cidrs"],
          "properties": {
            "ports": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
            "cidrs": {"type": "array", "items": {"type": "string", "enum": ["0.0.0.0/0", "::/0"]}},
            "extra": {"type": "array"}
          }
        }
      }
    },
    "ax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "address": {"type": "string"},
        "atespace": {"type": "string"},
        "allowedImages": {"type": "array", "items": {"type": "string"}},
        "networkIsolationConfirmed": {"type": "boolean"},
        "namespace": {"type": "string"}
      }
    },
    "postgresql": {"$ref": "#/definitions/store"},
    "minio": {"$ref": "#/definitions/store"},
    "gitea": {"$ref": "#/definitions/store"},
    "external": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectStore": {"$ref": "#/definitions/byo"},
        "git": {"$ref": "#/definitions/byo"},
        "redis": {"$ref": "#/definitions/byo"}
      }
    },
    "dragonfly": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "kagent": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "confirmCrdRemoval": {"type": "boolean"},
        "providers": {"const": false},
        "rbac": {
          "type": "object",
          "properties": {"namespaces": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
        }
      }
    }
  }
}
