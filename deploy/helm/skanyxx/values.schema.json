{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Skanyxx umbrella values (D145). Our own sections reject unknown keys; kagent and dragonfly pass through to their charts.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "D072/D188/D194: the installed ax-server has no auth, and the sandbox fence (and the sandbox memory listener's fence) is a NetworkPolicy: all need networkPolicy.enabled.",
      "if": {
        "properties": {"ax": {"anyOf": [
          {"properties": {"install": {"const": true}}, "required": ["install"]},
          {"properties": {"networkIsolationConfirmed": {"const": true}}, "required": ["networkIsolationConfirmed"]},
          {"properties": {"sandboxes": {"properties": {"memory": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}}, "required": ["memory"]}}, "required": ["sandboxes"]}
        ]}},
        "required": ["ax"]
      },
      "then": {"required": ["networkPolicy"], "properties": {"networkPolicy": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}}
    }
  ],
  "definitions": {
    "axComponent": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "existingSecret": {"type": "string"},
        "storage": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
        "storageClassName": {"type": "string"},
        "resources": {"type": "object"},
        "adminUsername": {"type": "string", "minLength": 1},
        "adminEmail": {"type": "string", "minLength": 1},
        "rootUrl": {"type": "string"},
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"}
      }
    },
    "path": {"type": "string", "pattern": "^/"},
    "byo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string"},
        "bucket": {"type": "string", "pattern": "^$|^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
        "region": {"type": "string"},
        "url": {"type": "string"},
        "address": {"type": "string"},
        "existingSecret": {"type": "string"}
      }
    }
  },
  "properties": {
    "global": {"type": "object"},
    "kagent-crds": {"type": "object"},
    "skanyxx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "imagePullSecrets": {"type": "array"},
        "replicas": {"type": "integer", "minimum": 0},
        "publicUrl": {"type": "string", "pattern": "^$|^https://|^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/|$)"},
        "allowedOrigins": {"type": "array", "items": {"type": "string"}},
        "extraAllowedHosts": {"type": "array", "items": {"type": "string"}},
        "bootstrapToken": {
          "type": "object", "additionalProperties": false,
          "properties": {"existingSecret": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
        },
        "database": {"type": "object", "additionalProperties": false, "properties": {"existingSecret": {"type": "string"}}},
        "dataProtection": {"type": "object", "additionalProperties": false, "properties": {"certificateSecret": {"type": "string"}}},
        "kagent": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "url": {"type": "string"},
            "tokenSecret": {"type": "string"},
            "modelConfig": {"type": "string"},
            "chatTimeoutSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "tickets": {"type": "object", "additionalProperties": false, "properties": {"source": {"enum": ["jira", "local"]}}},
        "modules": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "extraEnv": {"type": "array"},
        "extraEnvFrom": {"type": "array"},
        "service": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "mcpPort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "resources": {"type": "object"},
        "podSecurityContext": {"type": "object"},
        "securityContext": {"type": "object"},
        "memoryBodies": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "thresholdBytes": {"type": "integer", "minimum": 1, "maximum": 20000},
            "maxBodyBytes": {"type": "integer", "minimum": 2, "maximum": 8388608}
          }
        },
        "dataSizeLimit": {"type": "string"},
        "tmpSizeLimit": {"type": "string"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tls": {"type": "array"},
        "exactPaths": {"type": "array", "items": {"$ref": "#/definitions/path"}},
        "prefixPaths": {"type": "array", "items": {"$ref": "#/definitions/path"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaces": {"type": "array", "items": {"type": "string"}},
        "mcpFrom": {"type": "array", "items": {"type": "object"}},
        "clusterCidrs": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
        "modelEgress": {
          "type": "object", "additionalProperties": false, "required": ["ports", "cidrs"],
          "properties": {
            "ports": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
            "cidrs": {"type": "array", "items": {"type": "string", "enum": ["0.0.0.0/0", "::/0"]}},
            "extra": {"type": "array"}
          }
        }
      }
    },
    "ax": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "address": {"type": "string"},
        "atespace": {"type": "string"},
        "allowedImages": {"type": "array", "items": {"type": "string"}},
        "networkIsolationConfirmed": {"type": "boolean"},
        "namespace": {"type": "string"},
        "install": {"type": "boolean"},
        "imagePullSecrets": {"type": "array"},
        "server": {"$ref": "#/definitions/axComponent"},
        "controller": {"$ref": "#/definitions/axComponent"},
        "redis": {"$ref": "#/definitions/axComponent"},
        "substrate": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "endpoint": {"type": "string", "pattern": "^([a-z0-9.-]+:[0-9]+)?$"},
            "authority": {"type": "string", "minLength": 1},
            "namespace": {"type": "string", "minLength": 1},
            "routerAddress": {"type": "string"},
            "trustBundle": {
              "type": "object", "additionalProperties": false, "required": ["signerName"],
              "properties": {"signerName": {"type": "string", "minLength": 1}, "labelSelector": {"type": "object"}}
            }
          }
        },
        "template": {"type": "string", "minLength": 1},
        "templateAtespace": {"type": "string", "minLength": 1},
        "snapshotsBucket": {"type": "string", "not": {"pattern": "^gs://dberkov-gke-dev3(/|$)"}},
        "sandboxes": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "namespace": {"type": "string"},
            "internet": {"type": "boolean"},
            "dnsPeer": {
              "type": "object", "additionalProperties": false, "required": ["namespace", "podLabels"],
              "properties": {
                "namespace": {"type": "string", "minLength": 1},
                "podLabels": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9./_-]+=[A-Za-z0-9._-]*$"}}
              }
            },
            "memory": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "tokenHours": {"type": "integer", "minimum": 1, "maximum": 720},
                "existingSecret": {"type": "string"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "D186: installing AX needs the module on, Substrate, both images pinned by digest (D075) and a snapshot bucket; an address would point the module elsewhere.",
          "if": {"properties": {"install": {"const": true}}, "required": ["install"]},
          "then": {
            "properties": {
              "enabled": {"const": true},
              "address": {"maxLength": 0},
              "snapshotsBucket": {"minLength": 1},
              "substrate": {"required": ["endpoint"], "properties": {"endpoint": {"minLength": 1}}},
              "server": {"properties": {"image": {"required": ["digest"], "properties": {"repository": {"minLength": 1}, "digest": {"minLength": 1}}}}},
              "controller": {"properties": {"image": {"required": ["digest"], "properties": {"repository": {"minLength": 1}, "digest": {"minLength": 1}}}}}
            }
          }
        },
        {
          "$comment": "D188: NetworkIsolationConfirmed only where the chart renders the sandbox egress policies.",
          "if": {"properties": {"networkIsolationConfirmed": {"const": true}}, "required": ["networkIsolationConfirmed"]},
          "then": {"properties": {"sandboxes": {"required": ["namespace"], "properties": {"namespace": {"minLength": 1}}}}}
        },
        {
          "$comment": "D190-D194: sandbox memory needs the module on and the fence's namespace (the listener is admitted from there only).",
          "if": {"properties": {"sandboxes": {"properties": {"memory": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}}, "required": ["memory"]}}, "required": ["sandboxes"]},
          "then": {"properties": {"enabled": {"const": true}, "sandboxes": {"required": ["namespace"], "properties": {"namespace": {"minLength": 1}}}}}
        }
      ]
    },
    "postgresql": {"$ref": "#/definitions/store"},
    "minio": {"$ref": "#/definitions/store"},
    "gitea": {"$ref": "#/definitions/store"},
    "external": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objectStore": {"allOf": [
          {"$ref": "#/definitions/byo"},
          {"properties": {"endpoint": {"pattern": "^$|^https?://"}}}
        ]},
        "git": {"$ref": "#/definitions/byo"},
        "redis": {"allOf": [
          {"$ref": "#/definitions/byo"},
          {"properties": {"address": {"pattern": "^$|^[^:\\s\\[\\]]+:[0-9]{1,5}$|^\\[[0-9a-fA-F:]+\\]:[0-9]{1,5}$"}}}
        ]}
      }
    },
    "dragonfly": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "kagent": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "confirmCrdRemoval": {"type": "boolean"},
        "providers": {"const": false},
        "rbac": {
          "type": "object",
          "properties": {"namespaces": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
        }
      }
    }
  }
}
