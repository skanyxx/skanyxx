// ── Folder selector ───────────────────────────────────────────────────────────

async function toggleFolderEdit() {
    const ws = activeWorkspace();
    if (!ws) return;

    // Try native OS folder picker first
    const btn = document.getElementById('dtFolderBtn');
    const origLabel = btn.innerHTML;
    btn.innerHTML = '<span class="dt-spin" style="display:inline-block;vertical-align:middle"></span>';
    btn.disabled = true;

    try {
        const initial = ws.gitRepoPath || '';
        const r = await fetch(`/api/devtools/browse-folder?initial=${encodeURIComponent(initial)}`);
        const { path, cancelled } = await r.json();

        btn.innerHTML = origLabel;
        btn.disabled = false;

        if (!cancelled && path) {
            await applyFolderPath(ws, path);
            return;
        }
        // User cancelled picker → do nothing (don't fall through to text input)
        if (cancelled) return;
    } catch {
        // Native picker unavailable — fall back to inline text input
        btn.innerHTML = origLabel;
        btn.disabled = false;
    }

    // Fallback: editable text input
    const input = document.getElementById('dtFolderInput');
    btn.style.display   = 'none';
    input.style.display = '';
    input.value = ws.gitRepoPath || '';
    input.focus();
    input.select();
}

function cancelFolderEdit() {
    document.getElementById('dtFolderBtn').style.display   = '';
    document.getElementById('dtFolderInput').style.display = 'none';
}

async function saveFolderPath() {
    const ws  = activeWorkspace();
    const val = document.getElementById('dtFolderInput').value.trim();
    cancelFolderEdit();
    if (!ws || !val) return;
    await applyFolderPath(ws, val);
}

async function applyFolderPath(ws, path) {
    ws.gitRepoPath = path;
    updateFolderLabel(ws);
    try {
        await fetch(`/api/devtools/workspaces/${ws.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(ws)
        });
        showToast(`Folder set: ${path.split('/').pop() || path}`, 'success');
    } catch { /* non-critical */ }
}

function updateFolderLabel(ws) {
    const label = document.getElementById('dtFolderLabel');
    if (!label) return;
    const path = ws?.gitRepoPath;
    label.textContent = path ? path.split('/').pop() || path : 'Select folder';
}

function updateInputBar(ws) {
    // Model pill
    document.getElementById('dtModelPillLabel').textContent = ws.llmModel || '(default)';
    // Provider label
    const provLabel = { claude:'Claude API', claudecli:'Claude CLI', ollama:'Ollama', openai:'OpenAI', groq:'Groq', together:'Together AI', mistral:'Mistral', perplexity:'Perplexity', deepseek:'DeepSeek', gemini:'Gemini', cohere:'Cohere', azure:'Azure OpenAI', xai:'xAI', lmstudio:'LM Studio', custom:'Custom' };
    document.getElementById('dtProviderLabel').textContent = provLabel[ws.llmProvider] || ws.llmProvider || '';
    // Folder
    updateFolderLabel(ws);
}

async function completeTask() {
    const ws = activeWorkspace();
    if (!ws) return;
    const task = state.activeTask;
    const taskId = task?.id || '';
    const label = task ? `[${task.id}] ${task.title}` : 'this session';

    if (!confirm(`Mark "${label}" as done and permanently delete all chat history and context for it?\n\nThis frees space and cannot be undone.`)) return;

    try {
        const url = taskId
            ? `/api/devtools/sessions/${ws.id}?taskId=${encodeURIComponent(taskId)}`
            : `/api/devtools/sessions/${ws.id}`;
        const r = await fetch(url, { method: 'DELETE' });
        const data = await r.json();

        // Clear local state
        const key = `${ws.id}:${taskId}`;
        delete state.sessions[key];

        // Reset UI
        document.getElementById('dtMessages').innerHTML = '';
        document.getElementById('dtTaskContext').classList.remove('visible');
        document.getElementById('taskSelect').value = '';
        clearTaskBadges();
        state.activeTask = null;
        updateTokenBar(0);

        showToast(`Cleared ${data.deleted} session(s) — space freed`, 'success');
    } catch (e) { showToast('Clear failed: ' + e.message, 'error'); }
}

async function compressHistory() {
    const ws = activeWorkspace();
    if (!ws) return;
    const taskId = state.activeTask?.id || '';

    try {
        const r = await fetch(`/api/devtools/sessions/${ws.id}/summarize?taskId=${encodeURIComponent(taskId)}`, { method: 'POST' });
        const session = await r.json();
        const key = `${ws.id}:${taskId}`;
        state.sessions[key] = session;
        renderMessages(session);
        updateTokenBar(session.totalTokensUsed);
        showToast('History compressed successfully', 'success');
    } catch (e) { showToast('Compress failed: ' + e.message, 'error'); }
}

function updateTokenBar(total) {
    const pct = Math.min(100, Math.round((total / MAX_TOKENS) * 100));
    document.getElementById('tokenCountLabel').textContent = `${total.toLocaleString()} tokens used`;
    document.getElementById('tokenPctLabel').textContent = `${pct}%`;
    const bar = document.getElementById('tokenProgressBar');
    bar.style.width = pct + '%';
    bar.className = 'token-progress-bar' + (pct > 80 ? ' danger' : pct > 50 ? ' warn' : '');
}

// ── Agent Actions ────────────────────────────────────────────────────────────
async function runAction(type) {
    const ws = activeWorkspace();
    if (!ws) return;

    const btns = document.querySelectorAll('.dt-action-btn');
    btns.forEach(b => b.classList.add('running'));

    const payload = {
        workspaceId: ws.id,
        taskId: state.activeTask?.id || '',
        taskTitle: state.activeTask?.title || '',
        taskDescription: state.activeTask?.description || '',
        actionType: type,
        additionalContext: getSelectedText()
    };

    if (type === 'branch') {
        const name = prompt('Branch name (leave blank to auto-generate from task):');
        if (name !== null) payload.branchName = name;
        else { btns.forEach(b => b.classList.remove('running')); return; }
    }

    if (type === 'git-comment') {
        const prNum = prompt('PR number or description context (optional):');
        if (prNum !== null) payload.prNumber = prNum;
    }

    try {
        const r = await fetch('/api/devtools/actions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const result = await r.json();

        const titleMap = {
            'branch': 'Branch Created',
            'unit-tests': 'Unit Tests Generated',
            'integration-tests': 'Integration Tests Generated',
            'system-tests': 'System Tests Generated',
            'qa': 'QA Review',
            'git-comment': 'Git Discussion Comment',
            'jira-comment': 'Jira Comment'
        };

        state.lastResult = result.output || result.error || '';
        showResult(titleMap[type] || 'Agent Result', state.lastResult, !result.success);
    } catch (e) {
        showResult('Error', e.message, true);
    } finally {
        btns.forEach(b => b.classList.remove('running'));
    }
}

function getSelectedText() {
    return window.getSelection()?.toString() || '';
}

// ── Result modal ─────────────────────────────────────────────────────────────
function showResult(title, content, isError) {
    document.getElementById('resultTitle').textContent = title;
    document.getElementById('resultBody').textContent = content;
