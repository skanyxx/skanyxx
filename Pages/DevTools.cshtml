let hybridLaneState = {}; // { connId: { lastReply, lastPrompt } }

function toggleHybrid() {
    hybridActive = !hybridActive;
    const panel    = document.getElementById('dtHybridPanel');
    const messages = document.getElementById('dtMessages');
    const tokenBar = document.querySelector('.dt-token-bar');
    const inputArea= document.querySelector('.dt-input-area');
