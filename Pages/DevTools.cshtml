                <span style="font-size:13px;font-weight:600">${escHtml(skill.name)}</span>
                ${skill.isBuiltIn ? '<span style="font-size:10px;padding:1px 6px;border-radius:8px;background:rgba(100,108,255,.12);color:var(--accent-color)">built-in</span>' : '<span style="font-size:10px;padding:1px 6px;border-radius:8px;background:rgba(74,222,128,.1);color:var(--success-color)">custom</span>'}
                ${!skill.isBuiltIn ? `<button class="btn btn-ghost" style="margin-left:auto;padding:2px 8px;color:var(--error-color);font-size:11px" onclick="adminDeleteSkill(${skill.id})">Delete</button>` : ''}
            </div>
            <textarea data-skill-id="${skill.id}"
                style="width:100%;min-height:80px;resize:vertical;padding:7px 10px;background:var(--bg-tertiary);border:1px solid var(--border-color);border-radius:5px;color:var(--text-secondary);font-size:12px;font-family:inherit;line-height:1.5;box-sizing:border-box"
                onchange="updateSkillPrompt(${skill.id}, this.value)">${escHtml(skill.systemPromptAddition)}</textarea>
        `;
        list.appendChild(row);
    });
}

async function adminAddSkill() {
    const name = document.getElementById('adminNewSkillName').value.trim();
    const prompt = document.getElementById('adminNewSkillPrompt').value.trim();
    if (!name || !prompt) { showToast('Name and prompt are required', 'error'); return; }
    const r = await fetch('/api/devtools/skills', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, systemPromptAddition: prompt }) });
    if (!r.ok) { showToast('Failed to add skill', 'error'); return; }
    const created = await r.json();
    state.allSkills.push(created);
    document.getElementById('adminNewSkillName').value = '';
    document.getElementById('adminNewSkillPrompt').value = '';
    renderAdminSkillsList();
    showToast(`Skill "${name}" added`, 'success');
}

async function adminDeleteSkill(id) {
    const skill = state.allSkills.find(s => s.id === id);
    if (!confirm(`Delete custom skill "${skill?.name}"?`)) return;
    const r = await fetch(`/api/devtools/skills/${id}`, { method: 'DELETE' });
    if (!r.ok) { const e = await r.json(); showToast(e.error, 'error'); return; }
    state.allSkills = state.allSkills.filter(s => s.id !== id);
    renderAdminSkillsList();
    showToast('Skill deleted', 'success');
}
</script>
}
