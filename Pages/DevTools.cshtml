@page
@model SkanyxxWeb.Pages.DevToolsModel
@{
    ViewData["Title"] = "Dev Tools";
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha512-7SRCYIJtR6F8ocwW7UxW6wGKqbSyqREDbfCORCO1hzb8NDQfBhIAx72lBFLCkQFMJEBOLvRkKrzdSduPGB9Zg=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}

<style>
/* ── Layout ───────────────────────────────────────────────────────────────── */
.dt-root {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 110px);
    gap: 0;
    overflow: hidden;
}

/* ── Workspace Tab Bar ────────────────────────────────────────────────────── */
.dt-tabbar {
    display: flex;
    align-items: center;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 0 8px;
    gap: 2px;
    min-height: 42px;
    flex-shrink: 0;
}
.dt-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px 7px 12px;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 13px;
    white-space: nowrap;
    max-width: 180px;
    transition: all 0.15s;
    user-select: none;
    margin-bottom: -1px;
}
.dt-tab:hover { background: var(--bg-tertiary); color: var(--text-primary); }
.dt-tab.active {
    background: var(--bg-primary);
    border-color: var(--border-color);
    color: var(--text-primary);
    font-weight: 500;
}
.dt-tab .tab-name {
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
}
.dt-tab .tab-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 3px;
    color: var(--text-muted);
    flex-shrink: 0;
}
.dt-tab .tab-close:hover { background: var(--error-color); color: white; }
.dt-tab-add {
    padding: 4px 10px;
    background: transparent;
    border: 1px dashed var(--border-color);
    border-radius: 5px;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    transition: all 0.15s;
    margin-left: 4px;
}
.dt-tab-add:hover { border-color: var(--accent-color); color: var(--accent-color); }

/* ── Workspace Header ─────────────────────────────────────────────────────── */
.dt-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
    flex-wrap: wrap;
}
.dt-task-picker { display: flex; align-items: center; gap: 6px; flex: 1; min-width: 300px; }
.dt-task-picker select { padding: 5px 8px; font-size: 13px; max-width: 120px; }
.dt-task-picker #taskSelect { flex: 1; max-width: 340px; }
.dt-task-badge {
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .5px;
}
.badge-bug { background: rgba(248,113,113,.15); color: var(--error-color); }
.badge-task { background: rgba(100,108,255,.15); color: var(--accent-color); }
.badge-story { background: rgba(74,222,128,.15); color: var(--success-color); }
.badge-critical { background: rgba(248,113,113,.2); color: var(--error-color); }
.badge-high { background: rgba(251,191,36,.15); color: var(--warning-color); }

.dt-llm-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    background: rgba(100,108,255,.12);
    color: var(--accent-color);
    border: 1px solid rgba(100,108,255,.25);
    white-space: nowrap;
}
.dt-skills-area { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; max-width: 320px; }
.skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px 3px 6px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 500;
    background: rgba(100,108,255,.1);
    border: 1px solid rgba(100,108,255,.25);
    color: var(--accent-color);
    cursor: pointer;
    transition: all .15s;
    white-space: nowrap;
}
.skill-chip::before { content: '✓'; font-size: 9px; opacity: .8; }
.skill-chip:hover { background: rgba(239,68,68,.1); border-color: rgba(239,68,68,.3); color: var(--error-color); }
.skill-chip:hover::before { content: '✕'; }

/* ── Config Panel ─────────────────────────────────────────────────────────── */
.dt-config-panel {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 14px 18px;
    display: none;
    flex-shrink: 0;
}
.dt-config-panel.open { display: block; }
.dt-config-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
.dt-config-group { display: flex; flex-direction: column; gap: 4px; }
.dt-config-group label { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); }
.dt-config-group input, .dt-config-group select {
    padding: 6px 10px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    color: var(--text-primary);
    font-size: 13px;
}
.dt-config-group input:focus, .dt-config-group select:focus {
    outline: none;
    border-color: var(--accent-color);
}
.dt-config-actions { display: flex; gap: 8px; margin-top: 12px; }

/* ── Main content area ────────────────────────────────────────────────────── */
.dt-main { display: flex; flex-direction: column; flex: 1; overflow: hidden; }
#dtWorkspace { display: none; flex: 1; flex-direction: column; overflow: hidden; }
#dtWorkspace.active { display: flex; }

/* Task context banner */
.dt-task-context {
    padding: 10px 16px;
    background: rgba(100,108,255,.06);
    border-bottom: 1px solid var(--border-color);
    display: none;
    flex-shrink: 0;
}
.dt-task-context.visible { display: block; }
.dt-task-context-title { font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 2px; }
.dt-task-context-desc { font-size: 12px; color: var(--text-secondary); white-space: pre-wrap; max-height: 60px; overflow-y: auto; }

/* Chat messages */
.dt-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.dt-msg { display: flex; gap: 10px; }
.dt-msg.user { flex-direction: row-reverse; }
.dt-msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    flex-shrink: 0;
}
.dt-msg.user .dt-msg-avatar { background: var(--accent-color); color: white; }
.dt-msg.assistant .dt-msg-avatar { background: var(--bg-tertiary); color: var(--text-secondary); border: 1px solid var(--border-color); }
.dt-msg-bubble {
    max-width: 78%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.6;
    white-space: pre-wrap;
}
.dt-msg.user .dt-msg-bubble {
    background: var(--accent-color);
    color: white;
    border-radius: 12px 2px 12px 12px;
}
.dt-msg.assistant .dt-msg-bubble {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 2px 12px 12px 12px;
}
.dt-msg-bubble pre { margin: 8px 0 0; border-radius: 6px; overflow-x: auto; }
.dt-msg-bubble code { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; }
/* Tool-call chips shown during agentic streaming */
.dt-tool-calls { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 6px; }
.dt-tool-chip {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 3px 8px; border-radius: 20px; font-size: 11px;
    background: rgba(100,108,255,.10); color: var(--accent-color);
    border: 1px solid rgba(100,108,255,.25); font-family: 'SF Mono','Fira Code',monospace;
    white-space: nowrap;
}
.dt-tool-chip.running { opacity: .7; }
.dt-tool-chip.running::before { content: ''; display: inline-block; width: 8px; height: 8px; border: 1.5px solid rgba(100,108,255,.3); border-top-color: var(--accent-color); border-radius: 50%; animation: spin .6s linear infinite; }
.dt-tool-chip.done::before { content: '✓'; font-style: normal; color: #4caf50; font-size: 10px; }
.dt-stream-text { white-space: pre-wrap; word-break: break-word; }
/* Blinking cursor while streaming text */
.dt-stream-cursor::after { content: '▋'; animation: blink 1s step-end infinite; }
@@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
.dt-msg-meta { font-size: 10px; color: var(--text-muted); margin-top: 3px; text-align: right; }
.dt-msg.assistant .dt-msg-meta { text-align: left; }

/* Summary banner */
.dt-summary-banner {
    padding: 8px 16px;
    background: rgba(251,191,36,.07);
    border: 1px solid rgba(251,191,36,.2);
    border-radius: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    margin: 4px 16px;
    font-style: italic;
}

/* Token bar */
.dt-token-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    flex-shrink: 0;
    font-size: 12px;
}
.dt-token-bar .token-label { color: var(--text-muted); white-space: nowrap; }
.token-progress-wrap { flex: 1; height: 4px; background: var(--bg-tertiary); border-radius: 2px; overflow: hidden; }
.token-progress-bar { height: 100%; background: var(--accent-color); border-radius: 2px; transition: width .3s; }
.token-progress-bar.warn { background: var(--warning-color); }
.token-progress-bar.danger { background: var(--error-color); }

/* Input area */
.dt-input-area {
    display: flex;
    flex-direction: column;
    padding: 10px 14px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    flex-shrink: 0;
    gap: 6px;
}
.dt-input-box {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--bg-tertiary);
    overflow: hidden;
    transition: border-color .15s;
}
.dt-input-box:focus-within { border-color: var(--accent-color); }
.dt-input-box textarea {
    width: 100%;
    resize: none;
    min-height: 56px;
    max-height: 160px;
    padding: 10px 12px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 13px;
    line-height: 1.5;
    font-family: inherit;
    box-sizing: border-box;
}
.dt-input-box textarea:focus { outline: none; }
.dt-input-toolbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-top: 1px solid var(--border-color);
}
.dt-toolbar-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 11px;
    cursor: pointer;
    white-space: nowrap;
    transition: all .15s;
}
.dt-toolbar-btn:hover { background: var(--bg-secondary); color: var(--text-primary); border-color: var(--accent-color); }
.dt-model-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    background: rgba(100,108,255,.1);
    border: 1px solid rgba(100,108,255,.25);
    border-radius: 12px;
    color: var(--accent-color);
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all .15s;
    position: relative;
}
.dt-model-pill:hover { background: rgba(100,108,255,.18); }
.dt-model-dropdown {
    position: absolute;
    bottom: calc(100% + 4px);
    right: 0;
    min-width: 220px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,.35);
    z-index: 100;
    overflow: hidden;
    display: none;
}
.dt-model-dropdown.open { display: block; }
.dt-model-opt { padding: 8px 12px; font-size: 12px; cursor: pointer; color: var(--text-primary); }
.dt-model-opt:hover { background: var(--bg-tertiary); }
.dt-model-opt.active { color: var(--accent-color); font-weight: 500; }
.dt-model-input { width: 100%; padding: 6px 10px; background: var(--bg-tertiary); border: none; border-top: 1px solid var(--border-color); color: var(--text-primary); font-size: 12px; box-sizing: border-box; }
.dt-model-input:focus { outline: none; }
.dt-footer-bar {
    display: flex;
    align-items: center;
    gap: 8px;
}
.dt-folder-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 11px;
    cursor: pointer;
    transition: all .15s;
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.dt-folder-btn:hover { background: var(--bg-tertiary); color: var(--text-primary); }
.dt-folder-input {
    font-size: 11px;
    padding: 3px 8px;
    background: var(--bg-tertiary);
    border: 1px solid var(--accent-color);
    border-radius: 6px;
    color: var(--text-primary);
    flex: 1;
    min-width: 0;
}
.dt-folder-input:focus { outline: none; }
.dt-attached-images {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    padding: 6px 8px 0;
}
.dt-img-thumb {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    flex-shrink: 0;
}
.dt-img-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.dt-img-thumb button {
    position: absolute;
    top: 1px;
    right: 1px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: none;
    background: rgba(0,0,0,.65);
    color: white;
    font-size: 9px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}
.dt-send-btn {
    padding: 5px 14px;
    background: var(--accent-color);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    transition: opacity .15s;
    white-space: nowrap;
    height: 28px;
}
.dt-send-btn:hover { opacity: .85; }
.dt-send-btn:disabled { opacity: .45; cursor: not-allowed; }

/* ── Hybrid Mode ─────────────────────────────────────────────────────────── */
.hybrid-lane {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border-color);
    overflow: hidden;
}
.hybrid-lane:last-child { border-right: none; }
.hybrid-lane-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    font-size: 12px;
    font-weight: 600;
    flex-shrink: 0;
}
.hybrid-lane-body {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.hybrid-msg {
    padding: 10px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
}
.hybrid-msg.user { background: rgba(100,108,255,.08); border-color: rgba(100,108,255,.2); }
.hybrid-msg.error { background: rgba(239,68,68,.08); border-color: rgba(239,68,68,.25); color: var(--error-color); }
.hybrid-msg.review { background: rgba(251,191,36,.07); border-color: rgba(251,191,36,.25); }
.hybrid-msg.fix { background: rgba(74,222,128,.07); border-color: rgba(74,222,128,.2); }
.hybrid-lane-actions {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    padding: 6px 12px;
    border-top: 1px solid var(--border-color);
    flex-shrink: 0;
}
.hybrid-action-btn {
    font-size: 10px;
    padding: 2px 8px;
    border: 1px solid var(--border-color);
    border-radius: 5px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all .15s;
}
.hybrid-action-btn:hover { background: var(--bg-tertiary); color: var(--text-primary); }
.hybrid-action-btn.review { border-color: rgba(251,191,36,.4); color: #fbbf24; }
.hybrid-action-btn.fix   { border-color: rgba(74,222,128,.4); color: var(--success-color); }
.hybrid-conn-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    font-size: 11px;
    cursor: pointer;
    user-select: none;
    transition: all .15s;
    color: var(--text-secondary);
}
.hybrid-conn-chip.selected { border-color: var(--accent-color); color: var(--accent-color); background: rgba(100,108,255,.1); }
.hybrid-conn-chip input { display: none; }
/* Agent action bar */
.dt-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    flex-wrap: wrap;
    flex-shrink: 0;
}
.dt-actions-label { font-size: 11px; text-transform: uppercase; color: var(--text-muted); letter-spacing: .5px; margin-right: 2px; }
.dt-action-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    font-size: 12px;
    cursor: pointer;
    transition: all .15s;
    white-space: nowrap;
}
.dt-action-btn:hover { border-color: var(--accent-color); color: var(--accent-color); background: rgba(100,108,255,.06); }
.dt-action-btn.running { opacity: .6; cursor: not-allowed; }
.dt-action-btn svg { width: 13px; height: 13px; }

/* Result modal */
.dt-result-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.6);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    display: none;
}
.dt-result-overlay.open { display: flex; }
.dt-result-modal {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 100%;
    max-width: 760px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.dt-result-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-color);
    font-weight: 600;
}
.dt-result-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px;
    font-size: 13px;
    line-height: 1.6;
    white-space: pre-wrap;
    font-family: 'SF Mono', 'Fira Code', monospace;
}
.dt-result-modal-footer {
    padding: 10px 18px;
    border-top: 1px solid var(--border-color);
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

/* Empty state */
.dt-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    gap: 10px;
    font-size: 14px;
}
.dt-empty svg { width: 48px; height: 48px; opacity: .3; }

/* Spinner */
.dt-spin {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin .6s linear infinite;
}
@@keyframes spin { to { transform: rotate(360deg); } }

/* Skills modal */
.dt-skills-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.65);
    z-index: 1001;
    display: none;
    align-items: center;
    justify-content: center;
}
.dt-skills-modal-overlay.open { display: flex; }
.dt-skills-modal {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 560px;
    max-width: 96vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,.4);
}
.dt-skills-modal-head {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
}
.dt-skills-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.dt-skills-modal-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-top: 1px solid var(--border-color);
    background: var(--bg-secondary);
    flex-shrink: 0;
}
/* Skill card row */
.skill-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 11px 13px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-secondary);
    transition: border-color .15s;
    cursor: pointer;
}
.skill-row:hover { border-color: rgba(100,108,255,.35); }
.skill-row.active { border-color: rgba(100,108,255,.4); background: rgba(100,108,255,.06); }
/* Toggle switch */
.skill-toggle {
    position: relative;
    width: 34px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 2px;
}
.skill-toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
.skill-toggle-track {
    position: absolute;
    inset: 0;
    border-radius: 9px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    transition: all .2s;
}
.skill-toggle input:checked + .skill-toggle-track { background: var(--accent-color); border-color: var(--accent-color); }
.skill-toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text-muted);
    transition: all .2s;
}
.skill-toggle input:checked ~ .skill-toggle-thumb { left: 18px; background: white; }
.skill-info { flex: 1; min-width: 0; }
.skill-info-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 4px;
}
.skill-badge {
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 8px;
}
.skill-badge.builtin { background: rgba(100,108,255,.12); color: var(--accent-color); }
.skill-badge.custom  { background: rgba(74,222,128,.1); color: var(--success-color); }
.skill-prompt-edit {
    width: 100%;
    min-height: 48px;
    max-height: 100px;
    resize: vertical;
    padding: 5px 8px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    color: var(--text-secondary);
    font-size: 11px;
    font-family: inherit;
    line-height: 1.5;
    box-sizing: border-box;
}
.skill-prompt-edit:focus { outline: none; border-color: var(--accent-color); }
/* Add skill inline form */
.skill-add-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    margin-top: 4px;
}
.skill-add-form input, .skill-add-form textarea {
    padding: 7px 10px;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 5px;
    color: var(--text-primary);
    font-size: 13px;
    font-family: inherit;
}
.skill-add-form input:focus, .skill-add-form textarea:focus { outline: none; border-color: var(--accent-color); }
.dt-skills-grid { display: none; } /* old — replaced */
</style>

