// ── Utils ────────────────────────────────────────────────────────────────────
function activeWorkspace() {
    return state.workspaces.find(w => w.id === state.activeId) || null;
}

function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function formatMarkdown(text) {
    // Minimal markdown: code blocks, inline code, bold, line breaks
    let s = escHtml(text);
    s = s.replace(/```(\w*)\n?([\s\S]*?)```/g, (_,lang,code) => `<pre style="background:var(--bg-tertiary);padding:10px 12px;border-radius:6px;overflow-x:auto"><code class="language-${lang}">${code}</code></pre>`);
    s = s.replace(/`([^`]+)`/g, '<code style="background:var(--bg-tertiary);padding:1px 5px;border-radius:3px">$1</code>');
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/\n/g, '<br>');
    return s;
}

// ── File Browser ─────────────────────────────────────────────────────────────

let fbAllItems    = [];   // [{name, path, isDir, ext}]
let fbSelectedPath = null;

async function openFileBrowser() {
    const ws = activeWorkspace();
    const root = ws?.gitRepoPath;
    if (!root) {
        showToast('Set a project folder first (click "Select folder" below the input)', 'error');
        return;
    }
    fbSelectedPath = null;
    document.getElementById('fbTitle').textContent = root.split('/').pop() || root;
    document.getElementById('fbSearch').value = '';
    document.getElementById('fbSelected').textContent = 'No file selected';
    document.getElementById('fbAttachBtn').disabled = true;
    document.getElementById('fileBrowserOverlay').style.display = 'flex';
    await fbLoad();
}

async function fbLoad() {
    const ws        = activeWorkspace();
    const root      = ws?.gitRepoPath;
    const recursive = document.getElementById('fbRecursive').checked;
    const list      = document.getElementById('fbList');
    list.innerHTML  = '<div style="padding:16px;text-align:center;font-size:12px;color:var(--text-muted)">Loading…</div>';
    try {
        const r    = await fetch(`/api/devtools/fs/ls?path=${encodeURIComponent(root)}&recursive=${recursive}`);
        if (!r.ok) { const e = await r.json(); list.innerHTML = `<div style="padding:16px;color:var(--error-color);font-size:12px">${escHtml(e.error)}</div>`; return; }
        fbAllItems = await r.json();
        fbFilterRender();
    } catch (e) {
        list.innerHTML = `<div style="padding:16px;color:var(--error-color);font-size:12px">Error: ${escHtml(e.message)}</div>`;
    }
}

function fbFilterRender() {
    const q    = document.getElementById('fbSearch').value.toLowerCase();
    const list = document.getElementById('fbList');
    list.innerHTML = '';
    const filtered = fbAllItems.filter(i => !q || i.name.toLowerCase().includes(q) || i.path.toLowerCase().includes(q));
    if (!filtered.length) { list.innerHTML = '<div style="padding:16px;text-align:center;font-size:12px;color:var(--text-muted)">No files match</div>'; return; }

    const extIcon = ext => {
        if (!ext) return '📁';
        const m = { '.cs':'🔷', '.ts':'🔷', '.js':'📜', '.py':'🐍', '.json':'📋', '.md':'📝', '.html':'🌐', '.css':'🎨', '.sql':'🗄️', '.sh':'⚙️', '.yml':'⚙️', '.yaml':'⚙️', '.xml':'📄', '.txt':'📄', '.go':'🔵', '.rs':'🦀', '.java':'☕' };
        return m[ext] || '📄';
    };

    filtered.slice(0, 300).forEach(item => {
        const ws   = activeWorkspace();
        const rel  = item.path.replace(ws?.gitRepoPath || '', '').replace(/^\//, '');
        const row  = document.createElement('div');
        row.style.cssText = `display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:5px;cursor:${item.isDir?'default':'pointer'};font-size:12px;${fbSelectedPath===item.path&&!item.isDir?'background:rgba(100,108,255,.12);color:var(--accent-color)':''}`;
        row.innerHTML = `<span style="font-size:13px;width:18px;text-align:center;flex-shrink:0">${extIcon(item.ext)}</span><span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${escHtml(item.path)}">${escHtml(rel)}</span>`;
        if (!item.isDir) {
            row.onclick = () => fbSelect(item, row);
            row.ondblclick = () => { fbSelect(item, row); fbAttachSelected(); };
        } else {
            row.style.color = 'var(--text-muted)';
        }
        list.appendChild(row);
    });
}

function fbSelect(item, row) {
    fbSelectedPath = item.path;
    document.querySelectorAll('#fbList > div').forEach(r => { r.style.background=''; r.style.color=''; });
    row.style.background = 'rgba(100,108,255,.12)';
    row.style.color      = 'var(--accent-color)';
    document.getElementById('fbSelected').textContent = item.name;
    document.getElementById('fbAttachBtn').disabled = false;
}

async function fbAttachSelected() {
    if (!fbSelectedPath) return;
    closeFileBrowser();
    try {
        const r = await fetch(`/api/devtools/fs/read?path=${encodeURIComponent(fbSelectedPath)}`);
        if (!r.ok) { const e = await r.json(); showToast(e.error, 'error'); return; }
        const { name, content } = await r.json();
        const ext  = name.split('.').pop() || '';
        const lang = { cs:'csharp', ts:'typescript', js:'javascript', py:'python', go:'go', rs:'rust', java:'java', json:'json', html:'html', css:'css', sh:'bash', yml:'yaml', yaml:'yaml', xml:'xml', sql:'sql', md:'markdown' }[ext] || ext;
        const snippet = `\`\`\`${lang}\n// File: ${name}\n${content}\n\`\`\``;
        const ta = document.getElementById('dtInput');
        ta.value = ta.value ? ta.value + '\n\n' + snippet : snippet;
        ta.focus();
        autoResizeInput(ta);
        showToast(`Attached ${name}`, 'success');
    } catch (e) { showToast('Failed to read file: ' + e.message, 'error'); }
}

function closeFileBrowser() {
    document.getElementById('fileBrowserOverlay').style.display = 'none';
}

