function renderHybridCheckboxes() {
    const container = document.getElementById('hybridConnCheckboxes');
    container.innerHTML = '';
    adminConns.filter(c => c.isEnabled).forEach(c => {
        const chip = document.createElement('label');
        chip.className = 'hybrid-conn-chip selected';
        chip.dataset.id = c.id;
        chip.innerHTML = `<input type="checkbox" checked value="${c.id}"> ${escHtml(c.name)}`;
        chip.querySelector('input').addEventListener('change', e => {
            chip.classList.toggle('selected', e.target.checked);
        });
        container.appendChild(chip);
    });
    // Rebuild lanes for current selection
    renderHybridLanes();
}

function getSelectedConnIds() {
    return Array.from(document.querySelectorAll('#hybridConnCheckboxes input:checked')).map(i => parseInt(i.value));
}

function hybridSelectAll() {
    document.querySelectorAll('#hybridConnCheckboxes input').forEach(i => { i.checked = true; i.closest('.hybrid-conn-chip').classList.add('selected'); });
    renderHybridLanes();
}

function hybridClearAll() {
    document.querySelectorAll('#hybridConnCheckboxes input').forEach(i => { i.checked = false; i.closest('.hybrid-conn-chip').classList.remove('selected'); });
    renderHybridLanes();
}

function renderHybridLanes() {
    const ids   = getSelectedConnIds();
    const lanes = document.getElementById('hybridLanes');
    // Keep existing lanes that are still selected, remove deselected
    const existing = Array.from(lanes.querySelectorAll('.hybrid-lane')).map(l => parseInt(l.dataset.id));
    existing.filter(id => !ids.includes(id)).forEach(id => lanes.querySelector(`.hybrid-lane[data-id="${id}"]`)?.remove());
    ids.filter(id => !existing.includes(id)).forEach(id => {
        const conn = adminConns.find(c => c.id === id);
        if (conn) lanes.appendChild(buildLane(conn));
    });
}

function buildLane(conn) {
    const lane = document.createElement('div');
    lane.className   = 'hybrid-lane';
    lane.dataset.id  = conn.id;
    const provLabel  = { claude:'Claude', claudecli:'Claude CLI', ollama:'Ollama', openai:'OpenAI', groq:'Groq', together:'Together', mistral:'Mistral', perplexity:'Perplexity', deepseek:'DeepSeek', gemini:'Gemini', cohere:'Cohere', azure:'Azure', xai:'xAI', lmstudio:'LM Studio', custom:'Custom' };
    lane.innerHTML = `
        <div class="hybrid-lane-header">
            <div style="width:8px;height:8px;border-radius:50%;background:var(--accent-color);flex-shrink:0"></div>
            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis">${escHtml(conn.name)}</span>
            <span style="font-size:10px;font-weight:400;color:var(--text-muted)">${provLabel[conn.provider]||conn.provider} · ${escHtml(conn.model||'—')}</span>
        </div>
        <div class="hybrid-lane-body" id="hlane-${conn.id}"></div>
        <div class="hybrid-lane-actions" id="hlane-actions-${conn.id}" style="display:none"></div>
    `;
    return lane;
}

function appendHybridMsg(connId, text, type /* user|reply|error|review|fix */) {
    const body = document.getElementById(`hlane-${connId}`);
    if (!body) return;
    const div = document.createElement('div');
    div.className = `hybrid-msg ${type === 'reply' ? '' : type}`;
    div.innerHTML = formatMarkdown(text);
    if (type === 'reply' || type === 'fix') {
        const ms = document.createElement('div');
        ms.style.cssText = 'font-size:10px;color:var(--text-muted);margin-top:6px';
        ms.id = `hlane-ms-${connId}`;
        div.appendChild(ms);
    }
    body.appendChild(div);
    body.scrollTop = body.scrollHeight;
    return div;
}

function showLaneSpinner(connId, on) {
    const body = document.getElementById(`hlane-${connId}`);
    if (!body) return;
    const existing = body.querySelector('.hlane-spinner');
    if (on && !existing) {
        const s = document.createElement('div');
        s.className = 'hlane-spinner';
        s.style.cssText = 'display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-muted);padding:4px 0';
        s.innerHTML = '<span class="dt-spin"></span> Generating…';
        body.appendChild(s);
        body.scrollTop = body.scrollHeight;
    } else if (!on && existing) {
        existing.remove();
    }
}

function updateLaneActions(connId, prompt, reply) {
    hybridLaneState[connId] = { lastReply: reply, lastPrompt: prompt };
    const actDiv = document.getElementById(`hlane-actions-${connId}`);
    if (!actDiv) return;
    actDiv.style.display = '';
    const others = adminConns.filter(c => c.isEnabled && c.id !== connId);
    actDiv.innerHTML = '';

    // "Ask [other] to review" buttons
    others.forEach(other => {
        const btn = document.createElement('button');
        btn.className = 'hybrid-action-btn review';
        btn.textContent = `Review with ${other.name}`;
        btn.onclick = () => hybridReview(connId, other.id, prompt, reply, other.name);
        actDiv.appendChild(btn);
    });

    // Copy button
    const copyBtn = document.createElement('button');
    copyBtn.className = 'hybrid-action-btn';
    copyBtn.textContent = 'Copy';
    copyBtn.onclick = () => { navigator.clipboard.writeText(reply); showToast('Copied', 'success'); };
    actDiv.appendChild(copyBtn);

    // Use in chat button
    const useBtn = document.createElement('button');
    useBtn.className = 'hybrid-action-btn';
    useBtn.textContent = 'Use in chat';
    useBtn.onclick = () => {
        toggleHybrid();
        document.getElementById('dtInput').value = reply;
        document.getElementById('dtInput').focus();
    };
    actDiv.appendChild(useBtn);
}

async function hybridBroadcast() {
    const ids  = getSelectedConnIds();
    if (ids.length === 0) { showToast('Select at least one LLM', 'error'); return; }
    const text = document.getElementById('hybridInput').value.trim();
    if (!text && hybridImages.length === 0) return;

    const btn    = document.getElementById('hybridSendBtn');
    const status = document.getElementById('hybridStatus');
    btn.disabled = true;
    const images = hybridImages.map(i => i.dataUrl);
    clearHybridImages();
    document.getElementById('hybridInput').value = '';

    // Show user message in each lane
    ids.forEach(id => appendHybridMsg(id, text, 'user'));
    ids.forEach(id => showLaneSpinner(id, true));
    status.textContent = `Waiting for ${ids.length} response${ids.length>1?'s':''}…`;

    try {
        const r = await fetch('/api/devtools/hybrid/broadcast', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connectionIds: ids, message: text, images: images.length ? images : undefined })
        });
        const results = await r.json();

        ids.forEach(id => showLaneSpinner(id, false));
        results.forEach(res => {
            if (res.error) {
                appendHybridMsg(res.connectionId, res.error, 'error');
            } else {
                const msgDiv = appendHybridMsg(res.connectionId, res.reply, 'reply');
                if (msgDiv) {
                    const msEl = msgDiv.querySelector(`#hlane-ms-${res.connectionId}`);
                    if (msEl) msEl.textContent = `${res.ms}ms`;
                }
                updateLaneActions(res.connectionId, text, res.reply);
            }
        });
        status.textContent = `Done (${results.filter(r=>!r.error).length}/${results.length} ok)`;
    } catch (e) {
        ids.forEach(id => showLaneSpinner(id, false));
        ids.forEach(id => appendHybridMsg(id, 'Network error: ' + e.message, 'error'));
        status.textContent = 'Error';
    } finally {
        btn.disabled = false;
    }
}

async function hybridReview(authorConnId, reviewerConnId, prompt, content, reviewerName) {
    const authorConn = adminConns.find(c => c.id === authorConnId);
    appendHybridMsg(authorConnId, `Asking ${reviewerName} to review…`, 'review');
    const actDiv = document.getElementById(`hlane-actions-${authorConnId}`);
    if (actDiv) actDiv.querySelectorAll('button').forEach(b => b.disabled = true);

    try {
        const r = await fetch('/api/devtools/hybrid/review', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                reviewerConnectionId: reviewerConnId,
                originalPrompt: prompt,
                contentToReview: content,
                authorLabel: authorConn?.name || `Connection ${authorConnId}`
            })
        });
        const res = await r.json();
        if (res.error) {
            appendHybridMsg(authorConnId, 'Review error: ' + res.error, 'error');
        } else {
            appendHybridMsg(authorConnId, `Review by ${reviewerName}:\n\n${res.review}`, 'review');
            // Add Fix button
            if (actDiv) {
                actDiv.querySelectorAll('button').forEach(b => b.disabled = false);
                const fixBtn = document.createElement('button');
                fixBtn.className = 'hybrid-action-btn fix';
                fixBtn.textContent = `Fix with ${authorConn?.name || 'original'}`;
                fixBtn.onclick = () => hybridFix(authorConnId, prompt, content, res.review, fixBtn);
                actDiv.appendChild(fixBtn);
            }
        }
    } catch (e) {
        appendHybridMsg(authorConnId, 'Network error: ' + e.message, 'error');
        if (actDiv) actDiv.querySelectorAll('button').forEach(b => b.disabled = false);
    }
}

async function hybridFix(authorConnId, prompt, originalReply, reviewFeedback, fixBtn) {
    if (fixBtn) fixBtn.disabled = true;
    appendHybridMsg(authorConnId, 'Fixing based on review…', 'fix');

    try {
        const r = await fetch('/api/devtools/hybrid/fix', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ authorConnectionId: authorConnId, originalPrompt: prompt, originalReply, reviewFeedback })
        });
        const res = await r.json();
        if (res.error) {
            appendHybridMsg(authorConnId, 'Fix error: ' + res.error, 'error');
        } else {
            appendHybridMsg(authorConnId, res.reply, 'fix');
            updateLaneActions(authorConnId, prompt, res.reply);
        }
    } catch (e) {
        appendHybridMsg(authorConnId, 'Network error: ' + e.message, 'error');
    } finally {
        if (fixBtn) fixBtn.disabled = false;
    }
}

function onHybridInputKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); hybridBroadcast(); }
}

function onHybridImagesSelected(e) {
    Array.from(e.target.files).filter(f => f.type.startsWith('image/')).forEach(f => {
        const reader = new FileReader();
        reader.onload = ev => { hybridImages.push({ dataUrl: ev.target.result }); renderHybridImagePreviews(); };
        reader.readAsDataURL(f);
    });
    e.target.value = '';
}

function renderHybridImagePreviews() {
    const c = document.getElementById('hybridAttachedImages');
    c.innerHTML = '';
    hybridImages.forEach((img, i) => {
        const d = document.createElement('span');
        d.style.cssText = 'position:relative;display:inline-block';
        d.innerHTML = `<img src="${img.dataUrl}" style="width:32px;height:32px;border-radius:4px;object-fit:cover;border:1px solid var(--border-color)" /><button onclick="hybridImages.splice(${i},1);renderHybridImagePreviews()" style="position:absolute;top:-4px;right:-4px;width:14px;height:14px;border-radius:50%;border:none;background:var(--error-color);color:white;font-size:8px;cursor:pointer;display:flex;align-items:center;justify-content:center">✕</button>`;
        c.appendChild(d);
    });
}

function clearHybridImages() { hybridImages = []; renderHybridImagePreviews(); }

function showToast(msg, type) {
    const t = document.createElement('div');
    t.style.cssText = `position:fixed;bottom:20px;right:20px;z-index:9999;padding:10px 16px;border-radius:8px;font-size:13px;font-weight:500;color:white;background:${type==='success'?'var(--success-color)':type==='error'?'var(--error-color)':'var(--accent-color)'};box-shadow:0 4px 12px rgba(0,0,0,.3);transition:opacity .3s`;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 2800);
}

