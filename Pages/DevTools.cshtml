async function saveAndTest(source) {
    const el = document.getElementById(`ts-${source}`);
    el.style.display = 'inline';
    el.style.color = 'var(--text-muted)';
    el.textContent = 'Saving…';

    // Save all settings first
    const dto = collectGlobalSettingsDto();
    const saveR = await fetch('/api/devtools/admin/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(dto)
    });
    if (!saveR.ok) {
        el.textContent = 'Save failed.';
        el.style.color = 'var(--error-color)';
        return;
    }

    // Reload masked values so UI reflects saved state
    await loadAdminGlobalSettings();

    el.textContent = 'Testing…';
    try {
        const testR = await fetch(`/api/devtools/admin/settings/test?source=${encodeURIComponent(source)}`, { method: 'POST' });
        const result = await testR.json();
        el.textContent = result.success ? `✓ ${result.message}` : `✗ ${result.message}`;
        el.style.color = result.success ? 'var(--success-color)' : 'var(--error-color)';
    } catch (e) {
        el.textContent = `✗ ${e.message}`;
        el.style.color = 'var(--error-color)';
    }
}

