}

function copyResult() {
    navigator.clipboard.writeText(state.lastResult).then(() => showToast('Copied', 'success'));
}

function insertResultToChat() {
    document.getElementById('dtInput').value = state.lastResult;
    closeResult();
    document.getElementById('dtInput').focus();
}

// ── Skills ───────────────────────────────────────────────────────────────────
function renderSkillChips(ws) {
    const area   = document.getElementById('skillsArea');
    const btn    = document.querySelector('[onclick="openSkillsModal()"]');
    const skills = ws.enabledSkills || [];
    area.innerHTML = '';
    skills.forEach(s => {
        const chip = document.createElement('span');
        chip.className = 'skill-chip';
        chip.textContent = s;
        chip.title = 'Click to remove';
        chip.onclick = () => toggleSkillChip(ws, s);
        area.appendChild(chip);
    });
    // Update button label
    if (btn) btn.textContent = skills.length > 0 ? `Skills (${skills.length})` : '+ Skills';
}

async function toggleSkillChip(ws, skill) {
    ws.enabledSkills = ws.enabledSkills.filter(s => s !== skill);
    try {
        await fetch(`/api/devtools/workspaces/${ws.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...ws })
        });
    } catch {}
    renderSkillChips(ws);
}

function openSkillsModal() {
    const ws = activeWorkspace();
    if (!ws) return;
    state.pendingSkills = [...(ws.enabledSkills || [])];
    renderSkillsGrid();
    document.getElementById('newSkillName').value = '';
    document.getElementById('newSkillPrompt').value = '';
    document.getElementById('skillAddForm').style.display = 'none';
    document.getElementById('skillAddToggle').style.display = '';
    document.getElementById('skillsOverlay').classList.add('open');
}

function toggleSkillAddForm() {
    const form = document.getElementById('skillAddForm');
    const btn  = document.getElementById('skillAddToggle');
    const show = form.style.display === 'none';
    form.style.display = show ? 'flex' : 'none';
    btn.style.display  = show ? 'none' : '';
    if (show) document.getElementById('newSkillName').focus();
}

function renderSkillsGrid() {
    const grid = document.getElementById('skillsGrid');
    grid.innerHTML = '';
    if (!state.allSkills.length) {
        grid.innerHTML = '<div style="text-align:center;color:var(--text-muted);font-size:12px;padding:24px 0">No skills yet. Add one below.</div>';
        return;
    }
    state.allSkills.forEach(skill => {
        const enabled = state.pendingSkills.includes(skill.name);
        const row = document.createElement('div');
        row.className = 'skill-row' + (enabled ? ' active' : '');
        row.onclick = (e) => {
            if (e.target.closest('textarea') || e.target.closest('button')) return;
            const cb = row.querySelector('input[type=checkbox]');
            cb.checked = !cb.checked;
            cb.dispatchEvent(new Event('change'));
        };
        row.innerHTML = `
            <label class="skill-toggle" title="${enabled ? 'Disable' : 'Enable'} ${escHtml(skill.name)}">
                <input type="checkbox" ${enabled ? 'checked' : ''}
                    onchange="togglePendingSkill('${escHtml(skill.name)}', this.checked); this.closest('.skill-row').classList.toggle('active', this.checked)" />
                <div class="skill-toggle-track"></div>
                <div class="skill-toggle-thumb"></div>
            </label>
            <div class="skill-info">
                <div class="skill-info-name">
                    <span>${escHtml(skill.name)}</span>
                    ${skill.isBuiltIn
                        ? '<span class="skill-badge builtin">built-in</span>'
                        : '<span class="skill-badge custom">custom</span>'}
                </div>
                <textarea class="skill-prompt-edit" data-skill-id="${skill.id}"
                    onchange="updateSkillPrompt(${skill.id}, this.value)"
                    onclick="event.stopPropagation()"
                >${escHtml(skill.systemPromptAddition)}</textarea>
            </div>
            ${!skill.isBuiltIn ? `<button class="btn btn-ghost" style="padding:3px 7px;color:var(--error-color);flex-shrink:0;align-self:flex-start" onclick="event.stopPropagation();deleteSkill(${skill.id})" title="Delete">&#x2715;</button>` : ''}
        `;
        grid.appendChild(row);
    });
}

function togglePendingSkill(name, checked) {
    if (checked) { if (!state.pendingSkills.includes(name)) state.pendingSkills.push(name); }
    else { state.pendingSkills = state.pendingSkills.filter(s => s !== name); }
}

async function updateSkillPrompt(id, newPrompt) {
    const skill = state.allSkills.find(s => s.id === id);
    if (!skill) return;
    try {
        const r = await fetch(`/api/devtools/skills/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, name: skill.name, systemPromptAddition: newPrompt, isBuiltIn: skill.isBuiltIn })
        });
        const updated = await r.json();
        const idx = state.allSkills.findIndex(s => s.id === id);
        if (idx >= 0) state.allSkills[idx] = updated;
    } catch { showToast('Failed to save prompt', 'error'); }
}

async function addNewSkill() {
    const name = document.getElementById('newSkillName').value.trim();
    const prompt = document.getElementById('newSkillPrompt').value.trim();
    if (!name) { showToast('Skill name is required', 'error'); return; }
    if (!prompt) { showToast('Skill prompt is required', 'error'); return; }

    try {
        const r = await fetch('/api/devtools/skills', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, systemPromptAddition: prompt })
        });
        if (!r.ok) { const e = await r.json(); showToast(e.error || 'Failed', 'error'); return; }
        const created = await r.json();
        state.allSkills.push(created);
        document.getElementById('newSkillName').value = '';
        document.getElementById('newSkillPrompt').value = '';
        toggleSkillAddForm(); // hide form
        renderSkillsGrid();
        showToast(`Skill "${name}" added`, 'success');
    } catch (e) { showToast(e.message, 'error'); }
}

async function deleteSkill(id) {
    const skill = state.allSkills.find(s => s.id === id);
    if (!confirm(`Delete custom skill "${skill?.name}"?`)) return;
    try {
        const r = await fetch(`/api/devtools/skills/${id}`, { method: 'DELETE' });
        if (!r.ok) { const e = await r.json(); showToast(e.error, 'error'); return; }
        state.allSkills = state.allSkills.filter(s => s.id !== id);
        state.pendingSkills = state.pendingSkills.filter(s => s !== skill?.name);
        renderSkillsGrid();
        showToast('Skill deleted', 'success');
    } catch (e) { showToast(e.message, 'error'); }
}

async function saveSkills() {
    const ws = activeWorkspace();
    if (!ws) return;
    ws.enabledSkills = state.pendingSkills;
    try {
        const r = await fetch(`/api/devtools/workspaces/${ws.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...ws })
        });
        const updated = await r.json();
        const idx = state.workspaces.findIndex(w => w.id === ws.id);
        state.workspaces[idx] = updated;
        renderSkillChips(updated);
    } catch {}
    closeSkillsModal();
    showToast('Skills updated', 'success');
}

function closeSkillsModal() {
    document.getElementById('skillsOverlay').classList.remove('open');
}

