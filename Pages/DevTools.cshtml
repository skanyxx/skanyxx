@section Scripts {
<script>
// ── State ───────────────────────────────────────────────────────────────────
const state = {
    workspaces: [],       // [{id, name, llmProvider, llmModel, enabledSkills, ...}]
    activeId: null,       // active workspace id
    tasks: {},            // {workspaceId: [{id, title, description, type, priority, source}]}
    sessions: {},         // {`${wsId}:${taskId}`: {messages, summaryContext, totalTokensUsed}}
    activeTask: null,     // current task object
    allSkills: [],
    pendingSkills: [],    // skills being edited in modal
    lastResult: '',       // last agent action output
    hasLlm: false         // true when at least one enabled LLM connection exists
};

const MAX_TOKENS = 100000; // display ceiling for bar

// ── Init ────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
    await initSignalR();
    await loadSkills();
    await checkLlmConnections();
    await loadWorkspaces();
});

async function checkLlmConnections() {
    try {
        const r = await fetch('/api/devtools/admin/connections');
        const conns = await r.json();
        state.hasLlm = Array.isArray(conns) && conns.some(c => c.isEnabled);
    } catch { state.hasLlm = false; }
    updateAddTabBtn();
}

function updateAddTabBtn() {
    const btn = document.getElementById('dtAddTab');
    const msg = document.getElementById('dtEmptyMsg');
    if (!state.hasLlm) {
        btn.disabled = true;
        btn.title = 'Configure an LLM connection in Admin first';
        btn.style.opacity = '0.4';
        btn.style.cursor = 'not-allowed';
        if (msg) msg.innerHTML = 'No LLM configured. Click <strong>⚙ Admin</strong> to add a connection first.';
    } else {
        btn.disabled = state.workspaces.length >= 10;
        btn.title = state.workspaces.length >= 10 ? 'Max 10 workspaces' : 'Add workspace';
        btn.style.opacity = '';
        btn.style.cursor = '';
        if (msg) msg.innerHTML = 'No workspace selected. Create one with <strong>+</strong> above.';
    }
}

async function loadSkills() {
    try {
        const r = await fetch('/api/devtools/skills');
        state.allSkills = await r.json(); // [{id, name, systemPromptAddition, isBuiltIn}]
    } catch { state.allSkills = []; }
}

async function loadWorkspaces() {
    try {
        const r = await fetch('/api/devtools/workspaces');
        state.workspaces = await r.json();
    } catch { state.workspaces = []; }
    renderTabs();
    if (state.workspaces.length > 0) switchTab(state.workspaces[0].id);
}

// ── Tabs ────────────────────────────────────────────────────────────────────
function renderTabs() {
    const list = document.getElementById('dtTabsList');
    list.innerHTML = '';
    state.workspaces.forEach(ws => {
        const tab = document.createElement('div');
        tab.className = 'dt-tab' + (ws.id === state.activeId ? ' active' : '');
        tab.innerHTML = `
            <span class="tab-name">${escHtml(ws.name)}</span>
            <span class="tab-close" onclick="event.stopPropagation();removeTab(${ws.id})" title="Close workspace">&#x2715;</span>
        `;
        tab.addEventListener('click', () => switchTab(ws.id));
        list.appendChild(tab);
    });
    updateAddTabBtn();
}

async function addTab() {
    if (!state.hasLlm) { showToast('Add an LLM connection in Admin (⚙) before creating a workspace', 'error'); return; }
    const ws = { name: `Workspace ${state.workspaces.length + 1}`, llmProvider: 'claude', llmModel: 'claude-sonnet-4-6', enabledSkills: [] };
    try {
        const r = await fetch('/api/devtools/workspaces', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(ws) });
        const created = await r.json();
        state.workspaces.push(created);
        renderTabs();
        switchTab(created.id);
        toggleConfig(); // open config for new workspace
    } catch (e) { showToast('Failed to create workspace: ' + e.message, 'error'); }
}

async function removeTab(id) {
    if (!confirm('Remove this workspace and all its history?')) return;
    try {
        await fetch(`/api/devtools/workspaces/${id}`, { method: 'DELETE' });
        state.workspaces = state.workspaces.filter(w => w.id !== id);
        if (state.activeId === id) {
            state.activeId = null;
            document.getElementById('dtHeader').style.display = 'none';
            document.getElementById('dtWorkspace').classList.remove('active');
            document.getElementById('dtEmptyState').style.display = 'flex';
        }
        renderTabs();
        if (state.workspaces.length > 0 && !state.activeId) switchTab(state.workspaces[0].id);
    } catch (e) { showToast('Failed to remove workspace', 'error'); }
}

async function switchTab(id) {
    state.activeId = id;
    renderTabs();
    const ws = state.workspaces.find(w => w.id === id);
    if (!ws) return;

    // Show header & workspace
    document.getElementById('dtHeader').style.display = 'flex';
    document.getElementById('dtWorkspace').classList.add('active');
    document.getElementById('dtEmptyState').style.display = 'none';

    // Close config panel
    document.getElementById('dtConfigPanel').classList.remove('open');

    updateLlmBadge(ws);
    updateInputBar(ws);
    renderSkillChips(ws);

    // Re-evaluate Send button: disabled only if this workspace has an active stream
    const hasActiveStream = [..._streams.keys()].some(cid => cid.startsWith(`${id}-`));
    const btn = document.getElementById('dtSendBtn');
    btn.disabled = hasActiveStream;
    btn.textContent = hasActiveStream ? '' : 'Send';
    if (hasActiveStream) btn.innerHTML = '<span class="dt-spin"></span>';

    // Load tasks
    await refreshTasks();

    // Load session for current task
    await loadSession();
}

// ── Config ──────────────────────────────────────────────────────────────────
function toggleConfig() {
    const panel = document.getElementById('dtConfigPanel');
    const open = panel.classList.toggle('open');
    if (open) populateConfig();
}

function populateConfig() {
    const ws = activeWorkspace();
    if (!ws) return;
    document.getElementById('cfgName').value        = ws.name || '';
    document.getElementById('cfgProvider').value    = ws.llmProvider || 'claude';
    document.getElementById('cfgModel').value       = ws.llmModel || '';
    document.getElementById('cfgApiKey').value      = '';   // never pre-fill secrets
    document.getElementById('cfgUrl').value         = ws.llmUrl || '';
    document.getElementById('cfgGitPath').value     = ws.gitRepoPath || '';
    document.getElementById('cfgJiraUrl').value     = ws.jiraUrl || '';
    document.getElementById('cfgJiraEmail').value   = ws.jiraEmail || '';
    document.getElementById('cfgJiraToken').value   = '';   // never pre-fill secrets
    document.getElementById('cfgJiraProject').value = ws.jiraProjectKey || '';
    document.getElementById('cfgMondayToken').value = '';   // never pre-fill secrets
    document.getElementById('cfgMondayBoard').value = ws.mondayBoardId || '';
    onProviderChange(); // show/hide URL & API key groups + set placeholder
}

function onProviderChange() {
    const p = document.getElementById('cfgProvider').value;
    const needsUrl = ['ollama', 'openai', 'azure', 'lmstudio', 'custom'].includes(p);
    document.getElementById('cfgUrlGroup').style.display = needsUrl ? '' : 'none';
    document.getElementById('cfgApiKeyGroup').style.display = ['ollama', 'lmstudio', 'custom', 'claudecli'].includes(p) ? 'none' : '';
    const urlHints = { ollama:'http://localhost:11434', openai:'https://api.openai.com', azure:'https://<resource>.openai.azure.com/openai/deployments/<deployment>', lmstudio:'http://localhost:1234' };
    const urlEl = document.getElementById('cfgUrl');
    if (!urlEl.value && urlHints[p]) urlEl.placeholder = urlHints[p];
    const defaults = { claude:'claude-sonnet-4-6', claudecli:'', ollama:'llama3', openai:'gpt-4o', groq:'llama-3.3-70b-versatile', together:'meta-llama/Llama-3-70b-chat-hf', mistral:'mistral-large-latest', perplexity:'sonar-pro', deepseek:'deepseek-chat', gemini:'gemini-2.0-flash', cohere:'command-r-plus', xai:'grok-3-latest', azure:'', lmstudio:'', custom:'' };
    const m = document.getElementById('cfgModel');
    if (!m.value) m.value = defaults[p] || '';
}

async function saveConfig() {
    const ws = activeWorkspace();
    if (!ws) return;

    const urlVisible = document.getElementById('cfgUrlGroup').style.display !== 'none';
    const urlVal = document.getElementById('cfgUrl').value.trim();
    const dto = {
        name: document.getElementById('cfgName').value || ws.name,
        llmProvider: document.getElementById('cfgProvider').value,
        llmModel: document.getElementById('cfgModel').value.trim(),
        llmUrl: urlVisible ? urlVal : (ws.llmUrl || ''),
        apiKey: document.getElementById('cfgApiKey').value || undefined,
        enabledSkills: ws.enabledSkills || [],
        jiraUrl: document.getElementById('cfgJiraUrl').value,
        jiraEmail: document.getElementById('cfgJiraEmail').value,
        jiraToken: document.getElementById('cfgJiraToken').value || undefined,
        jiraProjectKey: document.getElementById('cfgJiraProject').value,
        mondayToken: document.getElementById('cfgMondayToken').value || undefined,
        mondayBoardId: document.getElementById('cfgMondayBoard').value,
        gitRepoPath: document.getElementById('cfgGitPath').value
    };

    try {
        const r = await fetch(`/api/devtools/workspaces/${ws.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dto)
        });
        const updated = await r.json();
        const idx = state.workspaces.findIndex(w => w.id === ws.id);
        state.workspaces[idx] = updated;
        renderTabs();
        updateLlmBadge(updated);
        renderSkillChips(updated);
        document.getElementById('dtConfigPanel').classList.remove('open');
        showToast('Workspace saved', 'success');
    } catch (e) { showToast('Save failed: ' + e.message, 'error'); }
}

// ── Tasks ───────────────────────────────────────────────────────────────────
async function refreshTasks() {
    const ws = activeWorkspace();
    if (!ws) return;
    const source = document.getElementById('taskSource').value;
    if (source === 'manual') { renderTaskOptions([]); return; }

    try {
        const r = await fetch(`/api/devtools/tasks?workspaceId=${ws.id}&source=${source}`);
        const tasks = await r.json();
        state.tasks[ws.id] = tasks;
        renderTaskOptions(tasks);
    } catch { renderTaskOptions([]); }
}

function onTaskSourceChange() {
    refreshTasks();
    document.getElementById('taskSelect').innerHTML = '<option value="">-- select task --</option>';
    clearTaskBadges();
}

function renderTaskOptions(tasks) {
    const sel = document.getElementById('taskSelect');
    const cur = sel.value;
    sel.innerHTML = '<option value="">-- select task --</option>';
    tasks.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.id;
        opt.textContent = `[${t.id}] ${t.title}`;
        opt.dataset.task = JSON.stringify(t);
        sel.appendChild(opt);
    });
    if (cur) sel.value = cur;
}

async function onTaskSelected() {
    const sel = document.getElementById('taskSelect');
    const opt = sel.selectedOptions[0];
    if (!opt || !opt.value) {
        state.activeTask = null;
        clearTaskBadges();
        document.getElementById('dtTaskContext').classList.remove('visible');
        document.getElementById('dtMessages').innerHTML = '';
        return;
    }

    // manual: try to get from dataset, else build minimal
    state.activeTask = opt.dataset.task ? JSON.parse(opt.dataset.task) : { id: opt.value, title: opt.textContent, source: 'manual' };

    // Update badges
    const typeBadge = document.getElementById('taskTypeBadge');
    const prioBadge = document.getElementById('taskPriorityBadge');
    if (state.activeTask.type) {
        typeBadge.textContent = state.activeTask.type;
        typeBadge.className = `dt-task-badge badge-${state.activeTask.type.toLowerCase()}`;
        typeBadge.style.display = '';
    } else { typeBadge.style.display = 'none'; }

    if (state.activeTask.priority) {
        prioBadge.textContent = state.activeTask.priority;
        prioBadge.className = `dt-task-badge badge-${state.activeTask.priority.toLowerCase()}`;
        prioBadge.style.display = '';
    } else { prioBadge.style.display = 'none'; }

    // Task context banner
    document.getElementById('taskContextTitle').textContent = `[${state.activeTask.id}] ${state.activeTask.title}`;
    document.getElementById('taskContextDesc').textContent = state.activeTask.description || '';
    document.getElementById('dtTaskContext').classList.toggle('visible', !!state.activeTask.title);

    await loadSession();
}

function clearTaskBadges() {
    document.getElementById('taskTypeBadge').style.display = 'none';
    document.getElementById('taskPriorityBadge').style.display = 'none';
}

// ── Session / Messages ───────────────────────────────────────────────────────
async function loadSession() {
    const ws = activeWorkspace();
    if (!ws) return;
    const taskId = state.activeTask?.id || '';

    try {
        const r = await fetch(`/api/devtools/sessions/${ws.id}?taskId=${encodeURIComponent(taskId)}`);
        const session = await r.json();
        const key = `${ws.id}:${taskId}`;
        state.sessions[key] = session;
        renderMessages(session);
        updateTokenBar(session.totalTokensUsed);
    } catch {
        renderMessages({ messages: [], summaryContext: null, totalTokensUsed: 0 });
    }
}

function renderMessages(session) {
    const container = document.getElementById('dtMessages');
    container.innerHTML = '';

    if (session.summaryContext) {
        const banner = document.createElement('div');
        banner.className = 'dt-summary-banner';
        banner.textContent = '📝 Context summary: ' + session.summaryContext;
        container.appendChild(banner);
    }

    (session.messages || []).forEach(m => appendMessageToDOM(m.role, m.content, m.tokens, m.images));
    container.scrollTop = container.scrollHeight;
}

function appendMessageToDOM(role, content, tokens, images) {
    const container = document.getElementById('dtMessages');
    const el = document.createElement('div');
    el.className = `dt-msg ${role}`;

    const avatar = document.createElement('div');
    avatar.className = 'dt-msg-avatar';
    avatar.textContent = role === 'user' ? 'U' : 'AI';

    const bubble = document.createElement('div');
    bubble.className = 'dt-msg-bubble';

    // Show attached images above the text
    if (images?.length) {
        const imgRow = document.createElement('div');
        imgRow.style.cssText = 'display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px';
        images.forEach(src => {
            const img = document.createElement('img');
            img.src = src;
            img.style.cssText = 'max-width:180px;max-height:140px;border-radius:6px;border:1px solid var(--border-color);object-fit:cover';
            imgRow.appendChild(img);
        });
        bubble.appendChild(imgRow);
    }
    const textNode = document.createElement('div');
    textNode.innerHTML = formatMarkdown(content);
    bubble.appendChild(textNode);

    const meta = document.createElement('div');
    meta.className = 'dt-msg-meta';
    meta.textContent = tokens ? `${tokens} tokens` : new Date().toLocaleTimeString();

    el.appendChild(avatar);
    const right = document.createElement('div');
    right.appendChild(bubble);
    right.appendChild(meta);
    el.appendChild(right);

    container.appendChild(el);
    container.scrollTop = container.scrollHeight;
}

// ── SignalR chat connection ───────────────────────────────────────────────────

let dtConnection = null;

// Keyed by correlationId → { el, raw, wsId }
// Allows multiple concurrent streams (one per workspace tab) without interference.
const _streams = new Map();

async function initSignalR() {
    dtConnection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/devtools')
        .withAutomaticReconnect([0, 1000, 3000, 5000])
        .configureLogging(signalR.LogLevel.Warning)
        .build();

    dtConnection.on('ReceiveStart', cid => {
        _streams.set(cid, { el: createStreamingBubble(cid), raw: '' });
    });

    dtConnection.on('ReceiveTool', (cid, label) => {
        const s = _streams.get(cid);
        if (s) appendToolChip(s.el, label);
    });

    dtConnection.on('ReceiveToken', (cid, chunk) => {
        const s = _streams.get(cid);
        if (!s) return;
        s.raw += chunk;
        updateStreamingText(s.el, s.raw);
    });

    dtConnection.on('ReceiveDone', (cid, stats) => {
        const s = _streams.get(cid);
        if (s) finalizeStreamingBubble(s.el, s.raw, stats.outputTokens);
        updateTokenBar(stats.totalSessionTokens);
        _streams.delete(cid);
        enableSendBtnFor(cid);
    });

    dtConnection.on('ReceiveError', (cid, error) => {
        const s = _streams.get(cid);
        const msg = '⚠️ ' + error;
        if (s) finalizeStreamingBubble(s.el, msg, 0);
        else   appendMessageToDOM('assistant', msg, 0);
        _streams.delete(cid);
        enableSendBtnFor(cid);
    });

    dtConnection.onreconnecting(() => showToast('Reconnecting to server…', 'error'));
    dtConnection.onreconnected(() => showToast('Reconnected', 'success'));

    try { await dtConnection.start(); }
    catch (e) { console.warn('SignalR start failed, will retry automatically:', e); }
}

function createStreamingBubble(cid) {
    const container = document.getElementById('dtMessages');
    const el = document.createElement('div');
    el.className = 'dt-msg assistant';
    el.dataset.cid = cid;

    const avatar = document.createElement('div');
    avatar.className = 'dt-msg-avatar';
    avatar.textContent = 'AI';

    const bubble = document.createElement('div');
    bubble.className = 'dt-msg-bubble';

    // Tool chips row (hidden until first tool fires)
    const toolCalls = document.createElement('div');
    toolCalls.className = 'dt-tool-calls';
    toolCalls.style.display = 'none';
    bubble.appendChild(toolCalls);

    // Text area — starts with spinner, replaced by streaming text
    const textArea = document.createElement('div');
    textArea.className = 'dt-stream-text dt-stream-cursor';
    textArea.innerHTML = '<span class="dt-spin" style="display:inline-block;vertical-align:middle;margin-right:4px"></span>'
                       + '<span style="opacity:.5;font-size:12px">Thinking…</span>';
    bubble.appendChild(textArea);

    const meta = document.createElement('div');
    meta.className = 'dt-msg-meta';
    meta.textContent = '…';

    const right = document.createElement('div');
    right.appendChild(bubble);
    right.appendChild(meta);

    el.appendChild(avatar);
    el.appendChild(right);
    container.appendChild(el);
    container.scrollTop = container.scrollHeight;

    el._bubble    = bubble;
    el._toolCalls = toolCalls;
    el._textArea  = textArea;
    el._meta      = meta;
    el._hasText   = false;
    return el;
}

function appendToolChip(el, label) {
    el._toolCalls.style.display = 'flex';
    const chip = document.createElement('span');
    chip.className = 'dt-tool-chip running';
    chip.textContent = label;
    el._toolCalls.appendChild(chip);
    // Mark previous chips as done (new chip means last one finished)
    el._toolCalls.querySelectorAll('.dt-tool-chip.running:not(:last-child)')
       .forEach(c => c.classList.replace('running', 'done'));
    document.getElementById('dtMessages').scrollTop = 99999;
}

function updateStreamingText(el, rawText) {
    if (!el._hasText) {
        // First token — replace spinner with real text
        el._textArea.innerHTML = '';
        el._hasText = true;
        // Mark all chips as done once text starts arriving
        el._toolCalls.querySelectorAll('.dt-tool-chip.running')
           .forEach(c => c.classList.replace('running', 'done'));
    }
    el._textArea.textContent = rawText;   // raw during stream, markdown on done
    document.getElementById('dtMessages').scrollTop = 99999;
}

function finalizeStreamingBubble(el, rawText, tokens) {
    // Mark any remaining running chips as done
    el._toolCalls.querySelectorAll('.dt-tool-chip.running')
       .forEach(c => c.classList.replace('running', 'done'));
    // Remove blinking cursor, render markdown
    el._textArea.classList.remove('dt-stream-cursor');
    el._textArea.innerHTML = formatMarkdown(rawText);
    el._meta.textContent = tokens ? `${tokens} tokens` : new Date().toLocaleTimeString();
    document.getElementById('dtMessages').scrollTop = 99999;
}

// Re-enable the Send button only for the workspace that owns this correlationId.
// Other workspaces' buttons are unaffected.
function enableSendBtnFor(cid) {
    // The cid encodes the wsId as the first segment: "<wsId>-<uuid>"
    const wsId = parseInt(cid.split('-')[0], 10);
    if (wsId === state.activeId) {
        const btn = document.getElementById('dtSendBtn');
        btn.disabled = false;
        btn.textContent = 'Send';
    }
    // If this workspace is no longer active the button is already reset on tab switch
}

// Attached images state: [{dataUrl, name}]
let attachedImages = [];

async function sendMessage() {
    const ws = activeWorkspace();
    if (!ws) return;
    const input = document.getElementById('dtInput');
    const text = input.value.trim();
    if (!text && attachedImages.length === 0) return;

    // Ensure SignalR is connected before sending
    if (!dtConnection || dtConnection.state !== signalR.HubConnectionState.Connected) {
        showToast('Connecting… please try again in a moment', 'error');
        try { await dtConnection?.start(); } catch {}
        return;
    }

    const btn = document.getElementById('dtSendBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="dt-spin"></span>';
    input.value = '';
    input.style.height = '';

    const images = attachedImages.map(i => i.dataUrl);
    clearAttachedImages();

    appendMessageToDOM('user', text, null, images);

    // Correlation ID encodes the workspace so routing is unambiguous even with
    // 3 simultaneous chats on the same SignalR connection.
    const cid = `${ws.id}-${crypto.randomUUID()}`;

    const payload = {
        workspaceId: ws.id,
        taskId: state.activeTask?.id || '',
        taskSource: state.activeTask?.source || document.getElementById('taskSource').value,
        taskTitle: state.activeTask?.title || '',
        taskDescription: state.activeTask?.description || '',
        message: text,
        images: images.length > 0 ? images : undefined,
        correlationId: cid
    };

    try {
        await dtConnection.invoke('SendMessage', payload);
        // Tokens arrive via ReceiveToken(cid, chunk) → routed by cid, never mixed up
    } catch (e) {
        appendMessageToDOM('assistant', '⚠️ SignalR error: ' + e.message, 0);
        enableSendBtnFor(cid);
    }
}

function onInputKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
    // Shift+Enter inserts a newline (default textarea behaviour, no action needed)
}

function autoResizeInput(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 160) + 'px';
}

// ── Image attach ─────────────────────────────────────────────────────────────

function onImagesSelected(e) {
    const files = Array.from(e.target.files);
    e.target.value = '';
    files.forEach(f => {
        if (!f.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = ev => {
            attachedImages.push({ dataUrl: ev.target.result, name: f.name });
            renderAttachedImages();
        };
        reader.readAsDataURL(f);
    });
}

function renderAttachedImages() {
    const container = document.getElementById('dtAttachedImages');
    container.style.display = attachedImages.length > 0 ? 'flex' : 'none';
    container.innerHTML = '';
    attachedImages.forEach((img, i) => {
        const thumb = document.createElement('div');
        thumb.className = 'dt-img-thumb';
        thumb.innerHTML = `<img src="${img.dataUrl}" alt="${escHtml(img.name)}" title="${escHtml(img.name)}" /><button onclick="removeAttachedImage(${i})" title="Remove">✕</button>`;
        container.appendChild(thumb);
    });
}

function removeAttachedImage(i) {
    attachedImages.splice(i, 1);
    renderAttachedImages();
}

function clearAttachedImages() {
    attachedImages = [];
    renderAttachedImages();
}

// ── Model picker ─────────────────────────────────────────────────────────────

const MODEL_SUGGESTIONS = {
    claude:    ['claude-opus-4-6', 'claude-sonnet-4-6', 'claude-haiku-4-5-20251001'],
    claudecli: ['claude-opus-4-6', 'claude-sonnet-4-6', '(default)'],
    openai:    ['gpt-4o', 'gpt-4o-mini', 'o1', 'o3-mini'],
    groq:      ['llama-3.3-70b-versatile', 'llama-3.1-8b-instant', 'mixtral-8x7b-32768'],
    together:  ['meta-llama/Llama-3.3-70B-Instruct-Turbo', 'mistralai/Mixtral-8x7B-Instruct-v0.1'],
    gemini:    ['gemini-2.0-flash', 'gemini-1.5-pro', 'gemini-1.5-flash'],
    mistral:   ['mistral-large-latest', 'mistral-small-latest', 'codestral-latest'],
    deepseek:  ['deepseek-chat', 'deepseek-reasoner'],
    ollama:    ['llama3', 'mistral', 'codellama', 'phi3', 'qwen2.5-coder'],
    lmstudio:  ['(auto-detect)'],
    cohere:    ['command-r-plus', 'command-r'],
    perplexity:['sonar-pro', 'sonar'],
    xai:       ['grok-3-latest', 'grok-2'],
    azure:     ['gpt-4o', 'gpt-4-turbo'],
    custom:    [],
};

function toggleModelDropdown(e) {
    e.stopPropagation();
    const dd = document.getElementById('dtModelDropdown');
    const isOpen = dd.classList.toggle('open');
    if (isOpen) {
        populateModelOpts();
        document.getElementById('dtModelCustom').value = '';
        // Close on outside click
        setTimeout(() => document.addEventListener('click', closeModelDropdown, { once: true }), 0);
    }
}

function closeModelDropdown() {
    document.getElementById('dtModelDropdown')?.classList.remove('open');
}

function populateModelOpts() {
    const ws = activeWorkspace();
    const current = ws?.llmModel || '';
    const provider = ws?.llmProvider || 'claude';
    const opts = document.getElementById('dtModelOpts');
    opts.innerHTML = '';
    const suggestions = MODEL_SUGGESTIONS[provider] || [];
    suggestions.forEach(m => {
        const d = document.createElement('div');
        d.className = 'dt-model-opt' + (m === current ? ' active' : '');
        d.textContent = m;
        d.onclick = () => applyModel(m === '(default)' || m === '(auto-detect)' ? '' : m);
        opts.appendChild(d);
    });
}

function onModelInputKey(e) {
    if (e.key === 'Enter') {
        applyModel(e.target.value.trim());
    }
    e.stopPropagation();
}

