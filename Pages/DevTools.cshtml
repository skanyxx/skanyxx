function editConnection(id) {
    const c = adminConns.find(x => x.id === id);
    if (!c) return;
    document.getElementById('connFormId').value = id;
    document.getElementById('connFormTitle').textContent = 'Edit Connection';
    document.getElementById('connName').value = c.name;
    document.getElementById('connProvider').value = c.provider;
    document.getElementById('connModel').value = c.model;
    document.getElementById('connApiKey').value = '';
    document.getElementById('connUrl').value = c.baseUrl || '';
    document.getElementById('connIsDefault').checked = c.isDefault;
    document.getElementById('connIsEnabled').checked = c.isEnabled;
    onConnProviderChange();
    document.getElementById('connForm').style.display = 'block';
    document.getElementById('connForm').scrollIntoView({ behavior: 'smooth' });
}

function onConnProviderChange() {
    const p = document.getElementById('connProvider').value;
    const needsUrl = ['ollama', 'custom', 'openai', 'azure', 'lmstudio'].includes(p);
    document.getElementById('connUrlGroup').style.display = needsUrl ? '' : 'none';
    document.getElementById('connApiKeyGroup').style.display = ['ollama', 'lmstudio', 'custom', 'claudecli'].includes(p) ? 'none' : '';
    const urlHints = {
        ollama: 'http://localhost:11434',
        openai: 'https://api.openai.com',
        azure: 'https://<resource>.openai.azure.com/openai/deployments/<deployment>',
        lmstudio: 'http://localhost:1234'
    };
    const urlEl = document.getElementById('connUrl');
    if (!urlEl.value && urlHints[p]) urlEl.placeholder = urlHints[p];
    const defaults = {
        claude: 'claude-sonnet-4-6',
        claudecli: '',
        ollama: 'llama3',
        openai: 'gpt-4o',
        groq: 'llama-3.3-70b-versatile',
        together: 'meta-llama/Llama-3-70b-chat-hf',
        mistral: 'mistral-large-latest',
        perplexity: 'sonar-pro',
        deepseek: 'deepseek-chat',
        gemini: 'gemini-2.0-flash',
        cohere: 'command-r-plus',
        azure: '',
        xai: 'grok-2',
        lmstudio: '',
        custom: ''
    };
    const m = document.getElementById('connModel');
    if (!m.value) m.value = defaults[p] || '';
}

async function saveConnection() {
    const id = parseInt(document.getElementById('connFormId').value);
    const dto = {
        name: document.getElementById('connName').value.trim(),
        provider: document.getElementById('connProvider').value,
        model: document.getElementById('connModel').value.trim(),
        baseUrl: document.getElementById('connUrl').value.trim(),
        apiKey: document.getElementById('connApiKey').value || undefined,
        isDefault: document.getElementById('connIsDefault').checked,
        isEnabled: document.getElementById('connIsEnabled').checked
    };
    if (!dto.name) { showToast('Name is required', 'error'); return; }

    try {
        const method = id > 0 ? 'PUT' : 'POST';
        const url = id > 0 ? `/api/devtools/admin/connections/${id}` : '/api/devtools/admin/connections';
        const r = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dto) });
        if (!r.ok) { const e = await r.json(); showToast(e.error || 'Failed', 'error'); return; }
        document.getElementById('connForm').style.display = 'none';
        await loadAdminConnections();
        showToast(id > 0 ? 'Connection updated' : 'Connection created', 'success');
    } catch (e) { showToast(e.message, 'error'); }
}

async function deleteConnection(id) {
    if (!confirm('Delete this LLM connection?')) return;
    await fetch(`/api/devtools/admin/connections/${id}`, { method: 'DELETE' });
    await loadAdminConnections();
    showToast('Deleted', 'success');
}

