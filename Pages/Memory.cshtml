@page
@model SkanyxxWeb.Pages.MemoryModel
@{
    ViewData["Title"] = "Memory";
}

<!-- Header Card -->
<div class="card mb-3">
    <div class="card-header">
        <div>
            <h3 class="card-title">Memory Management</h3>
            <p class="text-muted" style="margin: 4px 0 0 0; font-size: 13px;">Manage knowledge bases and memory providers for persistent context (Pinecone, Chroma, Weaviate).</p>
        </div>
        <div class="header-actions">
            <button class="btn btn-secondary" id="btnRefresh">Refresh</button>
            <button class="btn btn-primary" id="btnAddMemory">+ Add Memory Provider</button>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-3 gap-2 mb-3">
    <div class="metric-card">
        <div class="metric-icon primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 1v6m0 6v10"></path>
                <path d="m4.22 4.22 4.24 4.24m7.08 7.08 4.24 4.24"></path>
                <path d="M1 12h6m6 0h10"></path>
                <path d="m4.22 19.78 4.24-4.24m7.08-7.08 4.24-4.24"></path>
            </svg>
        </div>
        <div class="metric-content">
            <p class="metric-label">Memory Providers</p>
            <p class="metric-value" id="statTotal">0</p>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon success">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <div class="metric-content">
            <p class="metric-label">Configured</p>
            <p class="metric-value" id="statConfigured">0</p>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon info">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
        </div>
        <div class="metric-content">
            <p class="metric-label">Provider Types</p>
            <p class="metric-value" id="statTypes">0</p>
        </div>
    </div>
</div>

<!-- Memory Providers List -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Memory Providers</h3>
    </div>
    <div class="memory-grid" id="memoriesList">
        <div class="loading-state">Loading memory providers...</div>
    </div>
</div>

<!-- Add Memory Modal -->
<div class="modal" id="memoryModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="memoryModalTitle">Add Memory Provider</h3>
            <button class="btn btn-ghost" id="btnCloseMemory">&times;</button>
        </div>
        <form id="memoryForm">
            <div class="form-group">
                <label>Reference Name</label>
                <input type="text" id="memoryRef" required placeholder="my-knowledge-base" />
            </div>
            <div class="form-group">
                <label>Provider Type</label>
                <select id="memoryProvider">
                    <option value="pinecone">Pinecone</option>
                    <option value="chroma">Chroma</option>
                    <option value="weaviate">Weaviate</option>
                </select>
            </div>
            <div class="form-group">
                <label>API Key</label>
                <input type="password" id="memoryApiKey" required placeholder="Your API key" />
            </div>
            <div id="pineconeParams">
                <div class="form-group">
                    <label>Index Name</label>
                    <input type="text" id="pineconeIndex" placeholder="sre-knowledge" />
                </div>
                <div class="form-group">
                    <label>Environment</label>
                    <input type="text" id="pineconeEnvironment" placeholder="us-west1-gcp" />
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" id="btnCancelMemory">Cancel</button>
                <button type="submit" class="btn btn-primary">Create Provider</button>
            </div>
        </form>
    </div>
</div>

<style>
    /* Metric Cards */
    .metric-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
    }
    .metric-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid;
    }
    .metric-icon.primary { background: rgba(100, 108, 255, 0.15); border-color: rgba(100, 108, 255, 0.3); color: var(--accent-color); }
    .metric-icon.success { background: rgba(34, 197, 94, 0.15); border-color: rgba(34, 197, 94, 0.3); color: #22c55e; }
    .metric-icon.info { background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.3); color: #3b82f6; }
    .metric-content { flex: 1; }
    .metric-label { font-size: 12px; color: var(--text-muted); margin: 0 0 4px 0; }
    .metric-value { font-size: 28px; font-weight: 700; margin: 0; color: var(--text-primary); }

    /* Memory Grid */
    .memory-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; padding: 16px 0; }
    .memory-card {
        padding: 16px; background-color: var(--bg-tertiary); border-radius: 8px;
        border: 1px solid var(--border-color); transition: border-color 0.2s;
    }
    .memory-card:hover { border-color: var(--accent-color); }
    .memory-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
    .memory-info { display: flex; align-items: center; gap: 12px; }
    .provider-icon {
        width: 40px; height: 40px; border-radius: 8px; display: flex;
        align-items: center; justify-content: center; font-size: 20px;
    }
    .provider-icon.pinecone { background: rgba(99, 102, 241, 0.2); color: var(--accent-color); }
    .provider-icon.chroma { background: rgba(59, 130, 246, 0.2); color: #3b82f6; }
    .provider-icon.weaviate { background: rgba(34, 197, 94, 0.2); color: #22c55e; }
    .memory-name { font-weight: 500; color: var(--text-primary); }
    .memory-provider { font-size: 12px; color: var(--text-muted); }
    .memory-status { display: flex; align-items: center; gap: 6px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; }
    .status-dot.configured { background: var(--success-color); }
    .status-dot.not-configured { background: var(--warning-color); }
    .memory-details { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-color); }
    .memory-detail { display: flex; justify-content: space-between; font-size: 12px; padding: 4px 0; }
    .memory-detail-key { color: var(--text-muted); }
    .memory-detail-value { color: var(--text-secondary); font-family: monospace; overflow: hidden; text-overflow: ellipsis; max-width: 150px; }
    .memory-actions { margin-top: 12px; display: flex; gap: 8px; }

    /* Empty State */
    .loading-state { text-align: center; padding: 40px; color: var(--text-muted); grid-column: 1 / -1; }
    .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); grid-column: 1 / -1; }
    .empty-state-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.5; }

    /* Modal */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; }
    .modal.active { display: flex; }
    .modal-content { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; width: 90%; max-width: 500px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px solid var(--border-color); }
    .modal-header h3 { margin: 0; }
    #memoryForm { padding: 20px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 500; }
    .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 6px; background: var(--bg-primary); color: var(--text-primary); }
    .modal-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid var(--border-color); }
</style>

<script>
(function() {
    var memories = [];
    var providerIcons = { pinecone: '&#x1F332;', chroma: '&#x1F3A8;', weaviate: '&#x1F310;' };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    function init() {
        document.getElementById('btnAddMemory').addEventListener('click', function() { showModal(); });
        document.getElementById('btnCloseMemory').addEventListener('click', hideModal);
        document.getElementById('btnCancelMemory').addEventListener('click', hideModal);
        document.getElementById('btnRefresh').addEventListener('click', loadMemories);
        document.getElementById('memoryForm').addEventListener('submit', createMemory);
        document.getElementById('memoryProvider').addEventListener('change', toggleProviderParams);

        loadMemories();
    }

    function toggleProviderParams() {
        var provider = document.getElementById('memoryProvider').value;
        document.getElementById('pineconeParams').style.display = provider === 'pinecone' ? 'block' : 'none';
    }

    function showModal() {
        document.getElementById('memoryRef').value = '';
        document.getElementById('memoryApiKey').value = '';
        document.getElementById('pineconeIndex').value = '';
        document.getElementById('pineconeEnvironment').value = '';
        document.getElementById('memoryProvider').value = 'pinecone';
        toggleProviderParams();
        document.getElementById('memoryModal').classList.add('active');
    }

    function hideModal() {
        document.getElementById('memoryModal').classList.remove('active');
    }

    function loadMemories() {
        document.getElementById('memoriesList').innerHTML = '<div class="loading-state">Loading memory providers...</div>';

        fetch('/api/memory')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                memories = data || [];
                renderMemories();
                updateStats();
            })
            .catch(function(err) {
                console.error('Failed to load memories:', err);
                memories = [];
                renderMemories();
                updateStats();
            });
    }

    function renderMemories() {
        var container = document.getElementById('memoriesList');

        if (memories.length === 0) {
            container.innerHTML = '<div class="empty-state">' +
                '<div class="empty-state-icon">&#x1F4BE;</div>' +
                '<h3>No Memory Providers</h3>' +
                '<p>Set up memory providers to enable persistent knowledge storage for AI agents.</p>' +
                '<p style="margin-top: 12px; font-size: 12px;">Supported: Pinecone, Chroma, Weaviate</p>' +
                '</div>';
            return;
        }

        var html = '';
        memories.forEach(function(mem) {
            var provider = (mem.providerName || 'pinecone').toLowerCase();
            var isConfigured = mem.apiKeySecretRef && mem.apiKeySecretRef.length > 0;
            var statusClass = isConfigured ? 'configured' : 'not-configured';
            var statusText = isConfigured ? 'Configured' : 'Not Configured';

            html += '<div class="memory-card" data-ref="' + mem.ref + '">';
            html += '<div class="memory-header">';
            html += '<div class="memory-info">';
            html += '<div class="provider-icon ' + provider + '">' + (providerIcons[provider] || '&#x1F4BE;') + '</div>';
            html += '<div><div class="memory-name">' + (mem.ref || 'Unnamed') + '</div>';
            html += '<div class="memory-provider">' + (mem.providerName || 'Unknown Provider') + '</div></div>';
            html += '</div>';
            html += '<div class="memory-status"><span class="status-dot ' + statusClass + '"></span><span class="text-muted" style="font-size: 12px;">' + statusText + '</span></div>';
            html += '</div>';

            if (mem.memoryParams && Object.keys(mem.memoryParams).length > 0) {
                html += '<div class="memory-details">';
                Object.entries(mem.memoryParams).slice(0, 3).forEach(function(entry) {
                    html += '<div class="memory-detail">';
                    html += '<span class="memory-detail-key">' + entry[0] + '</span>';
                    html += '<span class="memory-detail-value">' + entry[1] + '</span>';
                    html += '</div>';
                });
                html += '</div>';
            }

            if (mem.apiKeySecretRef) {
                html += '<div class="memory-details">';
                html += '<div class="memory-detail">';
                html += '<span class="memory-detail-key">Secret Ref</span>';
                html += '<span class="memory-detail-value">' + mem.apiKeySecretRef + '</span>';
                html += '</div>';
                html += '</div>';
            }

            html += '<div class="memory-actions">';
            html += '<button class="btn btn-ghost btn-sm btn-delete" data-ref="' + mem.ref + '">Delete</button>';
            html += '</div>';
            html += '</div>';
        });

        container.innerHTML = html;

        container.querySelectorAll('.btn-delete').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var ref = this.getAttribute('data-ref');
                deleteMemory(ref);
            });
        });
    }

    function updateStats() {
        var providers = new Set(memories.map(function(m) { return m.providerName; }));
        var configured = memories.filter(function(m) { return m.apiKeySecretRef && m.apiKeySecretRef.length > 0; }).length;

        document.getElementById('statTotal').textContent = memories.length;
        document.getElementById('statConfigured').textContent = configured;
        document.getElementById('statTypes').textContent = providers.size;
    }

    function createMemory(e) {
        e.preventDefault();

        var provider = document.getElementById('memoryProvider').value;
        var data = {
            ref: document.getElementById('memoryRef').value,
            provider: { type: provider },
            apiKey: document.getElementById('memoryApiKey').value
        };

        if (provider === 'pinecone') {
            data.pineconeParams = {
                index: document.getElementById('pineconeIndex').value,
                environment: document.getElementById('pineconeEnvironment').value
            };
        }

        fetch('/api/memory', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
            .then(function(r) {
                if (r.ok) {
                    hideModal();
                    loadMemories();
                } else {
                    return r.json().then(function(err) { throw new Error(err.message || 'Failed to create'); });
                }
            })
            .catch(function(err) { alert('Error: ' + err.message); });
    }

    function deleteMemory(ref) {
        if (!confirm('Delete memory provider "' + ref + '"?')) return;

        var parts = ref.split('/');
        var ns = parts.length > 1 ? parts[0] : 'kagent';
        var name = parts.length > 1 ? parts[1] : ref;

        fetch('/api/memory/' + ns + '/' + name, { method: 'DELETE' })
            .then(function(r) {
                if (r.ok || r.status === 204) {
                    loadMemories();
                } else {
                    throw new Error('Failed to delete');
                }
            })
            .catch(function(err) {
                console.error(err);
                alert('Error deleting memory provider');
            });
    }
})();
</script>
