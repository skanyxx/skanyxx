@page
@model SkanyxxWeb.Pages.AnalyticsModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Analytics Dashboard</h3>
        <div class="header-actions">
            <select id="timeRange" style="width: auto;">
                <option value="24h">Last 24 hours</option>
                <option value="7d">Last 7 days</option>
                <option value="30d">Last 30 days</option>
            </select>
            <button class="btn btn-secondary" id="btnRefresh">Refresh</button>
        </div>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-value" id="statEvents">0</div>
        <div class="stat-label">Total Events</div>
        <div class="stat-change positive" id="statEventsChange">-</div>
    </div>
    <div class="stat-card">
        <div class="stat-value" id="statResponseTime">0ms</div>
        <div class="stat-label">Avg Response Time</div>
        <div class="stat-change" id="statResponseChange">-</div>
    </div>
    <div class="stat-card">
        <div class="stat-value" id="statSuccessRate">0%</div>
        <div class="stat-label">Success Rate</div>
        <div class="stat-change positive" id="statSuccessChange">-</div>
    </div>
    <div class="stat-card">
        <div class="stat-value" id="statSessions">0</div>
        <div class="stat-label">Active Sessions</div>
        <div class="stat-change" id="statSessionsChange">-</div>
    </div>
</div>

<div class="grid grid-cols-2 gap-2">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Request Volume</h3>
        </div>
        <div class="chart-placeholder">
            <div class="chart-bars" id="chartBars">
                <!-- Generated by JS -->
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Event Types</h3>
        </div>
        <div class="event-list" id="eventTypesList">
            <div class="loading-state">Loading...</div>
        </div>
    </div>
</div>

<div class="card mt-2">
    <div class="card-header">
        <h3 class="card-title">Recent Sessions</h3>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Session ID</th>
                    <th>Agent</th>
                    <th>Events</th>
                    <th>Duration</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="sessionsTable">
                <tr><td colspan="5" class="loading-state">Loading sessions...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<style>
    .chart-placeholder { height: 200px; display: flex; align-items: flex-end; padding: 20px 0; }
    .chart-bars { display: flex; align-items: flex-end; gap: 8px; width: 100%; height: 100%; }
    .chart-bar { flex: 1; background: linear-gradient(to top, var(--accent-color), rgba(100, 108, 255, 0.5)); border-radius: 4px 4px 0 0; min-height: 20px; transition: height 0.3s; }
    .event-list { display: flex; flex-direction: column; gap: 8px; }
    .event-item { display: flex; align-items: center; gap: 12px; padding: 12px; background-color: var(--bg-tertiary); border-radius: 6px; }
    .event-type { font-weight: 600; font-family: monospace; color: var(--accent-color); }
    .event-label { flex: 1; }
    .event-count { font-weight: 600; color: var(--text-muted); }
    .loading-state { text-align: center; padding: 20px; color: var(--text-muted); }
    .stat-change { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
    .stat-change.positive { color: var(--success-color); }
    .stat-change.negative { color: var(--error-color); }
</style>

<script>
(function() {
    var analytics = {};

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    function init() {
        document.getElementById('btnRefresh').addEventListener('click', loadAnalytics);
        document.getElementById('timeRange').addEventListener('change', loadAnalytics);
        loadAnalytics();
    }

    function loadAnalytics() {
        var range = document.getElementById('timeRange').value;

        fetch('/api/analytics?range=' + range)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                analytics = data || {};
                renderStats();
                renderChart();
                renderEventTypes();
                renderSessions();
            })
            .catch(function() {
                analytics = {};
                renderStats();
                renderChart();
                renderEventTypes();
                renderSessions();
            });
    }

    function renderStats() {
        document.getElementById('statEvents').textContent = formatNumber(analytics.totalEvents || 0);
        document.getElementById('statResponseTime').textContent = (analytics.avgResponseTime || 0) + 'ms';
        document.getElementById('statSuccessRate').textContent = (analytics.successRate || 0).toFixed(1) + '%';
        document.getElementById('statSessions').textContent = analytics.activeSessions || 0;

        document.getElementById('statEventsChange').textContent = analytics.eventsChange || '-';
        document.getElementById('statResponseChange').textContent = analytics.responseChange || '-';
        document.getElementById('statSuccessChange').textContent = analytics.successChange || '-';
        document.getElementById('statSessionsChange').textContent = analytics.sessionsChange || '-';
    }

    function renderChart() {
        var container = document.getElementById('chartBars');
        var data = analytics.chartData || generateRandomChart();

        var html = '';
        data.forEach(function(val) {
            html += '<div class="chart-bar" style="height: ' + val + '%;"></div>';
        });
        container.innerHTML = html;
    }

    function generateRandomChart() {
        var data = [];
        for (var i = 0; i < 12; i++) {
            data.push(Math.floor(Math.random() * 60) + 40);
        }
        return data;
    }

    function renderEventTypes() {
        var container = document.getElementById('eventTypesList');
        var types = analytics.eventTypes || [
            { type: 'session.created', label: 'Session Created', count: 0 },
            { type: 'task.completed', label: 'Task Completed', count: 0 },
            { type: 'tool.called', label: 'Tool Called', count: 0 },
            { type: 'error', label: 'Error', count: 0 }
        ];

        var html = '';
        types.forEach(function(evt) {
            html += '<div class="event-item">';
            html += '<span class="event-type">' + evt.type + '</span>';
            html += '<span class="event-label">' + evt.label + '</span>';
            html += '<span class="event-count">' + evt.count + '</span>';
            html += '</div>';
        });

        container.innerHTML = html || '<div class="loading-state">No event types</div>';
    }

    function renderSessions() {
        var container = document.getElementById('sessionsTable');
        var sessions = analytics.sessions || [];

        if (sessions.length === 0) {
            container.innerHTML = '<tr><td colspan="5" class="loading-state">No sessions found. Sessions will appear when KAgent is connected.</td></tr>';
            return;
        }

        var html = '';
        sessions.slice(0, 10).forEach(function(s) {
            var statusBadge = s.status === 'active' ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-secondary">Closed</span>';
            html += '<tr>';
            html += '<td><code>' + (s.id || '-').substring(0, 8) + '...</code></td>';
            html += '<td>' + (s.agent || '-') + '</td>';
            html += '<td>' + (s.events || 0) + '</td>';
            html += '<td>' + formatDuration(s.duration) + '</td>';
            html += '<td>' + statusBadge + '</td>';
            html += '</tr>';
        });

        container.innerHTML = html;
    }

    function formatNumber(num) {
        if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
        if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
        return num.toString();
    }

    function formatDuration(seconds) {
        if (!seconds) return '-';
        if (seconds < 60) return seconds + 's';
        if (seconds < 3600) return Math.floor(seconds / 60) + 'm';
        return Math.floor(seconds / 3600) + 'h ' + Math.floor((seconds % 3600) / 60) + 'm';
    }
})();
</script>
