@page
@model SkanyxxWeb.Pages.ToolServersModel
@{
    ViewData["Title"] = "Tool Servers";
}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">MCP Tool Servers</h3>
        <div class="header-actions">
            <button class="btn btn-secondary" id="btnRefresh">Refresh</button>
            <button class="btn btn-primary" id="btnAddServer">+ Add Server</button>
        </div>
    </div>
    <p class="text-muted">Manage Model Context Protocol servers for AI tool integration.</p>
</div>

<div class="table-container card" id="serversContainer">
    <div class="loading-state">Loading tool servers...</div>
</div>

<!-- Add Server Modal -->
<div class="modal" id="addServerModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add Tool Server</h3>
            <button class="btn btn-ghost" id="btnCloseModal">&times;</button>
        </div>
        <form id="addServerForm">
            <div class="form-group">
                <label for="serverType">Server Type</label>
                <select id="serverType" name="type" required>
                    <option value="RemoteMCPServer">Remote MCP Server</option>
                    <option value="MCPServer">Local MCP Server</option>
                </select>
            </div>
            <div class="form-group">
                <label for="serverName">Name</label>
                <input type="text" id="serverName" name="name" required placeholder="my-tool-server" pattern="[a-z0-9-]+" title="Lowercase letters, numbers, and hyphens only">
            </div>
            <div class="form-group">
                <label for="serverNamespace">Namespace</label>
                <input type="text" id="serverNamespace" name="namespace" value="kagent" required>
            </div>
            <div class="form-group">
                <label for="serverUrl">Endpoint URL</label>
                <input type="url" id="serverUrl" name="url" required placeholder="http://localhost:8080">
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" id="btnCancelModal">Cancel</button>
                <button type="submit" class="btn btn-primary">Create Server</button>
            </div>
        </form>
    </div>
</div>

<style>
    .server-name { display: flex; align-items: center; gap: 8px; font-weight: 500; }
    .tool-list { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
    .tool-tag { font-size: 11px; padding: 2px 8px; background: var(--bg-tertiary); border-radius: 4px; color: var(--text-muted); }
    .server-card { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; margin-bottom: 12px; }
    .server-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
    .server-info h4 { margin: 0 0 4px 0; font-size: 14px; }
    .server-ref { font-size: 12px; color: var(--text-muted); }
    .servers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
    .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); }
    .loading-state { text-align: center; padding: 40px; color: var(--text-muted); }
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.6); z-index: 1000; align-items: center; justify-content: center; }
    .modal.active { display: flex; }
    .modal-content { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px solid var(--border-color); }
    .modal-header h3 { margin: 0; }
    #addServerForm { padding: 20px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 500; }
    .form-group input, .form-group select { width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; background-color: var(--bg-primary); color: var(--text-primary); font-size: 14px; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 12px; padding-top: 16px; border-top: 1px solid var(--border-color); }
</style>

<script>
(function() {
    'use strict';

    var toolServers = [];

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    function init() {
        document.getElementById('btnRefresh').addEventListener('click', loadToolServers);
        document.getElementById('btnAddServer').addEventListener('click', showModal);
        document.getElementById('btnCloseModal').addEventListener('click', hideModal);
        document.getElementById('btnCancelModal').addEventListener('click', hideModal);
        document.getElementById('addServerForm').addEventListener('submit', createToolServer);

        loadToolServers();
    }

    function showModal() {
        document.getElementById('addServerForm').reset();
        document.getElementById('addServerModal').classList.add('active');
    }

    function hideModal() {
        document.getElementById('addServerModal').classList.remove('active');
    }

    function loadToolServers() {
        var container = document.getElementById('serversContainer');
        container.innerHTML = '<div class="loading-state">Loading tool servers...</div>';

        fetch('/api/toolservers')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                toolServers = data || [];
                renderToolServers();
            })
            .catch(function(err) {
                console.error('Error loading tool servers:', err);
                toolServers = [];
                renderToolServers();
            });
    }

    function renderToolServers() {
        var container = document.getElementById('serversContainer');

        if (toolServers.length === 0) {
            container.innerHTML = '<div class="empty-state"><h3>No Tool Servers</h3><p>Get started by adding your first MCP tool server.</p></div>';
            return;
        }

        var html = '<div class="servers-grid">';
        toolServers.forEach(function(server) {
            var hasTools = server.discoveredTools && server.discoveredTools.length > 0;
            var statusBadge = hasTools ? '<span class="badge badge-success">Online</span>' : '<span class="badge badge-warning">No Tools</span>';
            var toolCount = server.discoveredTools ? server.discoveredTools.length : 0;

            html += '<div class="server-card" data-ref="' + (server.ref || '') + '">';
            html += '<div class="server-header">';
            html += '<div class="server-info"><h4>' + (server.ref || server.name) + '</h4>';
            html += '<div class="server-ref">' + (server.groupKind || 'MCP Server') + '</div></div>';
            html += '<div style="display: flex; gap: 8px;">' + statusBadge;
            html += '<button class="btn btn-ghost btn-delete" data-ref="' + (server.ref || '') + '">&times;</button></div></div>';
            html += '<div style="font-size: 13px; color: var(--text-secondary);">' + toolCount + ' tools available</div>';

            if (hasTools) {
                html += '<div class="tool-list">';
                var showTools = server.discoveredTools.slice(0, 5);
                showTools.forEach(function(tool) {
                    html += '<span class="tool-tag" title="' + (tool.description || '') + '">' + tool.name + '</span>';
                });
                if (server.discoveredTools.length > 5) {
                    html += '<span class="tool-tag">+' + (server.discoveredTools.length - 5) + ' more</span>';
                }
                html += '</div>';
            }

            html += '</div>';
        });
        html += '</div>';

        container.innerHTML = html;

        container.querySelectorAll('.btn-delete').forEach(function(btn) {
            btn.addEventListener('click', function() {
                deleteToolServer(this.getAttribute('data-ref'));
            });
        });
    }

    function createToolServer(e) {
        e.preventDefault();
        var form = e.target;
        var data = {
            type: document.getElementById('serverType').value,
            remoteMCPServer: {
                name: document.getElementById('serverName').value,
                endpoint: document.getElementById('serverUrl').value
            }
        };

        fetch('/api/toolservers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(function(r) {
            if (r.ok) {
                hideModal();
                loadToolServers();
                alert('Tool server created!');
            } else {
                throw new Error('Failed to create');
            }
        })
        .catch(function(err) {
            alert('Error: ' + err.message);
        });
    }

    function deleteToolServer(ref) {
        if (!confirm('Delete this tool server?')) return;
        var parts = ref.split('/');
        var namespace = parts[0] || 'kagent';
        var name = parts[1] || ref;

        fetch('/api/toolservers/' + namespace + '/' + name, { method: 'DELETE' })
            .then(function(r) {
                if (r.ok) loadToolServers();
            })
            .catch(function(err) { console.error(err); });
    }
})();
</script>
