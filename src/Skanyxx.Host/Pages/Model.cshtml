@page
@model ModelModel
@{
    ViewData["Title"] = "Models";
}
<page-header description="Choose which AI models agents run on. API keys go straight to the cluster and are never shown again.">
    <button type="button" class="btn btn-secondary" id="refresh"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-refresh"/></svg>Refresh</button>
    @if (Model.CanWrite)
    {
        <button type="button" class="btn btn-primary" id="new-model"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"/></svg>New model</button>
    }
</page-header>
@await Component.InvokeAsync("SetupGuide", new { id = "model" })

<section id="models" data-can-write="@(Model.CanWrite ? "true" : "false")">
    <div id="default-note" class="alert alert-info" role="status" hidden></div>
    @if (!Model.CanWrite)
    {
        <alert tone="info">Only the owner adds, changes or deletes models.</alert>
    }

    <div class="card card-flush">
        <div class="table-container" id="models-table" hidden>
            <table class="table table-stack">
                <thead><tr><th scope="col">Name</th><th scope="col">Namespace</th><th scope="col">Provider</th><th scope="col">Model</th><th scope="col">API key</th><th scope="col">Status</th><th scope="col" aria-label="Actions"></th></tr></thead>
                <tbody id="model-rows"></tbody>
            </table>
        </div>
        <div id="models-state"></div>
        <div id="models-empty" hidden>
            <empty-state icon="i-cpu" title="No models in kagent yet">
                An agent runs on a model. @(Model.CanWrite ? "Add one with New model: a provider, a model id and its API key." : "The owner adds them.")
            </empty-state>
        </div>
    </div>

    <details class="details-admin mt-3">
        <summary>Details for administrators</summary>
        <p>
            Each model is a kagent ModelConfig; an agent names the one it runs on. An API key goes into the Kubernetes Secret
            kagent keeps for that model: Skanyxx does not store it. The <strong>default</strong> model (<code>KAgent:ModelConfig</code>)
            is the one the seed agents and Chat use.
        </p>
    </details>

    <dialog class="dialog dialog-side" id="detail-dialog" aria-labelledby="detail-title">
        <div class="dialog-header">
            <div>
                <h2 class="dialog-title" id="detail-title">Model</h2>
                <p class="dialog-subtitle"><code id="detail-name"></code></p>
            </div>
            <button type="button" class="btn btn-ghost btn-icon" id="detail-close" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x"/></svg></button>
        </div>
        <div class="dialog-body"><dl id="detail-fields" class="kv"></dl></div>
    </dialog>

    @if (Model.CanWrite)
    {
        <dialog class="dialog dialog-side" id="form-card" aria-labelledby="form-title">
            <form id="model-form" class="dialog-form" novalidate>
                <div class="dialog-header">
                    <h2 class="dialog-title" id="form-title">New model</h2>
                    <button type="button" class="btn btn-ghost btn-icon" data-dialog-close aria-label="Close"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x"/></svg></button>
                </div>
                <div class="dialog-body">
                    <div class="alert alert-error" role="alert" id="f-error" hidden></div>
                    <div class="form-row">
                        <div class="field">
                            <label for="f-namespace">Namespace</label>
                            @* Browsers compile pattern with the v flag, where a literal "-" in a class must be escaped. *@
                            <input id="f-namespace" required maxlength="63" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off" aria-describedby="f-namespace-hint" />
                            <p class="field-hint" id="f-namespace-hint">Agents use the models of their own namespace.</p>
                        </div>
                        <div class="field">
                            <label for="f-name">Name</label>
                            <input id="f-name" required maxlength="63" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off" aria-describedby="f-name-hint" />
                            <p class="field-hint" id="f-name-hint">Lowercase letters, digits and <code>-</code>.</p>
                        </div>
                    </div>
                    <div class="field">
                        <label for="f-provider">Provider</label>
                        <select id="f-provider" required></select>
                    </div>
                    <div class="field">
                        <label for="f-model">Model</label>
                        <input id="f-model" list="f-models" required maxlength="200" autocomplete="off" spellcheck="false" aria-describedby="f-model-hint" />
                        <datalist id="f-models"></datalist>
                        <p class="field-hint" id="f-model-hint">Pick one kagent knows, or type any model id.</p>
                    </div>
                    <fieldset class="form-section">
                        <legend>Provider settings</legend>
                        <p class="form-section-hint">* required; leave the others empty for the provider's default.</p>
                        <div id="f-params" class="field-grid"></div>
                    </fieldset>
                    <p id="f-kept" class="field-hint" hidden></p>
                    <div id="f-key" class="field">
                        <label for="f-apikey">API key</label>
                        @* Never rendered back: the value is always empty; leaving it empty keeps the stored key (same provider). *@
                        @* new-password: browsers and password managers must not fill the owner's sign-in password in here. *@
                        <input name="ApiKey" id="f-apikey" type="password" value="" maxlength="4096" autocomplete="new-password" spellcheck="false"
                               data-1p-ignore data-lpignore="true" data-form-type="other" />
                        <label class="check"><input type="checkbox" id="f-nokey" /> No API key (a gateway in front of the provider adds it)</label>
                    </div>
                    <p id="f-nokey-needed" class="field-hint" hidden>This provider takes no API key.</p>
                </div>
                <div class="dialog-footer">
                    <button type="button" class="btn btn-secondary" id="f-cancel">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="f-save">Save</button>
                </div>
            </form>
        </dialog>
    }
</section>

<script>
(() => {
    const root = document.getElementById('models');
    const canWrite = root.dataset.canWrite === 'true';
    const base = '/api/models';
    const table = document.getElementById('models-table');
    const listState = document.getElementById('models-state');
    let loaded = false;
    let defaultRef = null;
    let options = null;
    let editing = null;

    // Values from the API are only ever set with textContent.
    const say = (box, text) => { box.textContent = text; box.hidden = !text; };
    const fail = text => skx.toast(text, { tone: 'error' });
    const done = text => skx.toast(text);
    const path = (ns, name) => `${base}/${encodeURIComponent(ns)}/${encodeURIComponent(name)}`;
    const el = (tag, text, cls) => { const e = document.createElement(tag); if (text !== undefined) e.textContent = text; if (cls) e.className = cls; return e; };

    // The shared client (js/ui.js): the error carries the status and the problem body.
    const call = (method, url, body) => skx.api(method, url, body);

    function button(label, name, action, cls = 'btn btn-ghost btn-sm') {
        const b = el('button', label, cls);
        b.type = 'button';
        b.setAttribute('aria-label', `${label} ${name}`);
        b.addEventListener('click', action);
        return b;
    }

    function cell(row, text) { const td = el('td', text); row.appendChild(td); return td; }

    const keyText = m => m.provider === 'Ollama' ? 'not needed' : (m.hasApiKey ? 'key set' : 'no key');
    const statusText = m => m.accepted ? 'Ready' : `Not accepted${m.statusMessage ? ` (${m.statusMessage})` : ''}`;
    const statusBadge = m => skx.badge(m.accepted ? 'ready' : 'pending', statusText(m));

    function defaultNote(models) {
        const note = document.getElementById('default-note');
        const current = models.find(m => m.isDefault);
        note.replaceChildren();
        if (!current) {
            note.append(`The default model ${defaultRef} does not exist yet: Chat cannot answer until it does. `);
            if (canWrite) {
                const [ns, ...rest] = defaultRef.split('/');
                note.appendChild(button('Create the default model', defaultRef,
                    () => openForm(null, { namespace: ns, name: rest.join('/') }).catch(e => fail(e.message)), 'btn btn-primary'));
            }
        } else if (!current.accepted) {
            note.append(`kagent has not accepted the default model ${defaultRef}${current.statusMessage ? ` (${current.statusMessage})` : ''}.`);
        } else {
            note.append(`The default model ${defaultRef} is ready. `);
            const chat = el('a', 'Continue to Chat', 'btn btn-secondary');
            chat.href = '/Chat';
            note.appendChild(chat);
        }
        note.hidden = false;
    }

    async function load() {
        if (!loaded) skx.state.loading(listState, { rows: 3 });
        try {
            const list = await call('GET', base);
            loaded = true;
            listState.replaceChildren();
            defaultRef = list.defaultRef;
            const body = document.getElementById('model-rows');
            body.replaceChildren();
            for (const m of list.models) {
                const row = document.createElement('tr');
                row.dataset.model = m.ref;
                const name = cell(row, '');
                const names = el('span', undefined, 'badges');
                names.append(m.name);
                if (m.isDefault) names.appendChild(el('span', 'default', 'badge badge-accent'));
                name.appendChild(names);
                cell(row, m.namespace);
                cell(row, m.provider);
                cell(row, m.model);
                cell(row, keyText(m));
                cell(row, '').appendChild(statusBadge(m));
                const actions = el('div', undefined, 'row-actions');
                cell(row, '').appendChild(actions);
                actions.appendChild(button('Details', m.ref, () => details(m)));
                if (canWrite) actions.appendChild(button('Edit', m.ref, () => edit(m.namespace, m.name)));
                if (canWrite && !m.isDefault) actions.appendChild(button('Delete', m.ref, () => remove(m), 'btn btn-danger-ghost btn-sm'));
                body.appendChild(row);
            }
            document.getElementById('models-empty').hidden = list.models.length > 0;
            table.hidden = list.models.length === 0;
            defaultNote(list.models);
        } catch (e) {
            // A failed refresh keeps the list it had; only a first load that fails says so in its place.
            if (loaded) return fail(`The models could not be refreshed: ${e.message}`);
            table.hidden = true;
            document.getElementById('models-empty').hidden = true;
            skx.state.error(listState, { title: 'The models could not be loaded', detail: e.message, retry: load });
        }
    }

    function details(m) {
        document.getElementById('detail-name').textContent = m.ref;
        const fields = document.getElementById('detail-fields');
        fields.replaceChildren();
        const add = (label, value) => { if (value) fields.append(el('dt', label), el('dd', value)); };
        add('Default', m.isDefault ? 'yes: the seed agents and Chat use it' : '');
        add('Provider', m.provider);
        add('Model', m.model);
        add('API key', keyText(m));
        add('Status', statusText(m));
        for (const [key, value] of Object.entries(m.params)) add(key, value);
        add('Also set (kept as it is)', m.kept.join(', '));
        document.getElementById('detail-dialog').showModal();
    }

    async function remove(m) {
        if (!await skx.confirm({ title: `Delete ${m.ref}?`, body: 'kagent removes it and its API key; this cannot be undone.', confirm: 'Delete', danger: true })) return;
        try {
            try {
                await call('DELETE', path(m.namespace, m.name));
            } catch (e) {
                // Agents still use it: the answer lists them, and the owner decides again.
                if (e.status !== 409 || e.data?.reason !== 'in_use'
                    || !await skx.confirm({ title: `${m.ref} is in use`, body: e.message, confirm: 'Delete anyway', danger: true })) throw e;
                await call('DELETE', `${path(m.namespace, m.name)}?confirm=true`);
            }
            done(`${m.ref} deleted.`);
            document.getElementById('detail-dialog').close();
            await load();
        } catch (e) {
            fail(e.message);
        }
    }

    document.getElementById('refresh').addEventListener('click', load);

    if (!canWrite) {
        load();
        return;
    }

    const form = {
        namespace: document.getElementById('f-namespace'),
        name: document.getElementById('f-name'),
        provider: document.getElementById('f-provider'),
        model: document.getElementById('f-model'),
        apiKey: document.getElementById('f-apikey'),
        noKey: document.getElementById('f-nokey')
    };

    async function loadOptions() {
        options ??= await call('GET', `${base}/options`);
        return options;
    }

    const providerOf = type => options.providers.find(p => p.type === type);

    function showProvider(values) {
        const provider = providerOf(form.provider.value);
        document.getElementById('f-models').replaceChildren(...provider.models.map(m => { const o = document.createElement('option'); o.value = m; return o; }));
        const params = document.getElementById('f-params');
        params.replaceChildren();
        for (const field of provider.fields) {
            const id = `f-param-${field.key}`;
            const label = el('label', `${field.key}${field.required ? ' *' : ''}`, 'field-label');
            label.htmlFor = id;
            let input;
            if (field.kind === 'boolean') {
                input = document.createElement('select');
                for (const v of ['', 'true', 'false']) { const o = el('option', v || '(default)'); o.value = v; input.appendChild(o); }
            } else {
                input = document.createElement('input');
                if (field.kind === 'integer') { input.inputMode = 'numeric'; input.pattern = '[0-9]*'; }
                input.autocomplete = 'off';
                input.spellcheck = false;
            }
            input.id = id;
            input.dataset.key = field.key;
            input.required = field.required;
            input.value = values[field.key] ?? '';
            params.append(label, input);
        }
        document.getElementById('f-key').hidden = !provider.takesKey;
        document.getElementById('f-nokey-needed').hidden = provider.takesKey;
        // A stored key is kept only for the same provider: a switch needs a new one.
        const keeps = editing?.hasApiKey && editing.provider === provider.type;
        form.apiKey.placeholder = keeps ? 'set — leave empty to keep it' : 'paste the key';
        form.noKey.checked = !!editing && editing.provider === provider.type && !editing.hasApiKey;
    }

    const formDialog = document.getElementById('form-card');
    const formError = text => say(document.getElementById('f-error'), text);

    async function openForm(model, preset) {
        const o = await loadOptions();
        if (model && !providerOf(model.provider)) {
            fail(`kagent does not offer the provider ${model.provider}; edit ${model.ref} where it was made.`);
            return;
        }
        editing = model;
        document.getElementById('form-title').textContent = model ? `Edit ${model.ref}` : 'New model';
        form.namespace.value = model?.namespace ?? preset?.namespace ?? o.namespace;
        form.name.value = model?.name ?? preset?.name ?? '';
        form.namespace.readOnly = form.name.readOnly = !!model || !!preset;
        form.provider.replaceChildren(...o.providers.map(p => { const op = el('option', p.type); op.value = p.type; return op; }));
        form.provider.value = model?.provider ?? o.providers[0].type;
        form.model.value = model?.model ?? '';
        form.apiKey.value = '';
        showProvider(model?.params ?? {});
        say(document.getElementById('f-kept'), model?.kept.length ? `Also set and kept as it is: ${model.kept.join(', ')}.` : '');
        formError('');
        formDialog.showModal();
        (form.namespace.readOnly ? form.model : form.namespace).focus();
    }

    async function edit(ns, name) {
        try {
            await openForm(await call('GET', path(ns, name)));
        } catch (e) {
            fail(e.message);
        }
    }

    form.provider.addEventListener('change', () => showProvider(editing?.provider === form.provider.value ? editing.params : {}));
    form.noKey.addEventListener('change', () => { if (form.noKey.checked) form.apiKey.value = ''; });
    document.getElementById('new-model').addEventListener('click', () => openForm(null).catch(e => fail(e.message)));
    // However the dialog closes (Cancel, Escape, the close button), a typed key leaves with it.
    formDialog.addEventListener('close', () => { form.apiKey.value = ''; });
    document.getElementById('f-cancel').addEventListener('click', () => formDialog.close());
    document.getElementById('model-form').addEventListener('submit', async event => {
        event.preventDefault();
        const takesKey = providerOf(form.provider.value).takesKey;
        const body = {
            namespace: form.namespace.value.trim(),
            name: form.name.value.trim(),
            provider: form.provider.value,
            model: form.model.value.trim(),
            params: Object.fromEntries([...document.querySelectorAll('#f-params [data-key]')].map(i => [i.dataset.key, i.value.trim()])),
            apiKey: takesKey && !form.noKey.checked ? form.apiKey.value.trim() || null : null,
            noApiKey: takesKey && form.noKey.checked
        };
        const model = document.getElementById('model-form');
        if (!model.reportValidity()) return;
        const save = document.getElementById('f-save');
        save.setAttribute('aria-busy', 'true');
        save.disabled = true;
        try {
            if (editing) await call('PUT', path(editing.namespace, editing.name), body);
            else await call('POST', base, body);
            form.apiKey.value = '';
            done(`${body.namespace}/${body.name} ${editing ? 'saved' : 'created'}.`);
            formDialog.close();
            await load();
        } catch (e) {
            formError(e.message);
        } finally {
            save.removeAttribute('aria-busy');
            save.disabled = false;
        }
    });

    load();
})();
</script>
