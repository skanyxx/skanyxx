@page
@model SetupGuidesModel
@{
    ViewData["Title"] = "Setup guides";
}
<page-header description="How to make each part of Skanyxx work, for a local run and for the Helm chart. A guide opens by itself when this install is missing a setting it needs." />
<p class="field-hint mb-2">"Copy instructions for agent" copies a ready prompt for an AI coding agent: setting names and steps only, never a secret value.</p>
@foreach (var guide in Model.Guides)
{
    @await Component.InvokeAsync("SetupGuide", new { id = guide.Id, whenReady = true })
}
