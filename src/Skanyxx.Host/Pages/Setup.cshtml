@page
@model SetupModel
@{
    ViewData["Title"] = "Create the owner account";
    Layout = "_AuthLayout";
}
<ol class="steps mt-2">
    <li class="step" data-state="current"><div><div class="step-title">Create the owner account</div><div class="step-body">It runs this installation and can only be created once.</div></div></li>
    <li class="step"><div><div class="step-title">Choose a model</div><div class="step-body">Next, Skanyxx asks which AI model answers in Chat.</div></div></li>
</ol>
<form method="post" class="form auth-form" data-once>
    @if (Model.Error is not null)
    {
        <alert tone="error">@Model.Error</alert>
    }
    <div class="field">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="username" required autofocus />
    </div>
    <div class="field">
        <label asp-for="DisplayName">Display name <span class="field-optional">(optional)</span></label>
        <input asp-for="DisplayName" autocomplete="name" />
    </div>
    <div class="field">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" autocomplete="new-password" required minlength="12" aria-describedby="Password-hint" />
        <p class="field-hint" id="Password-hint">At least 12 characters.</p>
    </div>
    <div class="field">
        <label asp-for="BootstrapToken">Bootstrap token</label>
        <input asp-for="BootstrapToken" type="password" autocomplete="off" aria-describedby="BootstrapToken-hint" />
        <p class="field-hint" id="BootstrapToken-hint">The token from the install output (<code>Identity:BootstrapToken</code>); required outside Development.</p>
    </div>
    <button type="submit" class="btn btn-primary">Create owner and sign in</button>
</form>
