@page
@model DebugModel
@{
    ViewData["Title"] = "Debug";
}
<div class="card mb-3">
    <p>Skanyxx <code>@Model.Version</code>, Host mode <code>@Model.Mode</code></p>
</div>
<div class="table-container card mb-3">
    <table>
        <thead>
            <tr><th>Check</th><th>Status</th><th>Detail</th><th>Took</th></tr>
        </thead>
        <tbody>
            @foreach (var (name, entry) in Model.Health.Entries)
            {
                <tr>
                    <td>@name</td>
                    <td>@entry.Status</td>
                    <td>@(entry.Description ?? entry.Exception?.Message)</td>
                    <td>@((int)entry.Duration.TotalMilliseconds) ms</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="table-container card">
    <table>
        <thead>
            <tr><th>Module</th><th>Id</th><th>Version</th><th>Needs</th></tr>
        </thead>
        <tbody>
            @foreach (var module in Model.Modules)
            {
                <tr>
                    <td>@module.DisplayName</td>
                    <td><code>@module.ModuleId</code></td>
                    <td>@module.Version</td>
                    <td>@string.Join(", ", module.Dependencies)</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Disabled.Count > 0)
    {
        <p class="text-muted">Disabled by configuration: @string.Join(", ", Model.Disabled)</p>
    }
</div>
