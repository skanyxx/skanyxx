@page
@model Skanyxx.Host.Pages.DebugModel
@{
    ViewData["Title"] = "Debug";
}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Debug Console</h3>
        <div class="header-actions">
            <button class="btn btn-secondary" id="btnClearLogs">Clear Logs</button>
            <button class="btn btn-primary" id="btnExportLogs">Export</button>
        </div>
    </div>
</div>

<div class="grid grid-cols-2 gap-2">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">System Logs</h3>
            <select style="width: auto;" id="logLevelFilter">
                <option value="all">All Levels</option>
                <option value="error">Error</option>
                <option value="warning">Warning</option>
                <option value="info">Info</option>
                <option value="debug">Debug</option>
            </select>
        </div>
        <div class="log-container" id="logContainer">
            <div class="loading-state">Loading logs...</div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Quick Commands</h3>
        </div>
        <div class="command-input-container">
            <input type="text" placeholder="Enter kubectl command (e.g., get pods -n default)" id="commandInput" />
            <button class="btn btn-primary" id="btnRunCommand">Run</button>
        </div>
        <div class="command-output" id="commandOutput">
            <pre>Enter a kubectl command above to execute it against your cluster.</pre>
        </div>
    </div>
</div>

<div class="card mt-2">
    <div class="card-header">
        <h3 class="card-title">System Information</h3>
        <button class="btn btn-ghost" id="btnRefreshSysInfo">Refresh</button>
    </div>
    <div class="system-info-grid" id="systemInfoGrid">
        <div class="loading-state">Loading system info...</div>
    </div>
</div>

<script>
(function() {
    var startTime = Date.now();
    var logs = [];
    var autoRefreshInterval;

    document.addEventListener('DOMContentLoaded', function() {
        loadSystemInfo();
        loadLogs();
        setupEventListeners();

        // Auto-refresh logs every 10 seconds
        autoRefreshInterval = setInterval(loadLogs, 10000);
    });

    function setupEventListeners() {
        document.getElementById('btnRefreshSysInfo').addEventListener('click', loadSystemInfo);
        document.getElementById('btnClearLogs').addEventListener('click', clearLogs);
        document.getElementById('btnExportLogs').addEventListener('click', exportLogs);
        document.getElementById('logLevelFilter').addEventListener('change', renderLogs);
        document.getElementById('btnRunCommand').addEventListener('click', runCommand);
        document.getElementById('commandInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') runCommand();
        });
    }

    function loadLogs() {
        fetch('/api/debug/logs')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                logs = data || [];
                renderLogs();
            })
            .catch(function(err) {
                // Show error state, not mock data
                logs = [];
                var container = document.getElementById('logContainer');
                container.innerHTML = '<div class="empty-state text-error">Failed to load logs: ' + err.message + '</div>';
            });
    }

    function renderLogs() {
        var container = document.getElementById('logContainer');
        var filter = document.getElementById('logLevelFilter').value;

        var filteredLogs = filter === 'all'
            ? logs
            : logs.filter(function(l) { return l.level === filter; });

        if (filteredLogs.length === 0) {
            container.innerHTML = '<div class="empty-state">No logs to display. Logs will appear as events occur.</div>';
            return;
        }

        var html = '';
        filteredLogs.forEach(function(log) {
            var levelClass = log.level || 'info';
            html += '<div class="log-entry ' + levelClass + '">';
            html += '<span class="log-time">' + (log.time || '-') + '</span>';
            html += '<span class="log-level">' + (log.level || 'INFO').toUpperCase() + '</span>';
            html += '<span class="log-message">' + escapeHtml(log.message || '') + '</span>';
            html += '</div>';
        });
        container.innerHTML = html;
    }

    function clearLogs() {
        logs = [];
        renderLogs();
        addLog('info', 'Logs cleared');
    }

    function exportLogs() {
        var content = logs.map(function(l) {
            return '[' + l.time + '] ' + l.level.toUpperCase() + ': ' + l.message;
        }).join('\n');

        var blob = new Blob([content], { type: 'text/plain' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'skanyxx-logs-' + new Date().toISOString().split('T')[0] + '.txt';
        a.click();
        URL.revokeObjectURL(url);

        addLog('info', 'Logs exported');
    }

    function addLog(level, message) {
        logs.unshift({ level: level, time: formatTime(new Date()), message: message });
        if (logs.length > 100) logs.pop();
        renderLogs();
    }

    function runCommand() {
        var input = document.getElementById('commandInput');
        var output = document.getElementById('commandOutput');
        var command = input.value.trim();

        if (!command) {
            output.innerHTML = '<pre class="text-warning">Please enter a command</pre>';
            return;
        }

        output.innerHTML = '<pre>Running: kubectl ' + escapeHtml(command) + '...</pre>';
        addLog('debug', 'Executing command: kubectl ' + command);

        fetch('/api/kubernetes/execute', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ command: command })
        })
            .then(function(r) { return r.json(); })
            .then(function(result) {
                if (result.success) {
                    output.innerHTML = '<pre>$ kubectl ' + escapeHtml(command) + '\n' + escapeHtml(result.output || 'Command completed successfully') + '</pre>';
                    addLog('info', 'Command completed: kubectl ' + command);
                } else {
                    output.innerHTML = '<pre class="text-error">$ kubectl ' + escapeHtml(command) + '\n' + escapeHtml(result.error || 'Command failed') + '</pre>';
                    addLog('error', 'Command failed: ' + (result.error || 'Unknown error'));
                }
            })
            .catch(function(err) {
                output.innerHTML = '<pre class="text-error">$ kubectl ' + escapeHtml(command) + '\n\nError: ' + err.message + '\n\nNote: kubectl must be installed and configured on the server.</pre>';
                addLog('error', 'Command execution failed: ' + err.message);
            });
    }

    function loadSystemInfo() {
        fetch('/api/settings/system-info')
            .then(function(r) { return r.json(); })
            .then(function(info) {
                var uptime = Math.floor((Date.now() - startTime) / 1000);
                var uptimeStr = formatUptime(uptime);

                document.getElementById('systemInfoGrid').innerHTML =
                    '<div class="info-item"><span class="info-label">Platform</span><span class="info-value">' + (info.platform || 'Unknown') + '</span></div>' +
                    '<div class="info-item"><span class="info-label">Environment</span><span class="info-value">' + (info.environment || 'Development') + '</span></div>' +
                    '<div class="info-item"><span class="info-label">Memory Usage</span><span class="info-value">' + (info.memoryUsage || 'N/A') + '</span></div>' +
                    '<div class="info-item"><span class="info-label">Database</span><span class="info-value">' + (info.database || 'SQLite') + '</span></div>' +
                    '<div class="info-item"><span class="info-label">Session Time</span><span class="info-value">' + uptimeStr + '</span></div>' +
                    '<div class="info-item"><span class="info-label">Version</span><span class="info-value">' + (info.version || '1.0.0') + '</span></div>';
            })
            .catch(function(err) {
                document.getElementById('systemInfoGrid').innerHTML = '<div class="info-item"><span class="info-value text-error">Failed to load system info</span></div>';
            });
    }

    function formatTime(date) {
        return date.toTimeString().split(' ')[0].slice(0, 8);
    }

    function formatUptime(seconds) {
        if (seconds < 60) return seconds + 's';
        if (seconds < 3600) return Math.floor(seconds / 60) + 'm ' + (seconds % 60) + 's';
        var h = Math.floor(seconds / 3600);
        var m = Math.floor((seconds % 3600) / 60);
        return h + 'h ' + m + 'm';
    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
})();
</script>

<style>
    .log-container {
        background-color: var(--bg-primary);
        border-radius: 6px;
        padding: 12px;
        max-height: 300px;
        overflow-y: auto;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
    }

    .log-entry {
        display: flex;
        gap: 12px;
        padding: 6px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .log-entry:last-child {
        border-bottom: none;
    }

    .log-time {
        color: var(--text-muted);
    }

    .log-level {
        font-weight: 600;
        width: 50px;
    }

    .log-entry.error .log-level { color: var(--error-color); }
    .log-entry.warning .log-level { color: var(--warning-color); }
    .log-entry.info .log-level { color: var(--accent-color); }
    .log-entry.debug .log-level { color: var(--text-muted); }

    .log-message {
        flex: 1;
        word-break: break-word;
    }

    .command-input-container {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
    }

    .command-input-container input {
        flex: 1;
    }

    .command-output {
        background-color: var(--bg-primary);
        border-radius: 6px;
        padding: 16px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 12px;
        max-height: 200px;
        overflow-y: auto;
    }

    .command-output pre {
        margin: 0;
        white-space: pre-wrap;
    }

    .system-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .info-label {
        font-size: 12px;
        color: var(--text-muted);
    }

    .info-value {
        font-weight: 500;
    }

    .empty-state {
        text-align: center;
        padding: 20px;
        color: var(--text-muted);
    }

    .text-error {
        color: var(--error-color);
    }

    .text-warning {
        color: var(--warning-color);
    }
</style>
