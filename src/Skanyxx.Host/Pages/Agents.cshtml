@page
@model AgentsModel
@{
    ViewData["Title"] = "Agents";
}
<page-header description="The assistants people chat with. Open one to see what it can do, or make a new one.">
    <button type="button" class="btn btn-secondary" id="refresh"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-refresh"/></svg>Refresh</button>
    <button type="button" class="btn btn-primary" id="new-agent">@(Model.CanWrite ? "New agent" : "Propose an agent")</button>
</page-header>

<section id="agents" data-can-write="@(Model.CanWrite ? "true" : "false")" data-can-propose-changes="@(Model.CanProposeChanges ? "true" : "false")">
    <div id="guides"></div>
    @if (!Model.CanWrite)
    {
        <alert tone="info">You cannot change a live agent: the form sends your agent to a supervisor as a Studio proposal.</alert>
    }

    @* ---------- List (kagent-ui: /agents) ---------- *@
    <div id="list-view">
        <div class="toolbar" role="search">
            <div class="search">
                <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-search"/></svg>
                <input id="search" type="search" placeholder="Search agents" aria-label="Search agents" autocomplete="off" />
            </div>
            <select id="filter-type" aria-label="Filter by type">
                <option value="">All types</option>
                <option value="Declarative">Declarative</option>
                <option value="BYO">BYO</option>
            </select>
            <select id="filter-status" aria-label="Filter by status">
                <option value="">Any status</option>
                <option value="ready">Ready</option>
                <option value="starting">Starting</option>
                <option value="not-ready">Not ready</option>
                <option value="suspended">Suspended</option>
            </select>
            <span class="spacer"></span>
            <span id="agent-count" class="text-muted text-sm" role="status" aria-live="polite"></span>
        </div>
        <div id="agent-grid" class="card-grid" aria-label="Agents"></div>
        <p class="field-hint mt-2">Agents made in Studio change only through a Studio proposal, and Skanyxx's own agents (the seed, the factory) cannot be changed here.</p>
    </div>

    @* ---------- Details (kagent-ui: agent page) ---------- *@
    <div id="detail-view" hidden>
        <div class="card">
            <div class="card-header">
                <div>
                    <button type="button" class="btn btn-ghost btn-sm" id="detail-back"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-arrow-left"/></svg>All agents</button>
                    <h2 class="card-title mt-1"><span id="detail-name"></span> <span id="detail-ns" class="text-muted"></span></h2>
                </div>
                <span id="detail-badges" class="badges"></span>
            </div>
            <p id="detail-description"></p>
            <p id="detail-protection" class="field-hint" hidden></p>
            <div id="detail-actions" class="form-actions mt-2"></div>
        </div>
        <div class="card-grid wide">
            <div class="card" id="d-prompt-card"><h3 class="section-title mb-1">System message</h3><pre id="d-prompt" class="text-block"></pre></div>
            <div class="card"><h3 class="section-title mb-1">Model</h3><dl id="d-model" class="kv"></dl></div>
            <div class="card"><h3 class="section-title mb-1">Tools</h3><div id="d-tools"></div></div>
            <div class="card"><h3 class="section-title mb-1">Skills</h3><div id="d-skills"></div></div>
            <div class="card"><h3 class="section-title mb-1">Memory</h3><div id="d-memory"></div></div>
            <div class="card"><h3 class="section-title mb-1">A2A skills</h3><div id="d-a2a"></div></div>
            <div class="card"><h3 class="section-title mb-1">Deployment</h3><dl id="d-deployment" class="kv"></dl></div>
            <div class="card"><h3 class="section-title mb-1">Recent sessions</h3><div id="d-sessions"></div></div>
        </div>
    </div>

    @* ---------- Create / edit / propose (kagent-ui: /agents/new) ---------- *@
    <div id="form-view" hidden>
        <form id="agent-form" class="form" novalidate>
            <div>
                <button type="button" class="btn btn-ghost btn-sm" id="f-back"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-arrow-left"/></svg>All agents</button>
                <h2 class="section-title mt-1" id="form-title">New agent</h2>
                <p id="f-mode-note" class="section-description" hidden>
                    You cannot change a live agent, so this form opens a Studio proposal: a supervisor reviews it, and it is live only once merged.
                </p>
            </div>
            <div class="alert alert-error" role="alert" data-error-box hidden>
                <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-alert-circle"/></svg>
                <div class="alert-body field-error-text" data-error="form"></div>
            </div>

            <fieldset class="form-section">
                <legend>Basic information</legend>
                <div class="field">
                    <label for="f-name">Agent name</label>
                    @* Browsers compile pattern with the v flag, where a literal "-" in a class must be escaped. *@
                    <input id="f-name" required maxlength="63" pattern="[a-z]([a-z0-9\-]*[a-z0-9])?" autocomplete="off" aria-describedby="f-name-hint" />
                    <p class="field-hint" id="f-name-hint">Lowercase letters, digits and <code>-</code>, starting with a letter.</p>
                    <p class="field-error" data-error="name" hidden></p>
                </div>
                <div class="field">
                    <label for="f-namespace">Namespace</label>
                    <input id="f-namespace" readonly />
                    <p class="field-error" data-error="namespace" hidden></p>
                </div>
                <div class="field">
                    <label for="f-description">Description <span class="field-optional">(one line)</span></label>
                    <input id="f-description" maxlength="500" autocomplete="off" />
                    <p class="field-error" data-error="description" hidden></p>
                </div>
                <div class="field" role="radiogroup" aria-labelledby="f-type-label">
                    <span class="field-label" id="f-type-label">Agent type</span>
                    <div class="checks">
                        <label class="check"><input type="radio" name="f-type" value="Declarative" checked /> Declarative</label>
                        <label class="check"><input type="radio" name="f-type" value="BYO" disabled /> BYO (bring your own container)</label>
                    </div>
                    <p class="field-hint">BYO agents are deployed where they were made (their image is never set here); Skanyxx creates and edits Declarative agents.</p>
                </div>
            </fieldset>

            <fieldset class="form-section">
                <legend>System message</legend>
                <p class="form-section-hint">The agent's job, its tone, and what it must not do.</p>
                <textarea id="f-prompt" rows="14" required maxlength="16000" spellcheck="true" aria-label="System message" aria-describedby="f-prompt-count"></textarea>
                <p class="field-hint" id="f-prompt-count"></p>
                <p class="field-error" data-error="systemMessage" hidden></p>
            </fieldset>

            <fieldset class="form-section">
                <legend>Model</legend>
                <select id="f-model" required aria-label="Model"></select>
                <p id="f-model-empty" class="field-hint" hidden>No model is set up in this namespace yet: see the guide above, or ask the owner to add one on Models.</p>
                <p class="field-error" data-error="modelConfig" hidden></p>
            </fieldset>

            <fieldset class="form-section">
                <legend>Tools &amp; agents</legend>
                <p class="form-section-hint">Pick the tools the agent may call, from the tool servers the owner allowed.</p>
                <div id="f-mcp"></div>
                <p id="f-mcp-empty" class="field-hint" hidden>No tool servers are allowed for agents yet (Studio:McpServers).</p>
                <p class="field-error" data-error="mcpTools" hidden></p>
                <div id="f-agents-box" class="field">
                    <span class="field-label">Agents as tools</span>
                    <div id="f-agents" class="check-list"></div>
                    <p id="f-agents-empty" class="field-hint" hidden>No other agent can be called as a tool.</p>
                </div>
                <p id="f-agents-off" class="field-hint" hidden>Studio agents do not call other agents as tools.</p>
                <p class="field-error" data-error="agentTools" hidden></p>
            </fieldset>

            <details class="details-admin" id="f-advanced">
                <summary>Advanced: skills, memory, A2A and deployment</summary>
                <div class="stack">
                    <fieldset class="form-section">
                        <legend>Skills</legend>
                        <div class="field">
                            <label for="f-skills">Skill images</label>
                            <textarea id="f-skills" rows="2" spellcheck="false" aria-describedby="f-skills-hint"></textarea>
                            <p class="field-hint" id="f-skills-hint">OCI images pinned by digest, one per line.</p>
                        </div>
                        <p id="f-skills-off" class="field-hint" hidden>Skills are off: the owner has not allow-listed a registry (Studio:SkillRegistries).</p>
                        <p class="field-error" data-error="skills" hidden></p>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend>Memory</legend>
                        <label class="check"><input type="checkbox" id="f-memory-on" /> Give the agent kagent memory (what it learns in chats, kept per agent)</label>
                        <div id="f-memory-box" class="form-row" hidden>
                            <div class="field">
                                <label for="f-memory-model">Embedding model</label>
                                <select id="f-memory-model"></select>
                            </div>
                            <div class="field">
                                <label for="f-memory-ttl">Keep entries (days, 1–365)</label>
                                <input id="f-memory-ttl" type="number" min="1" max="365" value="15" />
                            </div>
                        </div>
                        <p class="field-hint">Company knowledge belongs in memory cards (Library), not here.</p>
                        <p class="field-error" data-error="memory" hidden></p>
                    </fieldset>

                    <fieldset class="form-section" id="f-a2a-section">
                        <legend>A2A skills</legend>
                        <p class="form-section-hint">What the agent's A2A card advertises to other agents.</p>
                        <div id="f-a2a"></div>
                        <div><button type="button" class="btn btn-secondary btn-sm" id="f-a2a-add"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"/></svg>Add A2A skill</button></div>
                        <p class="field-error" data-error="a2aSkills" hidden></p>
                    </fieldset>

                    <fieldset class="form-section" id="f-deploy-section">
                        <legend>Deployment</legend>
                        <div class="field">
                            <label for="f-runtime">Runtime</label>
                            <select id="f-runtime">
                                <option value="">kagent's default</option>
                                <option value="go">go</option>
                                <option value="python">python</option>
                            </select>
                        </div>
                        <label class="check"><input type="checkbox" id="f-stream" /> Stream responses</label>
                        <p class="field-hint">Replicas, image, env and resources are never set here; suspend or resume an agent from its details.</p>
                        <p class="field-error" data-error="runtime" hidden></p>
                    </fieldset>
                </div>
            </details>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="f-save">Save</button>
                <button type="button" class="btn btn-ghost" id="f-cancel">Cancel</button>
            </div>
        </form>
    </div>
</section>

<script>
(() => {
    const root = document.getElementById('agents');
    const canWrite = root.dataset.canWrite === 'true';
    const canProposeChanges = root.dataset.canProposeChanges === 'true';
    const base = '/api/agents';
    const grid = document.getElementById('agent-grid');
    const views = ['list-view', 'detail-view', 'form-view'].map(id => document.getElementById(id));
    let agents = null;
    let options = null;
    let editing = null;

    // Values from the API are only ever set with textContent.
    const say = (box, text) => { box.textContent = text; box.hidden = !text; };
    const fail = text => skx.toast(text, { tone: 'error' });
    const done = text => skx.toast(text);
    const path = (ns, name) => `${base}/${encodeURIComponent(ns)}/${encodeURIComponent(name)}`;
    // The Chat deep link (chat-ui branch): /Chat/{namespace}/{agent}, never a bare name another namespace may share.
    const chatLink = a => `/Chat/${encodeURIComponent(a.namespace)}/${encodeURIComponent(a.name)}`;
    const el = (tag, text, cls) => { const e = document.createElement(tag); if (text !== undefined) e.textContent = text; if (cls) e.className = cls; return e; };
    const lines = text => text.split('\n').map(s => s.trim()).filter(Boolean);
    const show = view => views.forEach(v => { v.hidden = v.id !== view; });
    const status = a => a.suspended ? 'suspended' : (a.ready ? 'ready' : (a.accepted ? 'starting' : 'not-ready'));
    const statusLabel = { suspended: 'Suspended', ready: 'Ready', starting: 'Accepted, starting', 'not-ready': 'Not ready' };
    // The shared status words (skx.badge, StatusTone): ready is green, starting and suspended amber, not ready red.
    const statusWord = { suspended: 'suspended', ready: 'ready', starting: 'starting', 'not-ready': 'failed' };
    const stateBadge = a => skx.badge(statusWord[status(a)], statusLabel[status(a)]);

    // The shared client (js/ui.js): the error carries the status and the problem body (a 400's errors by field).
    const call = (method, url, body) => skx.api(method, url, body);

    function button(label, name, action, cls = 'btn btn-secondary btn-sm') {
        const b = el('button', label, cls);
        b.type = 'button';
        b.setAttribute('aria-label', `${label} ${name}`);
        b.addEventListener('click', e => { e.stopPropagation(); action(); });
        return b;
    }

    function badge(text) { return el('span', text, 'badge badge-neutral'); }

    // ---------- Setup guides ----------
    // Drawn by the shared setup block (js/setup-guide.js): the API's { id, title, cause, steps } and its copy-for-agent.
    async function loadGuides() {
        const box = document.getElementById('guides');
        try {
            box.replaceChildren(...(await call('GET', `${base}/setup`)).map(g => skxSetupGuide.render(g)));
        } catch {
            // The list shows the failure with its retry; a missing guide adds nothing to it.
            box.replaceChildren();
        }
    }

    // ---------- List ----------
    function card(a) {
        // The name is the link (keyboard, screen readers); the buttons sit beside it, never inside a link.
        const c = el('article', undefined, 'card tile');
        c.dataset.agent = `${a.namespace}/${a.name}`;
        c.setAttribute('aria-label', `${a.namespace}/${a.name}`);
        const head = el('div', undefined, 'tile-head');
        const title = el('div');
        const link = el('a', a.name, 'tile-title');
        link.href = `#agent/${encodeURIComponent(a.namespace)}/${encodeURIComponent(a.name)}`;
        link.setAttribute('aria-label', `Open ${a.namespace}/${a.name}`);
        title.append(link, el('div', a.namespace, 'tile-sub'));
        const badges = el('div', undefined, 'badges');
        badges.append(badge(a.type), stateBadge(a));
        head.append(title, badges);
        const meta = el('div', undefined, 'tile-meta');
        meta.append(el('span', `Model: ${a.modelConfig || '—'}`), el('span', `${a.toolCount} tool${a.toolCount === 1 ? '' : 's'}`), el('span', a.source));
        const actions = el('div', undefined, 'tile-actions');
        if (a.inChat && !a.suspended) actions.appendChild(button('Chat', a.name, () => { location.href = chatLink(a); }));
        if (canWrite && a.canEdit) actions.appendChild(button('Edit', a.name, () => { location.hash = `edit/${a.namespace}/${a.name}`; }));
        if (canProposeChanges && a.source === 'studio') actions.appendChild(button('Propose change', a.name, () => { location.hash = `edit/${a.namespace}/${a.name}`; }));
        if (canWrite && a.canDelete) actions.appendChild(button('Delete', a.name, () => remove(a.namespace, a.name), 'btn btn-danger-ghost btn-sm'));
        c.append(head, el('p', a.description || 'No description.', 'text-secondary clamp'), meta, actions);
        // A click anywhere else on the card opens it too, as a mouse convenience.
        c.addEventListener('click', e => { if (!e.target.closest('a, button')) link.click(); });
        return c;
    }

    function clearSearch() {
        for (const id of ['search', 'filter-type', 'filter-status']) document.getElementById(id).value = '';
        render();
        document.getElementById('search').focus();
    }

    function render() {
        if (agents === null) return;
        const q = document.getElementById('search').value.trim().toLowerCase();
        const type = document.getElementById('filter-type').value;
        const state = document.getElementById('filter-status').value;
        const shown = agents.filter(a =>
            (!q || [a.name, a.namespace, a.description, a.modelConfig].some(v => (v || '').toLowerCase().includes(q)))
            && (!type || a.type === type) && (!state || status(a) === state));
        document.getElementById('agent-count').textContent = `${shown.length}${shown.length !== agents.length ? ` of ${agents.length}` : ''} agent${agents.length === 1 ? '' : 's'}`;
        if (agents.length === 0) {
            skx.state.empty(grid, {
                icon: 'i-bot', title: 'No agents yet', compact: false,
                body: canWrite ? 'An agent answers in Chat with a model, instructions and the tools you give it.' : 'Propose the first one: a supervisor reviews it before it goes live.',
                action: { label: canWrite ? 'New agent' : 'Propose an agent', onClick: () => { location.hash = 'new'; } }
            });
        } else if (shown.length === 0) {
            skx.state.empty(grid, { icon: 'i-search', title: 'No agent matches', body: 'Try another word, or clear the search and filters.', action: { label: 'Clear search', onClick: clearSearch } });
        } else {
            grid.replaceChildren(...shown.map(card));
        }
    }

    async function load() {
        if (agents === null) skx.state.loading(grid, { rows: 4 });
        try {
            agents = await call('GET', base);
            render();
        } catch (e) {
            agents = null;
            document.getElementById('agent-count').textContent = '';
            skx.state.error(grid, { title: 'The agents could not be loaded', detail: e.message, retry: () => { loadGuides(); load(); } });
            if (e.status >= 500) await loadGuides();
        }
    }

    ['search', 'filter-type', 'filter-status'].forEach(id => document.getElementById(id).addEventListener('input', render));

    // ---------- Details ----------
    function empty(box, text) { box.replaceChildren(el('p', text, 'text-muted text-sm')); }

    function fields(dl, rows) {
        dl.replaceChildren();
        for (const [label, value] of rows)
            if (value !== null && value !== undefined && value !== '') dl.append(el('dt', label), el('dd', String(value)));
    }

    async function details(ns, name) {
        show('detail-view');
        let a;
        try {
            a = await call('GET', path(ns, name));
        } catch (e) {
            fail(e.message);
            location.hash = '';
            return;
        }
        document.getElementById('detail-name').textContent = a.name;
        document.getElementById('detail-ns').textContent = a.namespace;
        const badges = document.getElementById('detail-badges');
        badges.replaceChildren(badge(a.type), stateBadge(a), badge(a.source));
        document.getElementById('detail-description').textContent = a.description || 'No description.';
        say(document.getElementById('detail-protection'), a.protection ?? '');

        const actions = document.getElementById('detail-actions');
        actions.replaceChildren();
        if (a.inChat && !a.suspended) {
            const chat = el('a', 'Chat with this agent', 'btn btn-primary');
            chat.href = chatLink(a);
            actions.appendChild(chat);
        }
        if (canWrite && a.canEdit) actions.appendChild(button('Edit', a.name, () => { location.hash = `edit/${a.namespace}/${a.name}`; }, 'btn btn-secondary'));
        if (canProposeChanges && a.source === 'studio') actions.appendChild(button('Propose change', a.name, () => { location.hash = `edit/${a.namespace}/${a.name}`; }, 'btn btn-secondary'));
        if (canWrite && a.canDelete) {
            actions.appendChild(a.suspended
                ? button('Resume', a.name, () => lifecycle(a.namespace, a.name, 'resume'), 'btn btn-secondary')
                : button('Suspend', a.name, () => lifecycle(a.namespace, a.name, 'suspend'), 'btn btn-secondary'));
            actions.appendChild(button('Delete', a.name, () => remove(a.namespace, a.name), 'btn btn-danger-ghost'));
        }

        document.getElementById('d-prompt-card').hidden = a.systemMessage === null;
        document.getElementById('d-prompt').textContent = a.systemMessage ?? '';
        fields(document.getElementById('d-model'), [['ModelConfig', a.modelConfig || 'kagent default'], ['Runtime', a.runtime || "kagent's default"], ['Streaming', a.stream ? 'on' : 'off']]);

        const tools = document.getElementById('d-tools');
        tools.replaceChildren();
        for (const server of a.toolsByServer) {
            const box = el('div', undefined, 'subcard');
            box.appendChild(el('strong', server.server));
            const list = el('ul', undefined, 'list-plain');
            if (server.tools.length === 0) list.appendChild(el('li', 'Every tool the server lists', 'text-muted'));
            for (const t of server.tools) {
                const li = el('li');
                li.append(el('code', t.name));
                if (t.description) li.append(el('span', t.description, 'table-cell-sub'));
                list.appendChild(li);
            }
            box.appendChild(list);
            tools.appendChild(box);
        }
        if (a.agentTools.length) {
            const box = el('div', undefined, 'subcard');
            box.append(el('strong', 'Agents as tools'), el('div', a.agentTools.join(', ')));
            tools.appendChild(box);
        }
        if (!tools.children.length) empty(tools, 'No tools.');

        const skills = document.getElementById('d-skills');
        if (a.skills.length) skills.replaceChildren(...a.skills.map(s => el('div', s))); else empty(skills, 'No skills.');
        const memory = document.getElementById('d-memory');
        if (a.memory) memory.replaceChildren(el('div', `On: embeddings from ${a.memory.modelConfig}, entries kept ${a.memory.ttlDays} days.`));
        else empty(memory, 'Off.');
        const a2a = document.getElementById('d-a2a');
        if (a.a2aSkills.length) a2a.replaceChildren(...a.a2aSkills.map(s => {
            const d = el('div', undefined, 'subcard');
            d.append(el('strong', `${s.name} (${s.id})`));
            if (s.description) d.append(el('div', s.description, 'table-cell-sub'));
            if (s.tags?.length) d.append(el('div', `Tags: ${s.tags.join(', ')}`, 'table-cell-sub'));
            if (s.examples?.length) d.append(el('div', `Examples: ${s.examples.join(' · ')}`, 'table-cell-sub'));
            return d;
        })); else empty(a2a, 'None.');

        fields(document.getElementById('d-deployment'), [
            ['State', statusLabel[status(a)]],
            ['In Chat', a.inChat ? (a.suspended ? 'no (suspended)' : 'yes') : 'no'],
            ['Replicas', a.replicas ?? '1 (kagent default)'],
            ...a.conditions.map(c => [c.type, `${c.status}${c.reason ? ` (${c.reason})` : ''}`]),
            ['Used as a tool by', a.usedBy.join(', ')],
            ['Studio file', a.studioPath]
        ]);
        await sessions(a);
    }

    // The caller's own indexed chats with this agent (chat-context); nothing when that module is off.
    async function sessions(a) {
        const box = document.getElementById('d-sessions');
        try {
            const list = (await call('GET', `/api/chat/sessions?mine=true&agent=${encodeURIComponent(`${a.namespace}/${a.name}`)}`)).slice(0, 5);
            if (!list.length) { empty(box, 'No sessions of yours with this agent yet.'); return; }
            box.replaceChildren(...list.map(s => {
                const row = el('div');
                const link = el('a', s.title || 'Untitled chat');
                link.href = chatLink(a);
                const when = el('time', ` · ${skx.time(s.updatedAt)}`, 'text-muted');
                when.dateTime = s.updatedAt;
                when.title = skx.utc(s.updatedAt);
                row.append(link, when);
                return row;
            }));
        } catch {
            empty(box, 'Chat history is not available.');
        }
    }

    async function lifecycle(ns, name, verb) {
        if (verb === 'suspend' && !await skx.confirm({ title: `Suspend ${ns}/${name}?`, body: 'Its pod stops and Chat stops offering it until you resume it.', confirm: 'Suspend' })) return;
        try {
            await call('POST', `${path(ns, name)}/${verb}`);
            done(`${ns}/${name} ${verb === 'suspend' ? 'suspended' : 'resumed'}.`);
            await load();
            await details(ns, name);
        } catch (e) {
            fail(e.message);
        }
    }

    async function remove(ns, name) {
        let usedBy = [];
        try {
            usedBy = (await call('GET', path(ns, name))).usedBy;
        } catch (e) {
            fail(e.message);
            return;
        }
        const warning = usedBy.length ? ` ${usedBy.join(', ')} call${usedBy.length === 1 ? 's' : ''} this agent as a tool and will fail to use it.` : '';
        if (!await skx.confirm({ title: `Delete ${ns}/${name}?`, body: `kagent removes it and its pod; this cannot be undone.${warning}`, confirm: 'Delete', danger: true })) return;
        try {
            await call('DELETE', path(ns, name));
            done(`${ns}/${name} deleted.`);
            location.hash = '';
            await load();
        } catch (e) {
            fail(e.message);
        }
    }

    // ---------- Form ----------
    async function loadOptions() {
        options ??= await call('GET', `${base}/options`);
        return options;
    }

    const errorBox = document.querySelector('#agent-form [data-error-box]');
    function formError(text) {
        say(errorBox.querySelector('[data-error="form"]'), text);
        errorBox.hidden = !text;
    }

    function clearErrors() {
        document.querySelectorAll('#agent-form .field-error').forEach(p => say(p, ''));
        formError('');
    }

    // A 400 is keyed by field; anything without its own place shows at the top.
    function showErrors(errors) {
        clearErrors();
        for (const [key, messages] of Object.entries(errors)) {
            const slot = document.querySelector(`#agent-form .field-error[data-error="${CSS.escape(key)}"]`);
            if (slot) say(slot, [slot.textContent, ...messages].filter(Boolean).join(' '));
            else formError([errorBox.textContent.trim(), ...messages].filter(Boolean).join(' '));
        }
        // An error inside the closed Advanced part opens it, so it is never hidden.
        if (document.querySelector('#f-advanced .field-error:not([hidden])')) document.getElementById('f-advanced').open = true;
        document.querySelector('#agent-form .field-error:not([hidden]), #agent-form [data-error-box]:not([hidden])')?.scrollIntoView({ block: 'center' });
    }

    function option(value, label = value) { const o = el('option', label); o.value = value; return o; }

    function toolServer(server, tools, chosen, kept) {
        const box = el('div', undefined, 'subcard tool-server');
        box.dataset.server = server;
        const label = el('label', undefined, 'check');
        const on = document.createElement('input');
        on.type = 'checkbox';
        on.className = 'mcp-on';
        on.checked = chosen !== null;
        label.append(on, ` ${server}${kept ? ' (kept as it is: not on the allow-list)' : ''}`);
        box.appendChild(label);
        const known = new Map(tools.map(t => [t.name, t.description]));
        (chosen ?? []).forEach(t => { if (!known.has(t)) known.set(t, ''); });
        const list = el('div', undefined, 'check-list');
        for (const [tool, description] of known) {
            const row = el('label', undefined, 'check');
            const c = document.createElement('input');
            c.type = 'checkbox';
            c.value = tool;
            c.checked = (chosen ?? []).includes(tool);
            c.disabled = kept;
            c.addEventListener('change', () => { if (c.checked) on.checked = true; });
            row.append(c, ' ', el('code', tool));
            if (description) row.append(el('span', ` — ${description}`, 'text-muted text-xs'));
            list.appendChild(row);
        }
        if (!known.size) list.appendChild(el('span', 'kagent has not discovered this server\'s tools yet.', 'text-muted'));
        if (kept) box.dataset.kept = JSON.stringify(chosen);
        box.appendChild(list);
        return box;
    }

    function a2aSkill(skill = {}) {
        const box = el('div', undefined, 'subcard a2a-skill');
        const field = (label, key, value, area) => {
            const wrap = el('div', undefined, 'field');
            const l = el('label', label);
            const i = document.createElement(area ? 'textarea' : 'input');
            i.id = `a2a-${key}-${crypto.randomUUID()}`;
            l.htmlFor = i.id;
            i.dataset.key = key;
            i.value = value ?? '';
            if (area) i.rows = 2;
            wrap.append(l, i);
            box.append(wrap);
        };
        field('Id', 'id', skill.id);
        field('Name', 'name', skill.name);
        field('Description', 'description', skill.description);
        field('Tags (comma separated)', 'tags', (skill.tags ?? []).join(', '));
        field('Examples (one per line)', 'examples', (skill.examples ?? []).join('\n'), true);
        box.appendChild(button('Remove', 'A2A skill', () => box.remove(), 'btn btn-danger-ghost btn-sm'));
        return box;
    }

    function countPrompt() {
        const prompt = document.getElementById('f-prompt');
        document.getElementById('f-prompt-count').textContent = `${prompt.value.length} / 16000 characters`;
    }

    async function openForm(agent) {
        show('form-view');
        clearErrors();
        let o;
        try {
            o = await loadOptions();
        } catch (e) {
            formError(`The form could not be prepared: ${e.message}`);
            if (e.status >= 500) await loadGuides();
            return;
        }
        const proposal = o.mode === 'proposal';
        editing = agent;
        document.getElementById('form-title').textContent = proposal
            ? (agent ? `Propose a change to ${agent.namespace}/${agent.name}` : 'Propose a new agent')
            : (agent ? `Edit ${agent.namespace}/${agent.name}` : 'New agent');
        document.getElementById('f-mode-note').hidden = !proposal;
        document.getElementById('f-save').textContent = proposal ? 'Submit proposal' : (agent ? 'Save' : 'Create agent');
        document.getElementById('f-namespace').value = agent?.namespace ?? o.namespace;
        const name = document.getElementById('f-name');
        name.value = agent?.name ?? '';
        name.readOnly = !!agent;
        document.getElementById('f-description').value = agent?.description ?? '';
        document.getElementById('f-prompt').value = agent?.systemMessage ?? '';
        countPrompt();

        const model = document.getElementById('f-model');
        model.replaceChildren(...o.modelConfigs.map(m => option(m)));
        if (agent?.modelConfig) model.value = agent.modelConfig;
        document.getElementById('f-model-empty').hidden = o.modelConfigs.length > 0;

        const mcp = document.getElementById('f-mcp');
        const current = new Map((agent?.mcpTools ?? []).map(t => [t.server, t.tools]));
        const allowed = new Set(o.mcpServers.map(s => s.server));
        mcp.replaceChildren(
            ...o.mcpServers.map(s => toolServer(s.server, s.tools, current.get(s.server) ?? null, false)),
            ...[...current].filter(([s]) => !allowed.has(s)).map(([s, tools]) => toolServer(s, [], tools, true)));
        document.getElementById('f-mcp-empty').hidden = mcp.children.length > 0;

        // An agent tool the agent already has stays offered (kept as it is), even when no longer callable from new agents.
        const callable = [...new Set([...o.agents, ...(agent?.agentTools ?? [])])].filter(a => a !== agent?.name);
        document.getElementById('f-agents').replaceChildren(...callable.map(a => {
            const row = el('label', undefined, 'check');
            const c = document.createElement('input');
            c.type = 'checkbox';
            c.value = a;
            c.checked = (agent?.agentTools ?? []).includes(a);
            row.append(c, ` ${a}`);
            return row;
        }));
        document.getElementById('f-agents-box').hidden = proposal;
        document.getElementById('f-agents-off').hidden = !proposal;
        document.getElementById('f-agents-empty').hidden = callable.length > 0;

        document.getElementById('f-skills').value = (agent?.skills ?? []).join('\n');
        document.getElementById('f-skills-off').hidden = o.skillRegistries.length > 0;

        const memoryModel = document.getElementById('f-memory-model');
        memoryModel.replaceChildren(...o.modelConfigs.map(m => option(m)));
        document.getElementById('f-memory-on').checked = !!agent?.memory;
        document.getElementById('f-memory-box').hidden = !agent?.memory;
        if (agent?.memory) memoryModel.value = agent.memory.modelConfig;
        memoryModel.disabled = proposal; // a proposal's memory uses the agent's own model
        document.getElementById('f-memory-ttl').value = agent?.memory?.ttlDays ?? 15;

        document.getElementById('f-a2a').replaceChildren(...(agent?.a2aSkills ?? []).map(a2aSkill));
        document.getElementById('f-a2a-section').hidden = proposal;
        document.getElementById('f-runtime').value = agent?.runtime ?? '';
        document.getElementById('f-stream').checked = !!agent?.stream;
        document.getElementById('f-deploy-section').hidden = proposal;
        document.getElementById('f-advanced').open = !!(agent && (agent.skills.length || agent.memory || agent.a2aSkills.length || agent.runtime || agent.stream));
        (agent ? document.getElementById('f-description') : name).focus();
    }

    function formBody() {
        const proposal = options.mode === 'proposal';
        const model = document.getElementById('f-model').value;
        return {
            namespace: document.getElementById('f-namespace').value,
            name: document.getElementById('f-name').value.trim(),
            description: document.getElementById('f-description').value.trim(),
            systemMessage: document.getElementById('f-prompt').value,
            modelConfig: model,
            runtime: proposal ? null : (document.getElementById('f-runtime').value || null),
            stream: !proposal && document.getElementById('f-stream').checked,
            mcpTools: [...document.querySelectorAll('#f-mcp .tool-server')]
                .filter(b => b.querySelector('.mcp-on').checked)
                .map(b => ({
                    server: b.dataset.server,
                    tools: b.dataset.kept ? JSON.parse(b.dataset.kept) : [...b.querySelectorAll('.check-list input:checked')].map(c => c.value)
                })),
            agentTools: proposal ? [] : [...document.querySelectorAll('#f-agents input:checked')].map(c => c.value),
            skills: lines(document.getElementById('f-skills').value),
            memory: document.getElementById('f-memory-on').checked
                ? { modelConfig: proposal ? model : document.getElementById('f-memory-model').value, ttlDays: Number(document.getElementById('f-memory-ttl').value) }
                : null,
            a2aSkills: proposal ? [] : [...document.querySelectorAll('#f-a2a .a2a-skill')].map(b => {
                const v = key => b.querySelector(`[data-key="${key}"]`).value.trim();
                return {
                    id: v('id'), name: v('name'), description: v('description') || null,
                    tags: v('tags').split(',').map(s => s.trim()).filter(Boolean), examples: lines(v('examples'))
                };
            })
        };
    }

    async function submit(event) {
        event.preventDefault();
        clearErrors();
        const body = formBody();
        const proposal = options.mode === 'proposal';
        const save = document.getElementById('f-save');
        save.setAttribute('aria-busy', 'true');
        save.disabled = true;
        try {
            if (proposal) {
                const result = await call('POST', `${base}/proposals`, body);
                done(result.message);
            } else if (editing) {
                await call('PUT', path(editing.namespace, editing.name), { ...body, version: editing.version });
                done(`${body.namespace}/${body.name} saved.`);
            } else {
                await call('POST', base, body);
                done(`${body.namespace}/${body.name} created.`);
            }
            options = null;
            location.hash = proposal || !editing ? '' : `agent/${body.namespace}/${body.name}`;
            await load();
        } catch (e) {
            if (e.status === 400 && e.data?.errors) showErrors(e.data.errors);
            else {
                formError(e.message);
                if (e.data?.reason === 'studio-not-configured' || e.status >= 500) await loadGuides();
                document.getElementById('form-view').scrollIntoView();
            }
        } finally {
            save.removeAttribute('aria-busy');
            save.disabled = false;
        }
    }

    async function edit(ns, name) {
        try {
            await openForm(await call('GET', path(ns, name)));
        } catch (e) {
            fail(e.message);
            location.hash = '';
        }
    }

    document.getElementById('f-prompt').addEventListener('input', countPrompt);
    document.getElementById('f-memory-on').addEventListener('change', e => { document.getElementById('f-memory-box').hidden = !e.target.checked; });
    document.getElementById('f-a2a-add').addEventListener('click', () => document.getElementById('f-a2a').appendChild(a2aSkill()));
    document.getElementById('agent-form').addEventListener('submit', submit);
    document.getElementById('new-agent').addEventListener('click', () => { location.hash = 'new'; });
    for (const id of ['f-cancel', 'f-back', 'detail-back'])
        document.getElementById(id).addEventListener('click', () => { location.hash = ''; });
    document.getElementById('refresh').addEventListener('click', () => { loadGuides(); load(); });

    // #agent/ns/name = details, #edit/ns/name = edit or propose a change, #new = the form, anything else = the grid.
    function route() {
        const [view, ns, name] = location.hash.slice(1).split('/').map(decodeURIComponent);
        if (view === 'agent' && ns && name) details(ns, name);
        else if (view === 'edit' && ns && name) edit(ns, name);
        else if (view === 'new') openForm(null);
        else show('list-view');
    }

    window.addEventListener('hashchange', route);
    loadGuides();
    load().then(route);
})();
</script>
