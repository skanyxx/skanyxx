@* The quotas' money disclaimer (D336): large and unmissable wherever a quota cost is shown. *@
<div class="alert alert-warning quota-disclaimer" role="note">
    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-alert-triangle"/></svg>
    <div class="alert-body">
        <div class="alert-title">@Skanyxx.Core.Platform.Chat.QuotaCostDisclaimer.Title</div>
        <p>@Skanyxx.Core.Platform.Chat.QuotaCostDisclaimer.Text</p>
    </div>
</div>
