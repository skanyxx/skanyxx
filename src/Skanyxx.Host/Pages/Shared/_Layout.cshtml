@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject MediatR.IMediator Mediator
@using System.Security.Claims
@using Skanyxx.Core.Platform
@using Skanyxx.Core.Platform.Identity
@using Skanyxx.Core.Platform.Preferences
@using Skanyxx.Host.Navigation
@using Skanyxx.Host.TagHelpers
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";
    var title = ViewData["Title"]?.ToString() ?? "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    // The person's appearance is applied here, on the server, so the first paint is already right (no flash).
    var preferences = signedIn && Caller.UserId(User) is { } userId
        ? (await Mediator.Send(new GetPreferencesQuery(userId))).Value?.Effective ?? EffectivePreferences.Defaults
        : EffectivePreferences.Defaults;
    var links = NavCatalog.LinksFor(User, Configuration, Url, currentPage);
    var sections = NavCatalog.Sections(links, preferences);
    var navItem = NavCatalog.ForPage(currentPage);
    var fullBleed = navItem?.FullBleed == true;
    var hasPageHeader = ViewData[PageHeaderTagHelper.Flag] is true;
    var displayName = User.FindFirst(SkanyxxClaims.DisplayName)?.Value ?? User.Identity?.Name ?? "";
    var initials = string.Concat(displayName.Split([' ', '.', '@'], StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    var roles = User.FindAll(ClaimTypes.Role).Select(c => c.Value).Order().ToList();
}
<!DOCTYPE html>
<html lang="en"
      data-theme="@preferences.Theme"
      data-accent="@(preferences.Accent == "auto" ? null : preferences.Accent)"
      data-density="@preferences.Density"
      data-font-size="@preferences.FontSize"
      data-sidebar="@preferences.Sidebar"
      data-motion="@(preferences.Motion == "reduce" ? "reduce" : null)"
      data-chat-details="@preferences.ChatDetails"
      data-page-size="@preferences.TablePageSize">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>@title - Skanyxx</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <script src="~/js/ui.js" asp-append-version="true" defer></script>
    <script src="~/js/setup-guide.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <partial name="_NavIcons" />
    <div class="app-container">
        <aside class="sidebar" id="sidebar" aria-label="Main">
            <div class="sidebar-header">
                <a href="/" class="sidebar-logo" aria-label="Skanyxx home">
                    <span class="sidebar-logo-icon" aria-hidden="true">S</span>
                    <div>
                        <div class="sidebar-logo-text">Skanyxx</div>
                        <div class="sidebar-subtitle">Agent Workspace</div>
                    </div>
                </a>
            </div>
            <nav class="sidebar-nav">
                @foreach (var navSection in sections)
                {
                    var sectionId = "nav-" + navSection.Title.ToLowerInvariant();
                    <div class="nav-section" role="group" aria-labelledby="@sectionId">
                        <div class="nav-section-title" id="@sectionId">@navSection.Title</div>
                        @foreach (var link in navSection.Links)
                        {
                            <a href="@link.Href" class="nav-item @(link.Active ? "active" : "")" aria-current="@(link.Active ? "page" : null)" title="@link.Item.Label">
                                <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#@link.Item.Icon"/></svg></span>
                                <span class="nav-label">@link.Item.Label</span>
                            </a>
                        }
                    </div>
                }
            </nav>
            @if (signedIn)
            {
                <div class="sidebar-footer">
                    <button type="button" class="btn btn-ghost sidebar-toggle" id="sidebarToggle" aria-pressed="@(preferences.Sidebar == "collapsed" ? "true" : "false")" title="Collapse or expand the sidebar">
                        <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-panel-left"/></svg>
                        <span class="nav-label">Collapse sidebar</span>
                    </button>
                </div>
            }
        </aside>
        <div class="nav-backdrop" id="navBackdrop" hidden></div>

        <div class="main-content">
            <header class="top-header">
                <button type="button" class="btn btn-ghost btn-icon nav-open-btn" id="navOpen" aria-controls="sidebar" aria-expanded="false" aria-label="Open the menu">
                    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-menu"/></svg>
                </button>
                <nav class="breadcrumbs" aria-label="Breadcrumb">
                    <ol>
                        @if (navItem is not null)
                        {
                            <li>@navItem.Group</li>
                        }
                        @if (fullBleed)
                        {
                            <li aria-current="page"><h1 class="header-title">@title</h1></li>
                        }
                        else
                        {
                            <li aria-current="page">@title</li>
                        }
                    </ol>
                </nav>
                <div class="header-actions">
                    @if (signedIn)
                    {
                        <details class="user-menu">
                            <summary aria-label="Your account: @displayName">
                                <span class="avatar" aria-hidden="true">@initials</span>
                                <span class="user-menu-name">@displayName</span>
                                <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-chevron-down"/></svg>
                            </summary>
                            <div class="menu">
                                <div class="menu-header">
                                    <strong>@displayName</strong>
                                    <span>@User.Identity?.Name</span>
                                    @if (roles.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1 mt-1">
                                            @foreach (var role in roles)
                                            {
                                                <span class="badge badge-neutral">@role</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <a class="menu-item" href="/Account">
                                    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-user"/></svg> Account
                                </a>
                                <a class="menu-item" href="/Account#appearance">
                                    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-palette"/></svg> Appearance &amp; layout
                                </a>
                                <button type="button" class="menu-item" id="installBtn" hidden>
                                    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-download"/></svg> Install app
                                </button>
                                <hr class="menu-sep" />
                                <form method="post" asp-page="/Logout">
                                    <button type="submit" class="menu-item">
                                        <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-logout"/></svg> Sign out
                                    </button>
                                </form>
                            </div>
                        </details>
                    }
                    else
                    {
                        <a href="/Login" class="btn btn-secondary">Sign in</a>
                    }
                </div>
            </header>
            <main class="page-content" id="main" tabindex="-1">
                @if (!fullBleed && !hasPageHeader)
                {
                    <header class="page-header"><div class="page-header-text"><h1 class="page-title">@title</h1></div></header>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <dialog class="dialog" id="skx-confirm" aria-labelledby="skx-confirm-title">
        <form method="dialog">
            <div class="dialog-header"><h2 class="dialog-title" id="skx-confirm-title" data-confirm-title></h2></div>
            <div class="dialog-body"><p data-confirm-body></p></div>
            <div class="dialog-footer">
                <button type="submit" class="btn btn-secondary" value="cancel" data-confirm-cancel>Cancel</button>
                <button type="submit" class="btn btn-primary" value="ok" data-confirm-ok>Confirm</button>
            </div>
        </form>
    </dialog>
    <div class="toasts" id="skx-toasts" aria-live="polite"></div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
