@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>@ViewData["Title"] - Skanyxx</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_NavIcons" />
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-logo">
                    <span class="sidebar-logo-icon">S</span>
                    <div>
                        <div class="sidebar-logo-text">Skanyxx</div>
                        <div class="sidebar-subtitle">SRE Command Center</div>
                    </div>
                </a>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">Overview</div>
                    <a href="/Dashboard" class="nav-item @(currentPage == "/Dashboard" ? "active" : "")" title="Dashboard">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-dashboard"/></svg></span>
                        <span class="nav-label">Dashboard</span>
                    </a>
                    <a href="/Investigate" class="nav-item @(currentPage == "/Investigate" ? "active" : "")" title="Investigate">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-search"/></svg></span>
                        <span class="nav-label">Investigate</span>
                    </a>
                </div>
                <div class="nav-section">
                    <div class="nav-section-title">AI & Agents</div>
                    <a href="/Agents" class="nav-item @(currentPage == "/Agents" ? "active" : "")" title="Agents">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-bot"/></svg></span>
                        <span class="nav-label">Agents</span>
                    </a>
                    <a href="/Chat" class="nav-item @(currentPage == "/Chat" ? "active" : "")" title="Chat">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-chat"/></svg></span>
                        <span class="nav-label">Chat</span>
                    </a>
                    <a href="/Library" class="nav-item @(currentPage == "/Library" ? "active" : "")" title="Library">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-library"/></svg></span>
                        <span class="nav-label">Library</span>
                    </a>
                    @if (User.IsInRole(Skanyxx.Core.Platform.SkanyxxRoles.Owner) || User.IsInRole(Skanyxx.Core.Platform.SkanyxxRoles.Supervisor) || User.IsInRole(Skanyxx.Core.Platform.SkanyxxRoles.Builder))
                    {
                        <a href="/Studio" class="nav-item @(currentPage == "/Studio" ? "active" : "")" title="Studio">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-studio"/></svg></span>
                            <span class="nav-label">Studio</span>
                        </a>
                    }
                    @if (User.IsInRole(Skanyxx.Core.Platform.SkanyxxRoles.Owner) || User.IsInRole(Skanyxx.Core.Platform.SkanyxxRoles.Supervisor))
                    {
                        <a href="/Sandboxes" class="nav-item @(currentPage == "/Sandboxes" ? "active" : "")" title="Sandboxes">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-sandbox"/></svg></span>
                            <span class="nav-label">Sandboxes</span>
                        </a>
                    }
                </div>
                <div class="nav-section">
                    <div class="nav-section-title">Infrastructure</div>
                    <a href="/CloudTools" class="nav-item @(currentPage == "/CloudTools" ? "active" : "")" title="Cloud Tools">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-cloud"/></svg></span>
                        <span class="nav-label">Cloud Tools</span>
                    </a>
                    <a href="/ToolServers" class="nav-item @(currentPage == "/ToolServers" ? "active" : "")" title="Tool Servers">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-server"/></svg></span>
                        <span class="nav-label">Tool Servers</span>
                    </a>
                </div>
                <div class="nav-section">
                    <div class="nav-section-title">Insights</div>
                    <a href="/Analytics" class="nav-item @(currentPage == "/Analytics" ? "active" : "")" title="Analytics">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-chart"/></svg></span>
                        <span class="nav-label">Analytics</span>
                    </a>
                </div>
                <div class="nav-section">
                    <div class="nav-section-title">System</div>
                    <a href="/Alerts" class="nav-item @(currentPage == "/Alerts" ? "active" : "")" title="Alerts">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-bell"/></svg></span>
                        <span class="nav-label">Alerts</span>
                    </a>
                    <a href="/Hooks" class="nav-item @(currentPage == "/Hooks" ? "active" : "")" title="Hooks">
                        <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-link"/></svg></span>
                        <span class="nav-label">Hooks</span>
                    </a>
                    @if (User.IsInRole(Skanyxx.Core.Platform.SkanyxxRoles.Owner))
                    {
                        <a href="/Debug" class="nav-item @(currentPage == "/Debug" ? "active" : "")" title="Debug">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-terminal"/></svg></span>
                            <span class="nav-label">Debug</span>
                        </a>
                        <a href="/Settings" class="nav-item @(currentPage == "/Settings" ? "active" : "")" title="Settings">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-sliders"/></svg></span>
                            <span class="nav-label">Settings</span>
                        </a>
                        <a href="/Model" class="nav-item @(currentPage == "/Model" ? "active" : "")" title="Model">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-cpu"/></svg></span>
                            <span class="nav-label">Model</span>
                        </a>
                        <a href="/People" class="nav-item @(currentPage == "/People" ? "active" : "")" title="People">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-users"/></svg></span>
                            <span class="nav-label">People</span>
                        </a>
                        <a href="/Org" class="nav-item @(currentPage == "/Org" ? "active" : "")" title="Org">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-org"/></svg></span>
                            <span class="nav-label">Org</span>
                        </a>
                        <a href="/Entra" class="nav-item @(currentPage == "/Entra" ? "active" : "")" title="Microsoft sign-in">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-signin"/></svg></span>
                            <span class="nav-label">Microsoft sign-in</span>
                        </a>
                        <a href="/Audit" class="nav-item @(currentPage == "/Audit" ? "active" : "")" title="Audit">
                            <span class="nav-icon"><svg aria-hidden="true" focusable="false"><use href="#i-audit"/></svg></span>
                            <span class="nav-label">Audit</span>
                        </a>
                    }
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <header class="top-header">
                <h1 class="header-title">@ViewData["Title"]</h1>
                <div class="header-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Account" class="header-user" title="@User.Identity.Name">@(User.FindFirst(Skanyxx.Core.Platform.Identity.SkanyxxClaims.DisplayName)?.Value ?? User.Identity.Name)</a>
                        <form method="post" asp-page="/Logout" class="header-signout">
                            <button type="submit" class="btn btn-ghost">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Login" class="btn btn-ghost">Sign in</a>
                    }
                    <button class="pwa-install-btn" id="installBtn" style="display: none;">
                        <span>&#x2B07;</span>
                        <span>Install App</span>
                    </button>
                </div>
            </header>
            <div class="page-content animate-fade-in">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // PWA Install prompt
        let deferredPrompt;
        const installBtn = document.getElementById('installBtn');

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            installBtn.style.display = 'flex';
        });

        installBtn.addEventListener('click', async () => {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                console.log(`User response: ${outcome}`);
                deferredPrompt = null;
                installBtn.style.display = 'none';
            }
        });

        window.addEventListener('appinstalled', () => {
            installBtn.style.display = 'none';
            console.log('PWA installed');
        });

        // Unregister any existing service workers to fix issues
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function(registrations) {
                for (let registration of registrations) {
                    registration.unregister();
                    console.log('ServiceWorker unregistered');
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
