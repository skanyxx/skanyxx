@page
@model InviteModel
@{
    ViewData["Title"] = "Accept your invite";
    Layout = "_AuthLayout";
}
@if (Model.Error is not null)
{
    <p class="text-error" role="alert">@Model.Error</p>
}
@if (Model.Invite is not null)
{
    <p class="text-muted">You are invited as <strong>@Model.Invite.Email</strong> with the role(s) @string.Join(", ", Model.Invite.Roles).</p>
    <form method="post" class="auth-form" onsubmit="this.querySelector('button[type=submit]').disabled = true">
        <input type="hidden" asp-for="Token" />
        <input type="email" value="@Model.Invite.Email" autocomplete="username" readonly hidden />
        <label asp-for="DisplayName">Display name (optional)</label>
        <input asp-for="DisplayName" autocomplete="name" maxlength="100" />
        <label asp-for="Password">Password (at least 12 characters)</label>
        <input asp-for="Password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" autofocus />
        <button type="submit" class="btn btn-primary">Create account and sign in</button>
    </form>
}
