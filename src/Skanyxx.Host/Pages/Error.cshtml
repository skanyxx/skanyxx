@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<alert tone="error" title="Something went wrong">Skanyxx could not finish this request. Try again; if it keeps happening, tell the owner the request ID below.</alert>

@if (Model.ShowRequestId)
{
    <dl class="kv">
        <dt>Request ID</dt><dd><code>@Model.RequestId</code></dd>
    </dl>
}

<details class="details-admin mt-3">
    <summary>Details for administrators</summary>
    <p>The Development environment shows the error itself (set <code>ASPNETCORE_ENVIRONMENT</code> to <code>Development</code> and restart).
        Never enable it on a deployed install: it can show sensitive information from exceptions to anyone.</p>
</details>
