@page
@model Skanyxx.Host.Pages.ToolServersModel
@{
    ViewData["Title"] = "Tool servers";
}
<page-header description="Tool servers give agents abilities, like reading tickets or searching a wiki. Each lists the tools kagent found on it.">
    <button class="btn btn-secondary" id="btnRefresh" type="button"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-refresh"/></svg>Refresh</button>
    @if (Model.IsOwner)
    {
        <button class="btn btn-primary" id="btnAddServer" type="button"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"/></svg>Add tool server</button>
    }
</page-header>
@await Component.InvokeAsync("SetupGuide", new { id = "toolservers" })

<div class="toolbar" role="search">
    <div class="search">
        <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-search"/></svg>
        <input id="tsSearch" type="search" autocomplete="off" placeholder="Filter by server, tool name or description" aria-label="Filter servers and tools" />
    </div>
    <span class="spacer"></span>
    <span id="tsCount" class="text-muted text-sm" role="status" aria-live="polite"></span>
</div>

<div id="tsKagent"></div>
<div id="tsServers" aria-label="MCP tool servers"></div>

<details class="details-admin mt-3">
    <summary>Details for administrators</summary>
    <p>These are the Model Context Protocol servers kagent connects agents to. Skanyxx adds <strong>Remote MCP servers</strong>
        (Streamable HTTP or SSE); stdio MCPServers are listed, not managed here. kagent rediscovers every server's tools once a minute.</p>
</details>

@if (Model.IsOwner)
{
    <dialog class="dialog dialog-side" id="tsFormModal" aria-labelledby="tsFormTitle">
        <form id="tsForm" class="dialog-form" novalidate>
            <div class="dialog-header">
                <h2 class="dialog-title" id="tsFormTitle">Add tool server</h2>
                <button class="btn btn-ghost btn-icon" id="tsFormClose" type="button" aria-label="Close"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x"/></svg></button>
            </div>
            <div class="dialog-body">
                <div class="alert alert-error" id="tsFormErrors" role="alert" hidden></div>
                <div class="field">
                    <label for="tsKind">Type</label>
                    <select id="tsKind" name="kind">
                        <option value="RemoteMCPServer.kagent.dev">Remote MCP server (Streamable HTTP or SSE): supported</option>
                        <option value="MCPServer.kagent.dev" disabled>Stdio MCP server (MCPServer): not supported here, use kubectl or kmcp</option>
                    </select>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label for="tsName">Name</label>
                        <input type="text" id="tsName" required maxlength="63" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" placeholder="my-tool-server" autocomplete="off">
                    </div>
                    <div class="field">
                        <label for="tsNamespace">Namespace</label>
                        <input type="text" id="tsNamespace" value="kagent" required maxlength="63" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off">
                    </div>
                </div>
                <div class="field">
                    <label for="tsUrl">URL</label>
                    <input type="url" id="tsUrl" required maxlength="2048" placeholder="http://my-mcp.tools.svc.cluster.local:8080/mcp" autocomplete="off" aria-describedby="tsUrlHint tsUrlWarning">
                    <p class="field-hint" id="tsUrlHint">kagent's controller and agent pods call it: a cluster address, or host.docker.internal for a server on your machine (localhost is the pod itself).
                        No credentials in the URL: send them as a header.</p>
                    <p class="field-error" id="tsUrlWarning" hidden>This is a loopback address: inside the cluster it is the kagent pod, not your machine. Use host.docker.internal or a Service name.</p>
                </div>
                <div class="form-row">
                    <div class="field">
                        <label for="tsProtocol">Protocol</label>
                        <select id="tsProtocol">
                            <option value="STREAMABLE_HTTP">Streamable HTTP (usually /mcp)</option>
                            <option value="SSE">SSE (usually /sse)</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="tsTimeout">Timeout (seconds) <span class="field-optional">(optional)</span></label>
                        <input type="number" id="tsTimeout" min="1" max="600" placeholder="30">
                    </div>
                </div>
                <div class="field">
                    <label for="tsDescription">Description <span class="field-optional">(optional)</span></label>
                    <input type="text" id="tsDescription" maxlength="500" placeholder="What its tools are for">
                </div>
                <fieldset class="form-section ts-headers">
                    <legend>Headers</legend>
                    <p class="form-section-hint">Every header value lives in a Kubernetes Secret. A value typed here goes to kagent once, into a Secret it keeps with the server;
                        Skanyxx never stores or shows it, so an edit asks for it again.</p>
                    <div id="tsHeaderRows"></div>
                    <div><button class="btn btn-secondary btn-sm" id="tsAddHeader" type="button"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"/></svg>Add header</button></div>
                </fieldset>
            </div>
            <div class="dialog-footer">
                <button type="button" class="btn btn-secondary" id="tsFormCancel">Cancel</button>
                <button type="submit" class="btn btn-primary" id="tsFormSubmit">Save</button>
            </div>
        </form>
    </dialog>

    <dialog class="dialog" id="tsDeleteModal" aria-labelledby="tsDeleteTitle">
        <div class="dialog-header"><h2 class="dialog-title" id="tsDeleteTitle">Delete tool server</h2></div>
        <div class="dialog-body">
            <p id="tsDeleteText"></p>
            <div id="tsDeleteUsage" class="mt-2"></div>
            <div class="alert alert-error mt-2" id="tsDeleteErrors" role="alert" hidden></div>
        </div>
        <div class="dialog-footer">
            <button type="button" class="btn btn-secondary" id="tsDeleteCancel">Cancel</button>
            <button type="button" class="btn btn-danger" id="tsDeleteConfirm">Delete</button>
        </div>
    </dialog>
}

<script>
(function () {
    'use strict';

    var api = '/api/toolservers';
    var isOwner = @(Model.IsOwner ? "true" : "false");
    var overview = null;
    var loaded = false;
    var editing = null;
    var deleting = null;

    // Names, URLs, tool names and descriptions come from kagent and the MCP servers themselves: text, never markup.
    function el(tag, className, text) {
        var node = document.createElement(tag);
        if (className) node.className = className;
        if (text != null) node.textContent = text;
        return node;
    }

    function button(label, onClick, className) {
        var b = el('button', 'btn ' + (className || 'btn-secondary btn-sm'), label);
        b.type = 'button';
        b.addEventListener('click', onClick);
        return b;
    }

    function clear(node) { while (node.firstChild) node.removeChild(node.firstChild); }

    function problemText(body, status) {
        if (body && body.errors) return Object.keys(body.errors).reduce(function (all, k) { return all.concat(body.errors[k]); }, []);
        if (body && (body.message || body.detail)) return [body.message || body.detail];
        return ['The request failed (HTTP ' + status + ').'];
    }

    function send(method, url, body) {
        return fetch(url, {
            method: method,
            headers: body ? { 'Content-Type': 'application/json' } : {},
            body: body ? JSON.stringify(body) : undefined
        }).then(function (r) {
            return r.text().then(function (t) {
                var json = null;
                try { json = t ? JSON.parse(t) : null; } catch (e) { json = null; }
                return { ok: r.ok, status: r.status, body: json };
            });
        });
    }

    function load() {
        var box = document.getElementById('tsServers');
        if (!loaded) skx.state.loading(box, { rows: 4 });
        return send('GET', api).then(function (r) {
            if (!r.ok) throw new Error(problemText(r.body, r.status).join(' '));
            overview = r.body;
            loaded = true;
            render();
        }).catch(function (err) {
            if (loaded) { skx.toast('The tool servers could not be refreshed: ' + err.message, { tone: 'error' }); return; }
            document.getElementById('tsCount').textContent = '';
            skx.state.error(box, { title: 'The tool servers could not be loaded', detail: err.message, retry: load });
        });
    }

    function clearFilter() {
        document.getElementById('tsSearch').value = '';
        render();
        document.getElementById('tsSearch').focus();
    }

    function matches(server, q) {
        if (!q) return true;
        if (server.ref.toLowerCase().indexOf(q) >= 0) return true;
        return (server.tools || []).some(function (t) {
            return t.name.toLowerCase().indexOf(q) >= 0 || (t.description || '').toLowerCase().indexOf(q) >= 0;
        });
    }

    function render() {
        var kagentBox = document.getElementById('tsKagent');
        clear(kagentBox);
        if (!overview.kAgent.reachable) kagentBox.appendChild(skxSetupGuide.render(overview.kAgent.fix, { tone: 'danger', badge: 'not working' }));

        var q = document.getElementById('tsSearch').value.trim().toLowerCase();
        var shown = overview.servers.filter(function (s) { return matches(s, q); });
        var toolCount = shown.reduce(function (n, s) { return n + (s.tools ? s.tools.length : 0); }, 0);
        document.getElementById('tsCount').textContent = shown.length + ' server' + (shown.length === 1 ? '' : 's') + ' · ' + toolCount + ' tool' + (toolCount === 1 ? '' : 's') + (q ? ' (filtered)' : '');

        var box = document.getElementById('tsServers');
        clear(box);
        if (shown.length === 0) {
            if (q) skx.state.empty(box, { icon: 'i-search', title: 'No server or tool matches', body: 'Try another word.', action: { label: 'Clear filter', onClick: clearFilter } });
            else if (!overview.kAgent.reachable) skx.state.empty(box, { icon: 'i-server', title: 'No servers to list', body: 'kagent did not answer, so its servers are not listed. The guide above says what to check.' });
            else skx.state.empty(box, {
                icon: 'i-server', title: 'No tool servers yet', compact: false,
                body: 'Tool servers give agents abilities, like reading tickets or searching a wiki.' + (isOwner ? '' : ' The owner adds them.'),
                action: isOwner ? { label: 'Add tool server', onClick: function () { openForm(null); } } : undefined
            });
            return;
        }
        shown.forEach(function (s) { box.appendChild(card(s, q)); });
    }

    function badge(text, kind) { return el('span', 'badge badge-' + kind, text); }

    // One colour per state across Skanyxx: ready is green, unknown is neutral, missing is red, the rest amber.
    function statusKind(code) {
        return code === 'ready' ? 'success' : code === 'unknown' || code === 'stdio-unsupported' ? 'neutral' : code === 'not-registered' ? 'danger' : 'warning';
    }

    function card(s, q) {
        var root = el('section', 'card ts-server');
        root.setAttribute('data-ref', s.ref);
        root.setAttribute('aria-label', s.ref);
        var head = el('div', 'tile-head');
        var info = el('div');
        info.appendChild(el('h2', 'tile-title', s.ref));
        var badges = el('div', 'badges mt-1');
        var state = badge(s.status.text, statusKind(s.status.code));
        var dot = el('span', 'badge-dot');
        dot.setAttribute('aria-hidden', 'true');
        state.insertBefore(dot, state.firstChild);
        badges.appendChild(state);
        badges.appendChild(badge(s.kindLabel, s.supported ? 'neutral' : 'warning'));
        if (s.source === 'studio') badges.appendChild(badge('Studio', 'neutral'));
        if (s.source === 'other') badges.appendChild(badge('Not added here', 'neutral'));
        info.appendChild(badges);
        head.appendChild(info);

        var actions = el('div', 'form-actions');
        actions.appendChild(button('Refresh tools', function () { refresh(s.ref, this); }));
        if (s.canEdit) actions.appendChild(button('Edit', function () { openForm(s); }));
        if (s.canDelete) actions.appendChild(button('Delete', function () { openDelete(s); }, 'btn-danger-ghost btn-sm'));
        head.appendChild(actions);
        root.appendChild(head);

        var body = el('div', 'card-body mt-2');
        var meta = el('dl', 'kv');
        function row(k, v) { meta.appendChild(el('dt', null, k)); meta.appendChild(el('dd', null, v)); }
        row('Namespace', s.namespace);
        row('URL', s.url || (s.source === 'skanyxx' ? '' : 'not reported by kagent (added outside Skanyxx)'));
        if (s.protocol) row('Transport', s.protocol + (s.timeoutSeconds ? ' · timeout ' + s.timeoutSeconds + ' s' : ''));
        if (s.description) row('Description', s.description);
        if (s.headers.length) row('Headers', s.headers.map(function (h) {
            return h.name + (h.source === 'value' ? ' (value kept by kagent in Secret ' + h.secretName + ')' : ' (from Secret ' + h.secretName + ', key ' + h.secretKey + ')');
        }).join('; '));
        row('Used by', s.usedBy == null ? 'unknown (kagent did not list agents)' : s.usedBy.length ? s.usedBy.join(', ') : 'no agent');
        body.appendChild(meta);

        (s.fixes || []).forEach(function (fix) { body.appendChild(skxSetupGuide.render(fix, { badge: 'not working' })); });

        if (s.tools && s.tools.length) {
            var tools = el('details', 'details-admin');
            if (q) tools.open = true;
            tools.appendChild(el('summary', null, s.tools.length + ' tool' + (s.tools.length === 1 ? '' : 's')));
            var grid = el('div', 'card-grid');
            s.tools.forEach(function (t) {
                if (q && s.ref.toLowerCase().indexOf(q) < 0 && t.name.toLowerCase().indexOf(q) < 0 && (t.description || '').toLowerCase().indexOf(q) < 0) return;
                var tool = el('div', 'subcard');
                tool.appendChild(el('code', null, t.name));
                if (t.description) tool.appendChild(el('div', 'table-cell-sub', t.description));
                grid.appendChild(tool);
            });
            tools.appendChild(grid);
            body.appendChild(tools);
        }
        root.appendChild(body);
        return root;
    }

    function refresh(ref, btn) {
        skx.busy(btn, send('POST', api + '/' + ref.split('/').map(encodeURIComponent).join('/') + '/refresh')).then(function (r) {
            if (!r.ok) { skx.toast(ref + ': the tools could not be refreshed. ' + problemText(r.body, r.status).join(' '), { tone: 'error' }); return; }
            overview.servers = overview.servers.map(function (s) { return s.ref === ref ? r.body : s; });
            render();
        }).catch(function (err) {
            skx.toast(ref + ': the tools could not be refreshed. Skanyxx could not be reached: ' + err.message, { tone: 'error' });
        });
    }

    // --- Add / edit ---
    function headerRow(h) {
        var row = el('div', 'input-row ts-header-row');
        var name = el('input');
        name.placeholder = 'Header, e.g. Authorization';
        name.setAttribute('aria-label', 'Header name');
        name.className = 'ts-h-name';
        name.value = h ? h.name : '';
        var source = el('select', 'ts-h-source');
        source.setAttribute('aria-label', 'Where the value comes from');
        [['value', 'Enter the value'], ['secret', 'From an existing Secret']].forEach(function (o) {
            var opt = el('option', null, o[1]);
            opt.value = o[0];
            source.appendChild(opt);
        });
        source.value = h ? h.source : 'value';
        var value = el('input', 'ts-h-value');
        value.type = 'password';
        value.autocomplete = 'new-password';
        value.placeholder = h && h.source === 'value' ? 'Enter the value again' : 'Value (kept in a Secret)';
        value.setAttribute('aria-label', 'Header value');
        var secret = el('div', 'form-row');
        var secretName = el('input', 'ts-h-secret');
        secretName.placeholder = 'Secret name';
        secretName.setAttribute('aria-label', 'Secret name');
        secretName.value = h && h.source === 'secret' ? h.secretName : '';
        var secretKey = el('input', 'ts-h-key');
        secretKey.placeholder = 'Key';
        secretKey.setAttribute('aria-label', 'Key in the Secret');
        secretKey.value = h && h.source === 'secret' ? h.secretKey : '';
        secret.appendChild(secretName);
        secret.appendChild(secretKey);
        function sync() { value.hidden = source.value !== 'value'; secret.hidden = source.value !== 'secret'; }
        source.addEventListener('change', sync);
        sync();
        row.appendChild(name);
        row.appendChild(source);
        var cell = el('div');
        cell.appendChild(value);
        cell.appendChild(secret);
        row.appendChild(cell);
        row.appendChild(button('Remove', function () { row.remove(); }, 'btn-danger-ghost btn-sm'));
        document.getElementById('tsHeaderRows').appendChild(row);
    }

    function openForm(server) {
        editing = server || null;
        var form = document.getElementById('tsForm');
        form.reset();
        clear(document.getElementById('tsHeaderRows'));
        showErrors('tsFormErrors', []);
        document.getElementById('tsFormTitle').textContent = server ? 'Edit ' + server.ref : 'Add tool server';
        document.getElementById('tsName').disabled = !!server;
        document.getElementById('tsNamespace').disabled = !!server;
        if (server) {
            document.getElementById('tsName').value = server.name;
            document.getElementById('tsNamespace').value = server.namespace;
            document.getElementById('tsUrl').value = server.url || '';
            document.getElementById('tsProtocol').value = server.protocol || 'STREAMABLE_HTTP';
            document.getElementById('tsTimeout').value = server.timeoutSeconds || '';
            document.getElementById('tsDescription').value = server.description || '';
            server.headers.forEach(headerRow);
        }
        warnUrl();
        document.getElementById('tsFormModal').showModal();
        document.getElementById(server ? 'tsUrl' : 'tsName').focus();
    }

    function closeModal(id) { document.getElementById(id).close(); }

    function showErrors(id, list) {
        var box = document.getElementById(id);
        clear(box);
        list.forEach(function (m) { box.appendChild(el('div', null, m)); });
        box.hidden = list.length === 0;
    }

    function warnUrl() {
        var host = '';
        try { host = new URL(document.getElementById('tsUrl').value).hostname; } catch (e) { host = ''; }
        document.getElementById('tsUrlWarning').hidden = !/^(localhost|127\.|0\.0\.0\.0$|\[::1?\]$)/.test(host);
    }

    function formBody() {
        var timeout = document.getElementById('tsTimeout').value;
        return {
            name: document.getElementById('tsName').value.trim(),
            namespace: document.getElementById('tsNamespace').value.trim(),
            url: document.getElementById('tsUrl').value.trim(),
            protocol: document.getElementById('tsProtocol').value,
            timeoutSeconds: timeout ? Number(timeout) : null,
            description: document.getElementById('tsDescription').value.trim(),
            headers: Array.prototype.map.call(document.querySelectorAll('#tsHeaderRows .ts-header-row'), function (row) {
                var source = row.querySelector('.ts-h-source').value;
                return {
                    name: row.querySelector('.ts-h-name').value.trim(),
                    source: source,
                    value: source === 'value' ? row.querySelector('.ts-h-value').value : null,
                    secretName: source === 'secret' ? row.querySelector('.ts-h-secret').value.trim() : null,
                    secretKey: source === 'secret' ? row.querySelector('.ts-h-key').value.trim() : null
                };
            })
        };
    }

    function submitForm(e) {
        e.preventDefault();
        if (!document.getElementById('tsForm').reportValidity()) return;
        var submit = document.getElementById('tsFormSubmit');
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
        var body = formBody();
        var request = editing
            ? send('PUT', api + '/' + encodeURIComponent(editing.namespace) + '/' + encodeURIComponent(editing.name), body)
            : send('POST', api, body);
        var saved = editing ? 'Saved ' + editing.ref + '.' : 'Added ' + body.namespace + '/' + body.name + '.';
        request.then(function (r) {
            submit.disabled = false;
            submit.removeAttribute('aria-busy');
            if (!r.ok) { showErrors('tsFormErrors', problemText(r.body, r.status)); if (r.status === 502) load(); return; }
            // Typed header values leave the page with the request; nothing keeps them.
            clear(document.getElementById('tsHeaderRows'));
            closeModal('tsFormModal');
            skx.toast(saved);
            load();
        }).catch(function (err) {
            submit.disabled = false;
            submit.removeAttribute('aria-busy');
            showErrors('tsFormErrors', ['Skanyxx could not be reached: ' + err.message]);
        });
    }

    // --- Delete ---
    function openDelete(server) {
        deleting = server;
        showErrors('tsDeleteErrors', []);
        document.getElementById('tsDeleteText').textContent = 'Delete ' + server.ref + ' from kagent? Its companion Secrets go with it.';
        var usage = document.getElementById('tsDeleteUsage');
        clear(usage);
        if (server.usedBy == null || server.usedBy.length) {
            var box = el('div', 'alert alert-warning');
            box.appendChild(skx.icon('i-alert-triangle'));
            var warn = el('div', 'alert-body');
            box.appendChild(warn);
            warn.appendChild(el('div', 'alert-title', server.usedBy == null
                ? 'kagent did not say which agents use this server.'
                : 'In use by ' + server.usedBy.length + ' agent' + (server.usedBy.length === 1 ? '' : 's') + ': ' + server.usedBy.join(', ')));
            warn.appendChild(el('p', null, 'They lose its tools until it is added again or their tool list is changed on the Agents page.'));
            usage.appendChild(box);
        }
        document.getElementById('tsDeleteConfirm').textContent = server.usedBy && server.usedBy.length === 0 ? 'Delete' : 'Delete anyway';
        document.getElementById('tsDeleteModal').showModal();
    }

    function confirmDelete() {
        var s = deleting;
        var confirmInUse = !(s.usedBy && s.usedBy.length === 0);
        // Busy until kagent answers, so a double click sends one DELETE.
        skx.busy(document.getElementById('tsDeleteConfirm'),
            send('DELETE', api + '/' + encodeURIComponent(s.namespace) + '/' + encodeURIComponent(s.name) + (confirmInUse ? '?confirmInUse=true' : ''))).then(function (r) {
            if (!r.ok) { showErrors('tsDeleteErrors', problemText(r.body, r.status)); return; }
            closeModal('tsDeleteModal');
            skx.toast('Deleted ' + s.ref + '.');
            load();
        }).catch(function (err) {
            showErrors('tsDeleteErrors', ['Skanyxx could not be reached: ' + err.message]);
        });
    }

    function init() {
        document.getElementById('btnRefresh').addEventListener('click', load);
        document.getElementById('tsSearch').addEventListener('input', function () { if (overview) render(); });
        if (isOwner) {
            document.getElementById('btnAddServer').addEventListener('click', function () { openForm(null); });
            document.getElementById('tsFormClose').addEventListener('click', function () { closeModal('tsFormModal'); });
            document.getElementById('tsFormCancel').addEventListener('click', function () { closeModal('tsFormModal'); });
            document.getElementById('tsForm').addEventListener('submit', submitForm);
            document.getElementById('tsAddHeader').addEventListener('click', function () { headerRow(null); });
            document.getElementById('tsUrl').addEventListener('input', warnUrl);
            document.getElementById('tsDeleteCancel').addEventListener('click', function () { closeModal('tsDeleteModal'); });
            document.getElementById('tsDeleteConfirm').addEventListener('click', confirmDelete);
        }
        load();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
