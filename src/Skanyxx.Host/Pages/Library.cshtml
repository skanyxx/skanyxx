@page
@model LibraryModel
@using Skanyxx.Core.Platform.Memory
@{
    ViewData["Title"] = "Library";
    var searching = !string.IsNullOrWhiteSpace(Model.Q) || !string.IsNullOrEmpty(Model.Filter);
}
<page-header description="Company knowledge as cards: what was decided and why. You see company cards, your own, and your teams' and departments'." />
@if (Model.Error is not null && Model.ShelfLoaded)
{
    <alert tone="error">@Model.Error</alert>
}
@if (Model.Message is not null)
{
    <alert tone="success">@Model.Message</alert>
}

@await Component.InvokeAsync("SetupGuide", new { id = "library" })
@await Component.InvokeAsync("SetupGuide", new { id = "memory" })

<form method="get" class="toolbar" role="search">
    <div class="search">
        <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-search"/></svg>
        <input type="search" name="q" value="@Model.Q" placeholder="Search, e.g. refund window" maxlength="@CardFormat.MaxQueryLength" aria-label="Search" autocomplete="off" />
    </div>
    <select name="filter" aria-label="Scope">
        <option value="">All scopes I can read</option>
        @foreach (var scope in Model.Shelf.Scopes)
        {
            <option value="@scope" selected="@(scope == Model.Filter)">@Model.ScopeLabel(scope)</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
    @if (searching)
    {
        <a class="btn btn-ghost" asp-page="/Library">Clear</a>
    }
</form>

@if (!Model.ShelfLoaded)
{
    <div class="card">
        <error-state title="The library could not be loaded" detail="@Model.Error" />
    </div>
}
else if (Model.Shelf.Cards.Count == 0)
{
    <div class="card">
        @if (searching)
        {
            <empty-state icon="i-search" title="@(string.IsNullOrWhiteSpace(Model.Q) ? "No cards in this scope" : $"Nothing matches “{Model.Q}”")">
                <p>Try other words or another scope.</p>
                <div class="empty-state-actions"><a class="btn btn-secondary" asp-page="/Library">Clear search</a></div>
            </empty-state>
        }
        else
        {
            <empty-state icon="i-library" title="No cards yet">
                <p>Cards appear as agents and people record decisions. Ask in Chat, and the agent saves what was decided and why.</p>
            </empty-state>
        }
    </div>
}
else
{
    <div class="card card-flush">
        <div class="table-container">
            <table class="table table-stack">
                <thead>
                    <tr><th scope="col">What</th><th scope="col">Key</th><th scope="col">Scope</th><th scope="col">Type</th><th scope="col">Who</th><th scope="col">Updated</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Shelf.Cards)
                    {
                        var open = Model.Opened?.Card is { } o && o.Scope == entry.Scope && o.Key == entry.Key;
                        <tr class="@(open ? "is-selected" : null)">
                            <td>
                                <a asp-page="/Library" asp-route-scope="@entry.Scope" asp-route-key="@entry.Key"
                                   asp-route-q="@Model.Q" asp-route-filter="@Model.Filter">@entry.What</a>
                                <span class="table-cell-sub clamp-2">@entry.Why</span>
                            </td>
                            <td><code>@entry.Key</code></td>
                            <td><span class="badge badge-neutral">@Model.ScopeLabel(entry.Scope)</span></td>
                            <td>
                                @entry.Type
                                @if (entry.Status != "published")
                                {
                                    <status-badge status="@entry.Status" />
                                }
                            </td>
                            <td>@Model.WhoLabel(entry.Who)</td>
                            <td class="nowrap"><time data-relative datetime="@entry.UpdatedAt.ToString("O")" title="@entry.UpdatedAt.ToString("u")">@entry.UpdatedAt.ToString("yyyy-MM-dd")</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Shelf.Cards.Count == LibraryShelf.Limit)
        {
            <div class="table-footer">Showing the first @LibraryShelf.Limit; narrow the search to see others.</div>
        }
    </div>
}

@if (Model.Opened is { } opened)
{
    var card = opened.Card;
    @* A side panel over the list (the list stays where it was); closing it goes back to the list's own address. *@
    <dialog class="dialog dialog-side" id="card" data-autoshow aria-labelledby="card-title">
        <div class="dialog-header">
            <div>
                <h2 class="dialog-title" id="card-title">@card.What</h2>
                <p class="dialog-subtitle"><span class="badge badge-neutral">@card.Type</span>
                    @if (card.Status != "published")
                    {
                        <status-badge status="@card.Status" />
                    }
                </p>
            </div>
            <a class="btn btn-ghost btn-icon" asp-page="/Library" asp-route-q="@Model.Q" asp-route-filter="@Model.Filter" aria-label="Close"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x"/></svg></a>
        </div>
        <div class="dialog-body">
            <section>
                <h3 class="section-title">Why</h3>
                <p>@card.Why</p>
            </section>
            <dl class="kv">
                <dt>Scope</dt><dd>@Model.ScopeLabel(card.Scope)</dd>
                <dt>Key</dt><dd><code>@card.Key</code></dd>
                <dt>Version</dt><dd>@card.Version</dd>
                <dt>By</dt><dd>@Model.WhoLabel(card.Who)</dd>
                <dt>Updated</dt><dd><time data-relative datetime="@card.UpdatedAt.ToString("O")" title="@card.UpdatedAt.ToString("u")">@card.UpdatedAt.ToString("u")</time></dd>
                @if (opened.LiftedFrom is not null)
                {
                    <dt>Lifted from</dt><dd><code>@opened.LiftedFrom</code></dd>
                }
                else if (card.LiftedFromId is not null)
                {
                    <dt>Lifted from</dt><dd>A card you cannot open.</dd>
                }
                @if (card.Source is not null)
                {
                    <dt>Source</dt><dd><code>@card.Source</code></dd>
                }
            </dl>
            @if (card.Body is not null)
            {
                <section>
                    <h3 class="section-title mb-1">Body</h3>
                    <pre class="text-block tall">@card.Body</pre>
                    @if (card.BodyStored)
                    {
                        @* The excerpt Postgres keeps; the full text is streamed from the object store by the memory API (D183). *@
                        <p class="mt-1"><a href="@Url.Content($"~/api/memory/cards/{Uri.EscapeDataString(card.Scope)}/{Uri.EscapeDataString(card.Key)}/body")" target="_blank" rel="noopener" data-full-body>Open the full body</a></p>
                    }
                </section>
            }
            @if (opened.LiftTargets.Count > 0)
            {
                <section>
                    <h3 class="section-title">Lift a copy</h3>
                    <p class="section-description mb-1">Copies the card up a level, where more people see it. The original stays.</p>
                    <div class="form-actions">
                        @foreach (var target in opened.LiftTargets)
                        {
                            <form method="post" asp-page-handler="Lift" asp-route-scope="@card.Scope" asp-route-key="@card.Key"
                                  asp-route-q="@Model.Q" asp-route-filter="@Model.Filter"
                                  data-confirm="Everyone who reads @Model.ScopeLabel(target) will see the copy. The original stays where it is."
                                  data-confirm-title="Lift a copy to @Model.ScopeLabel(target)?" data-confirm-action="Lift">
                                <input type="hidden" name="target" value="@target" />
                                <button type="submit" class="btn btn-secondary" data-lift="@target">@Model.ScopeLabel(target)</button>
                            </form>
                        }
                    </div>
                </section>
            }
            @if (opened.CanRename)
            {
                <section>
                    <h3 class="section-title mb-1">Rename the key</h3>
                    <form method="post" asp-page-handler="Rename" asp-route-scope="@card.Scope" asp-route-key="@card.Key"
                          asp-route-q="@Model.Q" asp-route-filter="@Model.Filter" class="inline-form">
                        <input type="hidden" name="version" value="@card.Version" />
                        <input name="newKey" value="@card.Key" required maxlength="@CardFormat.MaxKeyLength" pattern="@CardFormat.KeyPattern" aria-label="New key" autocomplete="off" />
                        <button type="submit" class="btn btn-secondary" data-rename="@card.Key">Rename key</button>
                    </form>
                </section>
            }
        </div>
    </dialog>
}
