@page
@model LibraryModel
@using Skanyxx.Core.Platform.Memory
@{
    ViewData["Title"] = "Library";
    var searching = Model.Filtered;
    var shelf = Model.Shelf;
    var types = new[] { "decision", "fact", "procedure", "open" };
    var sortLabels = new Dictionary<string, string> { ["relevance"] = "Best match", ["newest"] = "Newest first", ["oldest"] = "Oldest first", ["what"] = "Title A–Z" };
}
<page-header description="Company knowledge as cards: what was decided and why. You see company cards, your own, and your teams' and departments'." />
@if (Model.Error is not null && Model.ShelfLoaded)
{
    <alert tone="error">@Model.Error</alert>
}
@if (Model.Message is not null)
{
    <alert tone="success">@Model.Message</alert>
}

@await Component.InvokeAsync("SetupGuide", new { id = "library" })
@await Component.InvokeAsync("SetupGuide", new { id = "memory" })

<form method="get" class="card form library-filters" role="search" aria-label="Filter the library">
    <div class="toolbar">
        <div class="search">
            <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-search"/></svg>
            <input type="search" name="q" value="@Model.Q" placeholder="Search, e.g. refund window" maxlength="@CardFormat.MaxQueryLength" aria-label="Search" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
        @if (searching)
        {
            <a class="btn btn-ghost" asp-page="/Library" asp-route-sort="@Model.Sort">Clear filters</a>
        }
    </div>
    <div class="form-row">
        <field for="lib-scope" label="Scope or team">
            <select id="lib-scope" name="filter">
                <option value="">All scopes I can read</option>
                @foreach (var scope in shelf.Scopes)
                {
                    <option value="@scope" selected="@(scope == Model.Filter)">@Model.ScopeLabel(scope)</option>
                }
            </select>
        </field>
        <field for="lib-type" label="Type">
            <select id="lib-type" name="type">
                <option value="">Any type</option>
                @foreach (var type in types)
                {
                    <option value="@type" selected="@(type == Model.Type)">@type</option>
                }
            </select>
        </field>
        <field for="lib-tag" label="Tag">
            <input id="lib-tag" name="tag" value="@Model.Tag" placeholder="e.g. refunds" maxlength="64" autocomplete="off" />
        </field>
        <field for="lib-ticket" label="Ticket">
            <input id="lib-ticket" name="ticket" value="@Model.Ticket" placeholder="e.g. SDB-58" maxlength="40" autocomplete="off" />
        </field>
        <field for="lib-agent" label="Written via agent">
            <input id="lib-agent" name="agent" value="@Model.Agent" placeholder="e.g. seed" maxlength="64" autocomplete="off" />
        </field>
        <field for="lib-origin" label="Came from">
            <select id="lib-origin" name="origin">
                <option value="">Anywhere</option>
                @foreach (var (value, label) in new[] { ("manual", "Written by hand"), ("chat", "A chat"), ("run", "A run or investigation") })
                {
                    <option value="@value" selected="@(Model.Origin == value)">@label</option>
                }
            </select>
        </field>
        <field for="lib-owner" label="Last written by">
            <select id="lib-owner" name="owner">
                <option value="">Anyone</option>
                <option value="@Model.MyId" selected="@(Model.Owner is not null && Model.Owner == Model.MyId)">Me</option>
                @if (!string.IsNullOrEmpty(Model.Owner) && Model.Owner != Model.MyId)
                {
                    <option value="@Model.Owner" selected>@Model.Owner</option>
                }
            </select>
        </field>
        <field for="lib-from" label="Updated from">
            <input id="lib-from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </field>
        <field for="lib-to" label="Updated to">
            <input id="lib-to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </field>
        <field for="lib-sort" label="Sort">
            <select id="lib-sort" name="sort">
                @foreach (var (value, label) in sortLabels)
                {
                    <option value="@value" selected="@((Model.Sort ?? "relevance") == value)">@label</option>
                }
            </select>
        </field>
    </div>
    <div class="form-actions"><button type="submit" class="btn btn-secondary">Apply filters</button></div>
</form>

@if (Model.ShelfLoaded)
{
    <div class="chips mt-2" role="group" aria-label="Filter by type" data-type-counts>
        <a class="chip" asp-page="/Library" asp-all-route-data="@Model.ListState(("type", null))" aria-current="@(string.IsNullOrEmpty(Model.Type) ? "true" : null)">
            All <span class="chip-count">@((shelf.TypeCounts ?? new Dictionary<string, int>()).Values.Sum())</span>
        </a>
        @foreach (var type in types)
        {
            <a class="chip" asp-page="/Library" asp-all-route-data="@Model.ListState(("type", type))" aria-current="@(Model.Type == type ? "true" : null)" data-type="@type">
                @type <span class="chip-count">@(shelf.TypeCounts?.GetValueOrDefault(type) ?? 0)</span>
            </a>
        }
    </div>
}

@if (!Model.ShelfLoaded)
{
    <div class="card">
        <error-state title="The library could not be loaded" detail="@Model.Error" />
    </div>
}
else if (Model.Shelf.Cards.Count == 0)
{
    <div class="card">
        @if (searching)
        {
            <empty-state icon="i-search" title="@(string.IsNullOrWhiteSpace(Model.Q) ? "No cards match these filters" : $"Nothing matches “{Model.Q}”")">
                <p>Try other words, another scope or fewer filters.</p>
                <div class="empty-state-actions"><a class="btn btn-secondary" asp-page="/Library">Clear search</a></div>
            </empty-state>
        }
        else
        {
            <empty-state icon="i-library" title="No cards yet">
                <p>Cards appear as agents and people record decisions. Ask in Chat, and the agent saves what was decided and why.</p>
            </empty-state>
        }
    </div>
}
else
{
    <div class="card card-flush">
        <div class="table-container">
            <table class="table table-stack">
                <thead>
                    <tr><th scope="col">What</th><th scope="col">Key</th><th scope="col">Scope</th><th scope="col">Type</th><th scope="col">Who</th><th scope="col">Updated</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Shelf.Cards)
                    {
                        var open = Model.Opened?.Card is { } o && o.Scope == entry.Scope && o.Key == entry.Key;
                        <tr class="@(open ? "is-selected" : null)">
                            <td>
                                <a asp-page="/Library" asp-all-route-data="@Model.ListState()" asp-route-scope="@entry.Scope" asp-route-key="@entry.Key">@entry.What</a>
                                <span class="table-cell-sub clamp-2">@entry.Why</span>
                            </td>
                            <td><code>@entry.Key</code></td>
                            <td><span class="badge badge-neutral">@Model.ScopeLabel(entry.Scope)</span></td>
                            <td>
                                @entry.Type
                                @if (entry.Status != "published")
                                {
                                    <status-badge status="@entry.Status" />
                                }
                            </td>
                            <td><a asp-page="/Library" asp-all-route-data="@Model.ListState(("owner", entry.Who))" title="Only cards last written by @Model.WhoLabel(entry.Who)">@Model.WhoLabel(entry.Who)</a></td>
                            <td class="nowrap"><time data-relative datetime="@entry.UpdatedAt.ToString("O")" title="@entry.UpdatedAt.ToString("u")">@entry.UpdatedAt.ToString("yyyy-MM-dd")</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="table-footer pager" aria-label="Pages" data-pager>
            <span data-range>@(shelf.Offset + 1)–@(shelf.Offset + shelf.Cards.Count) of @shelf.Total.ToString("N0")</span>
            <span class="pager-links">
                @if (shelf.Offset > 0)
                {
                    <a class="btn btn-secondary btn-sm" rel="prev" asp-page="/Library" asp-all-route-data="@Model.ListState(("offset", Math.Max(0, shelf.Offset - LibraryShelf.Limit).ToString()))">Previous</a>
                }
                @if (shelf.HasMore && shelf.Offset + LibraryShelf.Limit <= LibraryFilter.MaxOffset)
                {
                    <a class="btn btn-secondary btn-sm" rel="next" asp-page="/Library" asp-all-route-data="@Model.ListState(("offset", (shelf.Offset + LibraryShelf.Limit).ToString()))">Next</a>
                }
            </span>
        </nav>
    </div>
}

@if (Model.Opened is { } opened)
{
    var card = opened.Card;
    @* A side panel over the list (the list stays where it was); closing it goes back to the list's own address. *@
    <dialog class="dialog dialog-side" id="card" data-autoshow aria-labelledby="card-title">
        <div class="dialog-header">
            <div>
                <h2 class="dialog-title" id="card-title">@card.What</h2>
                <p class="dialog-subtitle"><span class="badge badge-neutral">@card.Type</span>
                    @if (card.Status != "published")
                    {
                        <status-badge status="@card.Status" />
                    }
                </p>
            </div>
            <a class="btn btn-ghost btn-icon" asp-page="/Library" asp-all-route-data="@Model.ListState()" aria-label="Close"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-x"/></svg></a>
        </div>
        <div class="dialog-body">
            <section>
                <h3 class="section-title">Why</h3>
                <p>@card.Why</p>
            </section>
            <dl class="kv">
                <dt>Scope</dt><dd>@Model.ScopeLabel(card.Scope)</dd>
                <dt>Key</dt><dd><code>@card.Key</code></dd>
                <dt>Version</dt><dd>@card.Version</dd>
                <dt>By</dt><dd>@Model.WhoLabel(card.Who)</dd>
                <dt>Updated</dt><dd><time data-relative datetime="@card.UpdatedAt.ToString("O")" title="@card.UpdatedAt.ToString("u")">@card.UpdatedAt.ToString("u")</time></dd>
                @if (opened.LiftedFrom is not null)
                {
                    <dt>Lifted from</dt><dd><code>@opened.LiftedFrom</code></dd>
                }
                else if (card.LiftedFromId is not null)
                {
                    <dt>Lifted from</dt><dd>A card you cannot open.</dd>
                }
                @if (card.Source is not null)
                {
                    <dt>Source</dt><dd><code>@card.Source</code></dd>
                }
            </dl>
            @if (card.Body is not null)
            {
                <section>
                    <h3 class="section-title mb-1">Body</h3>
                    <pre class="text-block tall">@card.Body</pre>
                    @if (card.BodyStored)
                    {
                        @* The excerpt Postgres keeps; the full text is streamed from the object store by the memory API (D183). *@
                        <p class="mt-1"><a href="@Url.Content($"~/api/memory/cards/{Uri.EscapeDataString(card.Scope)}/{Uri.EscapeDataString(card.Key)}/body")" target="_blank" rel="noopener" data-full-body>Open the full body</a></p>
                    }
                </section>
            }
            @if (opened.LiftTargets.Count > 0)
            {
                <section>
                    <h3 class="section-title">Lift a copy</h3>
                    <p class="section-description mb-1">Copies the card up a level, where more people see it. The original stays.</p>
                    <div class="form-actions">
                        @foreach (var target in opened.LiftTargets)
                        {
                            <form method="post" asp-page-handler="Lift" asp-route-scope="@card.Scope" asp-route-key="@card.Key"
                                  asp-all-route-data="@Model.ListState()"
                                  data-confirm="Everyone who reads @Model.ScopeLabel(target) will see the copy. The original stays where it is."
                                  data-confirm-title="Lift a copy to @Model.ScopeLabel(target)?" data-confirm-action="Lift">
                                <input type="hidden" name="target" value="@target" />
                                <button type="submit" class="btn btn-secondary" data-lift="@target">@Model.ScopeLabel(target)</button>
                            </form>
                        }
                    </div>
                </section>
            }
            @if (opened.CanRename)
            {
                <section>
                    <h3 class="section-title mb-1">Rename the key</h3>
                    <form method="post" asp-page-handler="Rename" asp-route-scope="@card.Scope" asp-route-key="@card.Key"
                          asp-all-route-data="@Model.ListState()" class="inline-form">
                        <input type="hidden" name="version" value="@card.Version" />
                        <input name="newKey" value="@card.Key" required maxlength="@CardFormat.MaxKeyLength" pattern="@CardFormat.KeyPattern" aria-label="New key" autocomplete="off" />
                        <button type="submit" class="btn btn-secondary" data-rename="@card.Key">Rename key</button>
                    </form>
                </section>
            }
        </div>
    </dialog>
}
