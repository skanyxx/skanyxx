@page "{namespace?}/{agent?}/{session?}"
@model Skanyxx.Host.Pages.ChatModel
@{
    ViewData["Title"] = "Chat";
}
<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

@* The route says what to open (agent, conversation); chat.js asks the API, which decides whether the caller may. *@
<div class="chat-app" id="chatApp"
     data-namespace="@Model.Namespace" data-agent="@Model.Agent" data-session="@Model.Session">

    <!-- Left: agent picker, new chat, the person's own conversations by agent and date -->
    <aside class="chat-side" id="chatSide" aria-label="Agents and conversations">
        <button type="button" class="agent-switch" id="agentSwitch" aria-haspopup="dialog" title="Choose an agent">
            <span class="agent-switch-avatar" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M12 8V4M8 14h.01M16 14h.01"/></svg>
            </span>
            <span class="agent-switch-text">
                <span class="agent-switch-name" id="agentName">Choose an agent</span>
                <span class="agent-switch-model" id="agentModel"></span>
            </span>
            <svg class="agent-switch-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <button type="button" class="btn btn-primary new-chat" id="newChat">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            New chat
        </button>
        <input type="search" class="form-control session-search" id="sessionSearch" placeholder="Search your chats" aria-label="Search your chats" />
        <nav class="session-list" id="sessionList" aria-label="Your chats"></nav>
    </aside>

    <!-- Main: the conversation -->
    <section class="chat-main" aria-label="Conversation">
        <header class="chat-head">
            <button type="button" class="icon-btn side-toggle" id="sideToggle" aria-label="Show chats" title="Show chats">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <div class="chat-title">
                <h2 id="chatTitle">New chat</h2>
                <span class="chat-subtitle" id="chatSubtitle"></span>
            </div>
            <button type="button" class="usage-chip" id="usageChip" aria-expanded="false" aria-controls="usagePanel" title="Tokens in this chat">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
                <span id="usageChipText">0 tokens</span>
            </button>
            <button type="button" class="icon-btn" id="detailsToggle" aria-expanded="true" aria-controls="chatDetails" title="Agent details" aria-label="Agent details">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            </button>
        </header>

        <!-- Tokens: per message on each answer, per chat here. The quota hook (IChatQuota) refuses a turn with a 429 the page shows as is. -->
        <div class="usage-panel" id="usagePanel" hidden>
            <div class="stat-card"><span class="stat-label">Chat total</span><span class="stat-value" id="totalTokens">0</span></div>
            <div class="stat-card"><span class="stat-label">Input</span><span class="stat-value" id="promptTokens">0</span></div>
            <div class="stat-card"><span class="stat-label">Output</span><span class="stat-value" id="completionTokens">0</span></div>
            <div class="stat-card"><span class="stat-label">Est. Cost</span><span class="stat-value" id="estCost" title="No price is known for this agent's model">n/a</span></div>
            @* requirements.md §1.5, §3.5 (D273): wherever money appears, the disclaimer appears with it. *@
            <p class="cost-disclaimer" role="note">
                <strong>Cost is informational only, not accurate.</strong> Estimate only. Not accurate. For information only.
                Your provider's bill is authoritative. Skanyxx has no price for this agent's model, so the cost shows n/a.
            </p>
        </div>

        <!-- kagent unreachable or not configured: the cause, the fix, and instructions to hand on -->
        <div class="chat-problem" id="chatProblem" role="alert" hidden>
            <h3 id="problemTitle">Chat cannot reach the agents</h3>
            <p id="problemCause"></p>
            <ol class="problem-steps" id="problemSteps"></ol>
            <div class="problem-actions">
                @* MERGE: setup-guides ships a shared "Copy instructions for agent" component; swap this button and copyInstructions() in chat.js for it. *@
                <button type="button" class="btn btn-secondary" id="copyInstructions">Copy instructions for agent</button>
                <button type="button" class="btn btn-ghost" id="retryAgents">Try again</button>
                <span class="copy-done" id="copyDone" role="status"></span>
            </div>
        </div>

        <div class="chat-notice" id="chatNotice" role="status" hidden></div>

        <div class="chat-messages" id="chatMessages" aria-live="polite"></div>

        <!-- Sensitive data typed into the message: masked before sending unless the person turns it off -->
        <div class="security-warning" id="securityWarning" hidden>
            <div class="warning-content">
                <h4>Sensitive data detected</h4>
                <div class="warning-findings" id="warningFindings"></div>
                <label class="mask-checkbox">
                    <input type="checkbox" id="maskCheckbox" checked />
                    Auto-mask sensitive data before sending
                </label>
            </div>
            <button type="button" class="icon-btn" id="dismissWarning" aria-label="Dismiss">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>

        <form class="composer" id="composer" autocomplete="off">
            <div class="drop-hint" id="dropHint" hidden>Drop files to attach them</div>
            <div class="attachments" id="attachments"></div>
            <div class="composer-row">
                <button type="button" class="icon-btn" id="attachBtn" title="Attach files" aria-label="Attach files">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                </button>
                <input type="file" id="fileInput" multiple hidden />
                <textarea id="chatInput" class="chat-input" rows="1" aria-label="Message"
                          placeholder="Message the agent… (Shift+Enter for a new line)"></textarea>
                <button type="button" class="icon-btn" id="micBtn" aria-pressed="false" aria-label="Voice input">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/></svg>
                </button>
                <button type="submit" class="btn btn-primary send-btn" id="sendBtn" aria-label="Send">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    <span>Send</span>
                </button>
                <button type="button" class="btn btn-secondary stop-btn" id="stopBtn" hidden aria-label="Stop generating">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
                    <span>Stop</span>
                </button>
            </div>
            <div class="composer-foot">
                <span id="inputTokenCounter">~0 tokens</span>
                <span id="voiceStatus" role="status"></span>
            </div>
        </form>
    </section>

    <!-- Right: what the agent is and can reach -->
    <aside class="chat-details" id="chatDetails" aria-label="Agent details">
        <div class="details-head">
            <h3>Agent details</h3>
            <a class="details-link" id="detailsLink" href="/Agents">Open in Agents</a>
        </div>
        <div class="details-body" id="detailsBody"><p class="muted">Choose an agent to see what it can do.</p></div>
    </aside>
</div>

<dialog class="agent-picker" id="agentPicker" aria-labelledby="pickerTitle">
    <div class="picker-head">
        <h3 id="pickerTitle">Choose an agent</h3>
        <button type="button" class="icon-btn" id="pickerClose" aria-label="Close">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
    <input type="search" class="form-control" id="pickerSearch" placeholder="Search agents by name, model or description" aria-label="Search agents" />
    <div class="picker-grid" id="pickerGrid" role="listbox" aria-label="Agents"></div>
</dialog>

<script src="~/js/chat-markdown.js" asp-append-version="true"></script>
<script src="~/js/chat.js" asp-append-version="true"></script>
