@page
@model PluginsModel
@{
    ViewData["Title"] = "Plugins";
    var me = Model.Me;
}
<page-header description="Add ready-made integrations: remote tool servers and the agents that use them. Installing opens a proposal; nothing is live until a supervisor merges it in Studio.">
    <button type="button" class="btn btn-secondary" id="refresh"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-refresh"/></svg>Refresh</button>
    <a class="btn btn-primary" href="#add"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"/></svg>Add plugin</a>
</page-header>
@await Component.InvokeAsync("SetupGuide", new { id = "plugins" })

<div class="alert alert-warning" role="note" id="credential-note">
    <svg class="icon" aria-hidden="true" focusable="false"><use href="#i-alert-triangle"/></svg>
    <div class="alert-body">
        <div class="alert-title">Header values act for everyone</div>
        <p>A header value is the owner's credential at that service, and <strong>every chat user of the plugin's agents acts with it</strong>: enter a least-privilege token (read-only, one project), never a personal admin token.</p>
        <details class="details-admin mt-1">
            <summary>Learn more</summary>
            <p>Plugins are recipes only: they never get memory grants. Header secrets are entered here by the owner and never go to git.
                Values stay bound to the address (host, port and path) they were entered for; a new version that moves a server elsewhere keeps
                them with the running server until it is merged, then waits for them to be entered again.</p>
        </details>
    </div>
</div>

<section id="plugins" data-owner="@(me.IsOwner ? "true" : "false")" data-propose="@(me.CanPropose ? "true" : "false")">
    <div id="repo-problem" class="alert alert-error" role="alert" hidden></div>
    <div id="key-ring" class="alert alert-error" role="alert" hidden></div>

    <section class="section" aria-labelledby="installed-title">
        <div class="section-header"><h2 class="section-title" id="installed-title">Installed</h2></div>
        <div id="installed" class="stack"></div>
        @if (me.IsOwner)
        {
            <details class="details-admin mt-2" id="controller-egress">
                <summary>Details for administrators</summary>
                <p>kagent's controller connects to every plugin server, with its header values, to discover its tools. Skanyxx's Helm chart
                    fences that egress only with <code>networkPolicy.controllerEgress</code> (off by default); with your own kagent, fence its
                    controller yourself.</p>
            </details>
        }
    </section>

    <section class="section" aria-labelledby="open-title">
        <div class="section-header"><h2 class="section-title" id="open-title">Open plugin proposals</h2></div>
        <div class="card card-flush">
            <div class="table-container" id="open-table" hidden>
                <table class="table table-stack">
                    <thead><tr><th scope="col">#</th><th scope="col">Title</th><th scope="col">Plugin</th><th scope="col">Proposed by</th></tr></thead>
                    <tbody id="open-rows"></tbody>
                </table>
            </div>
            <div id="open-state"></div>
        </div>
    </section>

    <section class="section card" id="add" aria-labelledby="add-title">
        <div class="section-header"><h2 class="section-title" id="add-title">Add plugin</h2></div>
        <div class="tabs" role="tablist" aria-label="Plugin source">
            <button type="button" class="tab" role="tab" id="tab-catalog" aria-controls="panel-catalog" aria-selected="true">Catalog</button>
            @if (me.IsOwner)
            {
                <button type="button" class="tab" role="tab" id="tab-git" aria-controls="panel-git" aria-selected="false" tabindex="-1">Git URL + commit</button>
                <button type="button" class="tab" role="tab" id="tab-zip" aria-controls="panel-zip" aria-selected="false" tabindex="-1">Upload zip</button>
            }
        </div>

        <div id="panel-catalog" role="tabpanel" aria-labelledby="tab-catalog">
            <p class="section-description mb-1">Plugins bundled with Skanyxx.</p>
            <div id="catalog"></div>
        </div>
        @if (me.IsOwner)
        {
            <form id="panel-git" role="tabpanel" aria-labelledby="tab-git" class="form" hidden>
                <div class="field">
                    <label for="git-url">Repository</label>
                    <input id="git-url" required maxlength="2048" placeholder="https://github.com/owner/repo" autocomplete="off" aria-describedby="git-url-hint" />
                    <p class="field-hint" id="git-url-hint">https; github.com or a host in Plugins:GitHosts.</p>
                </div>
                <div class="field">
                    <label for="git-commit">Commit</label>
                    <input id="git-commit" required maxlength="40" pattern="[0-9a-f]{40}" autocomplete="off" spellcheck="false" aria-describedby="git-commit-hint" />
                    <p class="field-hint" id="git-commit-hint">The full 40-character SHA: a branch or tag can move after review.</p>
                </div>
                <div class="field">
                    <label for="git-path">Folder in the repository <span class="field-optional">(optional)</span></label>
                    <input id="git-path" maxlength="512" autocomplete="off" aria-describedby="git-path-hint" />
                    <p class="field-hint" id="git-path-hint">Empty = its root.</p>
                </div>
                <div class="form-actions"><button type="submit" class="btn btn-primary">Inspect</button></div>
            </form>
            <form id="panel-zip" role="tabpanel" aria-labelledby="tab-zip" class="form" hidden>
                <div class="field">
                    <label for="zip-file">Plugin zip</label>
                    <input id="zip-file" type="file" accept=".zip,application/zip" required aria-describedby="zip-file-hint" />
                    <p class="field-hint" id="zip-file-hint">At most 10 MB.</p>
                </div>
                <div class="field">
                    <label for="zip-path">Folder in the zip <span class="field-optional">(optional)</span></label>
                    <input id="zip-path" maxlength="512" autocomplete="off" aria-describedby="zip-path-hint" />
                    <p class="field-hint" id="zip-path-hint">Empty = its root.</p>
                </div>
                <div class="form-actions"><button type="submit" class="btn btn-primary">Inspect</button></div>
            </form>
        }
        <div id="result" class="mt-3" aria-live="polite"></div>
    </section>
</section>

<script>
(() => {
    const root = document.getElementById('plugins');
    const isOwner = root.dataset.owner === 'true';
    const canPropose = root.dataset.propose === 'true';
    const resultBox = document.getElementById('result');
    const base = '/api/plugins';

    // Values from the API are only ever set with textContent.
    const say = (box, text) => { box.textContent = text; box.hidden = !text; };
    const fail = text => skx.toast(text, { tone: 'error' });
    const done = text => skx.toast(text);

    // The shared client (js/ui.js): JSON or a FormData upload; problem+json becomes the error's message.
    const call = (method, path, body) => skx.api(method, path, body);
    let loaded = false;

    function el(tag, text, className) {
        const e = document.createElement(tag);
        if (text !== undefined && text !== null) e.textContent = text;
        if (className) e.className = className;
        return e;
    }

    function button(label, aria, action, className = 'btn btn-secondary btn-sm') {
        const b = el('button', label, className);
        b.type = 'button';
        b.setAttribute('aria-label', aria);
        b.addEventListener('click', action);
        return b;
    }

    function studioLink(number) {
        const a = el('a', `#${number}`);
        a.href = `/Studio?pr=${encodeURIComponent(number)}#proposal`;
        return a;
    }

    function table(headers, rows) {
        const t = el('table', null, 'table table-stack');
        const head = el('tr');
        for (const h of headers) {
            const th = el('th', h);
            th.scope = 'col';
            head.appendChild(th);
        }
        t.appendChild(el('thead')).appendChild(head);
        const body = t.appendChild(el('tbody'));
        for (const cells of rows) {
            const tr = body.appendChild(el('tr'));
            for (const c of cells) {
                const td = tr.appendChild(el('td'));
                if (c instanceof Node) td.appendChild(c); else td.textContent = c ?? '';
            }
        }
        skx.table.label(t);
        const wrap = el('div', null, 'table-container');
        wrap.appendChild(t);
        return wrap;
    }

    const stateText = {
        'deployed': 'deployed',
        'starting': 'starting (kagent has not discovered its tools yet; it retries within about a minute)',
        'needs-secret': 'needs secret',
        'pending': 'pending (the reconciler applies it)',
        'foreign': 'name taken in kagent (not created)',
        'invalid': 'invalid in main (skipped)'
    };

    const sourceText = s => !s ? '' : s.kind === 'git' ? `git ${s.location} at ${s.commit?.slice(0, 12)}${s.path ? ' /' + s.path : ''}` : `${s.kind} ${s.location}`;

    // Password inputs are built empty every time: a stored value is never sent to the page.
    function secretsForm(server) {
        const form = el('form', null, 'form');
        form.dataset.server = server.name;
        for (const h of server.headers) {
            const id = `secret-${server.name}-${h.name}`;
            const field = el('div', null, 'field');
            const label = el('label', `${h.name}${h.template ? ` (${h.template})` : ''}`);
            label.htmlFor = id;
            const input = el('input');
            input.type = 'password';
            input.id = id;
            input.name = h.name;
            input.autocomplete = 'off';
            input.maxLength = 4096;
            field.append(label, input);
            if (h.hasValue) field.append(el('p', 'A value is stored; leave empty to keep it.', 'field-hint'));
            form.append(field);
        }
        const save = el('button', 'Save values', 'btn btn-secondary');
        save.type = 'submit';
        form.appendChild(el('div', null, 'form-actions')).appendChild(save);
        form.addEventListener('submit', async event => {
            event.preventDefault();
            const values = {};
            for (const input of form.querySelectorAll('input[type=password]')) if (input.value) values[input.name] = input.value;
            if (Object.keys(values).length === 0) return fail('Enter at least one value.');
            try {
                const result = await skx.busy(save, call('PUT', `${base}/servers/${encodeURIComponent(server.name)}/secrets`, { values }));
                done(result.message);
            } catch (e) {
                fail(e.message);
            } finally {
                for (const input of form.querySelectorAll('input[type=password]')) input.value = '';
            }
            await load();
        });
        return form;
    }

    function callout(tone, text) {
        const box = el('div', null, `alert alert-${tone}`);
        box.setAttribute('role', tone === 'error' ? 'alert' : 'note');
        box.append(skx.icon(tone === 'error' ? 'i-alert-circle' : 'i-alert-triangle'), el('div', text, 'alert-body'));
        return box;
    }

    function renderPlugin(p) {
        const card = el('section', null, 'card');
        card.dataset.plugin = p.name;
        card.setAttribute('aria-label', p.name);
        const head = card.appendChild(el('div', null, 'card-header'));
        const title = head.appendChild(el('h3', null, 'card-title'));
        title.appendChild(el('code', p.name));
        title.append(` ${p.version ?? ''}`);
        const body = card.appendChild(el('div', null, 'card-body'));
        if (p.description) body.appendChild(el('p', p.description));
        if (p.source) body.appendChild(el('p', `From ${sourceText(p.source)}`, 'field-hint'));
        if (p.problem) body.appendChild(callout('error', `Not valid in main: ${p.problem}`));
        if (p.servers.length > 0) {
            body.appendChild(table(['Server', 'URL', 'State', 'Headers'], p.servers.map(s => {
                const state = skx.badge(s.state === 'deployed' ? 'ready' : s.state === 'invalid' || s.state === 'foreign' ? 'failed' : 'pending', stateText[s.state] ?? s.state);
                state.dataset.state = s.state;
                return [s.name, s.url, state, s.headers.map(h => `${h.name}${h.hasValue ? ' (value stored)' : ' (no value)'}`).join(', ')];
            })));
            if (isOwner) for (const s of p.servers.filter(s => s.headers.length > 0)) {
                const box = body.appendChild(el('div', null, 'subcard'));
                box.appendChild(el('h4', `Header values for ${s.name}`, 'text-sm'));
                box.appendChild(secretsForm(s));
            }
        }
        if (p.agents.length > 0)
            body.appendChild(table(['Agent', 'Description', 'In kagent'], p.agents.map(a => [a.name, a.description, skx.badge(a.live ? 'live' : 'pending', a.live ? 'live (merged)' : 'not live yet (waits for its servers)')])));
        for (const w of p.warnings ?? []) body.appendChild(callout('warning', w));
        if (p.notes.length > 0) {
            const details = el('details', null, 'details-admin');
            details.appendChild(el('summary', `Install report (${p.notes.length})`));
            details.appendChild(table(['Item', 'Status', 'Reason'], p.notes.map(n => [n.item, n.status, n.reason])));
            body.appendChild(details);
        }
        if (canPropose && !p.problem) body.appendChild(el('div', null, 'form-actions')).appendChild(button('Uninstall', `Uninstall ${p.name}`, async () => {
            if (!await skx.confirm({ title: `Propose removing ${p.name}?`, body: 'A supervisor merges it; then its agents and servers leave kagent.', confirm: 'Propose removal', danger: true })) return;
            try {
                const result = await call('POST', `${base}/${encodeURIComponent(p.name)}/uninstall`);
                done(result.message);
            } catch (e) {
                fail(e.message);
            }
            await load();
        }, 'btn btn-danger-ghost btn-sm'));
        return card;
    }

    async function load() {
        const installed = document.getElementById('installed');
        const openState = document.getElementById('open-state');
        if (!loaded) {
            skx.state.loading(installed, { rows: 3 });
            skx.state.loading(openState, { rows: 2 });
        }
        try {
            const overview = await call('GET', base);
            loaded = true;
            say(document.getElementById('repo-problem'), overview.repoProblem ?? '');
            say(document.getElementById('key-ring'), isOwner && overview.keyRingInClear
                ? 'Stored header values are protected by a key ring kept unencrypted in the identity database (Identity:DataProtectionCertificatePath is not set): '
                  + 'anyone who reads that database or its backup can decrypt them. Set a certificate before entering production credentials.'
                : '');
            if (overview.plugins.length > 0) installed.replaceChildren(...overview.plugins.map(renderPlugin));
            else if (overview.repoProblem) installed.replaceChildren();
            else {
                const box = el('div', null, 'card');
                installed.replaceChildren(box);
                skx.state.empty(box, { icon: 'i-puzzle', title: 'No plugins installed', body: 'Pick one from the catalog below: installing it opens a proposal for a supervisor.' });
            }
            const rows = document.getElementById('open-rows');
            rows.replaceChildren();
            for (const p of overview.open) {
                const tr = rows.appendChild(el('tr'));
                tr.appendChild(el('td')).appendChild(studioLink(p.number));
                tr.appendChild(el('td', p.title));
                tr.appendChild(el('td')).appendChild(el('code', p.plugin));
                tr.appendChild(el('td', p.proposedBy));
            }
            document.getElementById('open-table').hidden = overview.open.length === 0;
            if (overview.open.length === 0) skx.state.empty(openState, { icon: 'i-inbox', title: 'No open plugin proposals' });
            else openState.replaceChildren();
        } catch (e) {
            if (loaded) return fail(`The plugins could not be refreshed: ${e.message}`);
            skx.state.error(installed, { title: 'The plugins could not be loaded', detail: e.message, retry: load });
            openState.replaceChildren();
        }
    }

    // --- inspect and install ---

    let lastZip = null;

    async function inspect(target) {
        skx.state.loading(resultBox, { rows: 3 });
        try {
            const inspection = target.source === 'zip'
                ? await call('POST', `${base}/inspect/zip`, zipForm(target))
                : await call('POST', `${base}/inspect`, target);
            if (inspection.marketplace) showListing(inspection.marketplace, resultBox);
            else showReport(inspection.plugin, target);
        } catch (e) {
            skx.state.error(resultBox, { title: 'The plugin could not be read', detail: e.message, retry: () => inspect(target) });
        }
    }

    function zipForm(target) {
        const form = new FormData();
        form.append('file', lastZip);
        if (target.path) form.append('path', target.path);
        if (target.name) form.append('name', target.name);
        if (target.digest) form.append('digest', target.digest);
        return form;
    }

    function showListing(listing, into) {
        const box = el('div');
        box.appendChild(el('h3', listing.name, 'section-title'));
        if (listing.description) box.appendChild(el('p', listing.description, 'section-description mb-1'));
        if (listing.entries.length === 0) {
            into.replaceChildren(box);
            const empty = box.appendChild(el('div'));
            skx.state.empty(empty, { icon: 'i-puzzle', title: 'This source lists no plugins' });
            return;
        }
        box.appendChild(table(['Plugin', 'Description', 'Version', ''], listing.entries.map(e => [
            e.name, e.description, e.version ?? '',
            e.target ? button('Inspect', `Inspect ${e.name}`, () => inspect(e.target)) : el('span', `${e.problem.status}: ${e.problem.reason}`, 'text-muted')
        ])));
        into.replaceChildren(box);
    }

    function showReport(report, target) {
        const box = el('div', null, 'card stack');
        box.dataset.report = report.name;
        const title = box.appendChild(el('h3', null, 'card-title'));
        title.appendChild(el('code', report.name));
        title.append(` ${report.version ?? ''}`);
        if (report.description) box.appendChild(el('p', report.description));
        box.appendChild(el('p', `From ${sourceText(report.source)} · digest ${report.digest.slice(0, 16)}…`, 'field-hint'));
        const step = (n, heading) => box.appendChild(el('h4', `${n}. ${heading}`, 'section-title'));
        step(1, 'Servers it adds (remote MCP)');
        box.appendChild(report.servers.length === 0 ? el('p', 'None.', 'text-muted') : table(['Server', 'URL', 'Protocol', 'Headers'], report.servers.map(s =>
            [s.name, s.url, s.protocol, s.headers.map(h => `${h.name}: ${h.value ?? (h.template ? `owner enters ${h.template}` : '')}`).join('; ')])));
        if (report.servers.some(s => s.headers.length > 0))
            box.appendChild(callout('warning', 'Every chat user of these agents acts with the header values entered for these servers: use least-privilege tokens.'));
        step(2, 'Agents it adds');
        box.appendChild(report.agents.length === 0 ? el('p', 'None.', 'text-muted') : table(['Agent', 'Description', 'Tools'], report.agents.map(a =>
            [a.name, a.description, a.tools.map(t => t.tools.length === 0 ? `${t.server}: all tools` : `${t.server}: ${t.tools.join(', ')}`).join('; ')])));
        step(3, 'Changed, unsupported or refused');
        box.appendChild(report.notes.length === 0 ? el('p', 'Nothing: everything installs as it is.', 'text-muted') : table(['Item', 'Status', 'Reason'], report.notes.map(n => [n.item, n.status, n.reason])));
        if (canPropose && (target.source === 'catalog' || isOwner)) {
            const install = button('Install (opens a pull request)', `Install ${report.name}`, async () => {
                install.disabled = true;
                install.setAttribute('aria-busy', 'true');
                const request = { ...target, digest: report.digest };
                try {
                    const result = target.source === 'zip'
                        ? await call('POST', `${base}/install/zip`, zipForm(request))
                        : await call('POST', `${base}/install`, request);
                    const line = el('div', null, 'alert alert-success');
                    line.setAttribute('role', 'status');
                    const text = el('div', `${result.message} Review it on the Studio page: `, 'alert-body');
                    text.appendChild(studioLink(result.number));
                    line.append(skx.icon('i-check-circle'), text);
                    box.appendChild(line);
                    install.removeAttribute('aria-busy');
                } catch (e) {
                    fail(e.message);
                    install.disabled = false;
                    install.removeAttribute('aria-busy');
                }
                await load();
            }, 'btn btn-primary');
            box.appendChild(el('div', null, 'form-actions')).appendChild(install);
        }
        resultBox.replaceChildren(box);
    }

    // --- tabs ---

    const tabs = ['catalog', 'git', 'zip'].map(name => [document.getElementById(`tab-${name}`), document.getElementById(`panel-${name}`)]).filter(([t]) => t);
    for (const [tab] of tabs) tab.addEventListener('click', () => {
        for (const [other, panel] of tabs) {
            const on = other === tab;
            other.setAttribute('aria-selected', on ? 'true' : 'false');
            other.tabIndex = on ? 0 : -1;
            panel.hidden = !on;
        }
        resultBox.replaceChildren();
    });
    // Arrow keys move between tabs (the WAI-ARIA tabs pattern); Tab goes into the panel.
    document.querySelector('#add [role=tablist]').addEventListener('keydown', e => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const list = tabs.map(([t]) => t);
        const next = list[(list.indexOf(document.activeElement) + (e.key === 'ArrowRight' ? 1 : list.length - 1)) % list.length];
        next.focus();
        next.click();
    });

    async function loadCatalog() {
        const catalog = document.getElementById('catalog');
        skx.state.loading(catalog, { rows: 3 });
        try {
            showListing((await call('GET', `${base}/catalog`)).marketplace, catalog);
        } catch (e) {
            skx.state.error(catalog, { title: 'The catalog could not be loaded', detail: e.message, retry: loadCatalog });
        }
    }

    document.getElementById('panel-git')?.addEventListener('submit', event => {
        event.preventDefault();
        const path = document.getElementById('git-path').value.trim();
        inspect({ source: 'git', url: document.getElementById('git-url').value.trim(), commit: document.getElementById('git-commit').value.trim(), path: path || null });
    });
    document.getElementById('panel-zip')?.addEventListener('submit', event => {
        event.preventDefault();
        lastZip = document.getElementById('zip-file').files[0];
        if (!lastZip) return fail('Choose a zip file.');
        if (lastZip.size > 10 * 1024 * 1024) return fail('The zip is larger than 10 MB.');
        const path = document.getElementById('zip-path').value.trim();
        inspect({ source: 'zip', path: path || null });
    });
    document.getElementById('refresh').addEventListener('click', () => { load(); loadCatalog(); });
    load();
    loadCatalog();
})();
</script>
