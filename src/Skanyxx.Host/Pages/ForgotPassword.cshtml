@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
    Layout = "_AuthLayout";
}
@if (Model.Error is not null)
{
    <alert tone="error">@Model.Error</alert>
}
@if (Model.Message is not null)
{
    <alert tone="success">@Model.Message</alert>
}
<form method="post" class="form auth-form" data-once>
    <div class="field">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="username" required autofocus maxlength="256" />
    </div>
    <button type="submit" class="btn btn-primary">Email me a reset link</button>
</form>
<p class="field-hint">The owner's password is reset with the bootstrap token, and accounts that sign in with Microsoft reset nothing here.</p>
<p><a href="/Login">Back to sign in</a></p>
