@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
    Layout = "_AuthLayout";
}
@if (Model.Error is not null)
{
    <p class="text-error" role="alert">@Model.Error</p>
}
@if (Model.Message is not null)
{
    <p class="text-success" role="status">@Model.Message</p>
}
<form method="post" class="auth-form" onsubmit="this.querySelector('button[type=submit]').disabled = true">
    <label asp-for="Email">Email</label>
    <input asp-for="Email" type="email" autocomplete="username" required autofocus maxlength="256" />
    <button type="submit" class="btn btn-primary">Email me a reset link</button>
</form>
<p class="text-muted">The owner's password is reset with the bootstrap token, and accounts that sign in with Microsoft reset nothing here.</p>
<p><a href="/Login">Back to sign in</a></p>
