@page
@model Skanyxx.Host.Pages.OfflineModel
@{
    ViewData["Title"] = "Offline";
}

<empty-state icon="i-alert-circle" title="You are offline">
    <p>Skanyxx cannot be reached from this device. Check the connection; the page comes back when it does.</p>
    <div class="empty-state-actions"><a class="btn btn-primary" href="">Try again</a></div>
</empty-state>
