@page
@model StudioModel
@using Skanyxx.Core.Platform.Studio
@{
    ViewData["Title"] = "Studio";
    var me = Model.Me;
}
<page-header description="Start from a template, fill in a short form, and save. Builders open a pull request for review; supervisors and the owner can apply directly. Every change shows its checks and deployment.">
    @if (Model.CanCompose && Model.Overview is { RepoProblem: null } && Model.Options is not null)
    {
        <a class="btn btn-primary" href="#compose"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"/></svg>Compose an agent</a>
    }
</page-header>
@if (Model.Error is not null)
{
    <alert tone="error" title="@(Model.Problems.Count > 0 ? Model.Error : null)">
        @if (Model.Problems.Count > 0)
        {
            <ul data-problems>
                @foreach (var problem in Model.Problems)
                {
                    <li>@problem</li>
                }
            </ul>
        }
        else
        {
            @Model.Error
        }
    </alert>
}
@if (Model.Message is not null)
{
    <alert tone="success">@Model.Message</alert>
}
@if (Model.Notice is not null)
{
    <alert tone="info">@Model.Notice</alert>
}
@if (Model.Overview?.RepoProblem is { } problem)
{
    <alert tone="error" title="The agent repository cannot be used">@problem</alert>
}

@await Component.InvokeAsync("SetupGuide", new { id = "studio" })

@if (Model.Detail is { } detail)
{
    var s = detail.Summary;
    var canMerge = me.CanMerge && detail.Problems.Count == 0 && (!detail.NeedsOwner || me.IsOwner);
    <section class="card" id="proposal" aria-labelledby="proposal-title">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="proposal-title">#@s.Number @s.Title</h2>
                <p class="card-subtitle">Proposed by @(s.ProposedBy == me.UserId ? "you" : s.ProposedBy)</p>
            </div>
            <span class="badges">
                @if (detail.Problems.Count > 0)
                {
                    <status-badge tone="danger" label="Cannot merge" />
                }
                else
                {
                    <status-badge tone="success" label="Open" />
                }
                @if (detail.NeedsOwner)
                {
                    <status-badge tone="warning" label="Owner merges" />
                }
            </span>
        </div>
        <div class="card-body">
            <dl class="kv">
                <dt>Agent</dt><dd><code>@s.Agent</code></dd>
                <dt>Version</dt><dd><code>@s.HeadSha[..Math.Min(12, s.HeadSha.Length)]</code></dd>
                @if (detail.Url.Length > 0)
                {
                    <dt>Pull request</dt><dd><a href="@detail.Url" target="_blank" rel="noopener noreferrer" data-pr-link>Open #@s.Number in git</a></dd>
                }
                <dt>Checks</dt>
                <dd>
                    <status-badge status="@CheckWord(detail.Checks.State)" label="@CheckLabel(detail.Checks.State)" />
                    @if (detail.Checks.Runs.Count > 0)
                    {
                        <ul class="check-runs mt-1" data-checks>
                            @foreach (var run in detail.Checks.Runs)
                            {
                                <li>
                                    <status-badge status="@CheckWord(run.State)" label="@CheckLabel(run.State)" />
                                    @if (run.Url is not null)
                                    {
                                        <a href="@run.Url" target="_blank" rel="noopener noreferrer">@run.Name</a>
                                    }
                                    else
                                    {
                                        @run.Name
                                    }
                                    <span class="text-muted">@run.Description</span>
                                </li>
                            }
                        </ul>
                    }
                </dd>
            </dl>
            <partial name="_ChangeTimeline" model="detail.Steps" />
            @if (detail.Problems.Count > 0)
            {
                <alert tone="error" title="Cannot be merged">@string.Join(" ", detail.Problems)</alert>
            }
            @if (detail.NeedsOwner)
            {
                <alert tone="warning" title="Only the owner merges this">@(s.Plugin is null
                    ? "It sets or removes a team or department grant."
                    : "It brings a plugin from git or a zip (third-party content).")</alert>
            }
            @foreach (var note in detail.Notes)
            {
                <p class="text-secondary" data-note>@note</p>
            }
            <details class="details-admin">
                <summary>Files in this proposal (@detail.Files.Count)</summary>
                @foreach (var file in detail.Files)
                {
                    <h3 class="text-sm mt-2"><code>@file.Path</code> <span class="text-muted">@file.Status</span></h3>
                    <pre class="text-block mt-1" data-file="@file.Path">@file.Content</pre>
                }
            </details>
            <div class="form-actions">
                @if (canMerge)
                {
                    <form method="post" asp-page-handler="Merge" asp-route-pr="@s.Number"
                          data-confirm="Skanyxx merges #@s.Number into the agent repo and applies it to kagent: it is live for everyone it is offered to."
                          data-confirm-title="Merge and make live?" data-confirm-action="Merge">
                        <button type="submit" class="btn btn-primary" data-merge="@s.Number">Merge and make live</button>
                    </form>
                }
                @if (detail.Problems.Count == 0)
                {
                    <form method="post" asp-page-handler="Preview" asp-route-pr="@s.Number" data-once>
                        <button type="submit" class="btn btn-secondary" data-preview="@s.Number">@(detail.Preview is null ? "Start preview" : "Refresh preview")</button>
                    </form>
                }
                @if (me.CanMerge || s.ProposedBy == me.UserId)
                {
                    <form method="post" asp-page-handler="Close" asp-route-pr="@s.Number"
                          data-confirm="The proposal closes without changing anything. It can be proposed again." data-confirm-title="Close #@s.Number?"
                          data-confirm-action="Close" data-danger>
                        <button type="submit" class="btn btn-danger-ghost">Close without merging</button>
                    </form>
                }
            </div>
            @if (detail.Preview is { } preview)
            {
                <section aria-labelledby="preview-title">
                    <h3 class="section-title" id="preview-title">Preview chat <status-badge status="@(preview.Ready ? "ready" : "starting")" /></h3>
                    <p class="section-description mb-1"><code>@preview.Name</code> · it searches memory but never saves to it.</p>
                    <div id="previewLog" class="transcript mb-2" aria-live="polite"></div>
                    <form id="previewChat" class="inline-form" data-number="@s.Number">
                        <input id="previewMessage" maxlength="16000" placeholder="Ask the proposed agent" autocomplete="off" aria-label="Message" class="flex-1" />
                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                </section>
            }
        </div>
    </section>
}

@if (Model.Overview is { RepoProblem: null } overview)
{
    <section class="section" aria-labelledby="open-title">
        <div class="section-header"><h2 class="section-title" id="open-title">Open proposals</h2></div>
        <div class="card card-flush">
            @if (overview.Open.Count == 0)
            {
                <empty-state icon="i-studio" title="No open proposals" compact="true">
                    <p>@(me.CanPropose ? "Compose an agent below, or describe one to the factory." : "Proposals appear here when a builder sends one.")</p>
                </empty-state>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-stack">
                        <thead><tr><th scope="col">#</th><th scope="col">Title</th><th scope="col">Agent</th><th scope="col">Proposed by</th></tr></thead>
                        <tbody>
                            @foreach (var p in overview.Open)
                            {
                                <tr class="@(Model.Detail?.Summary.Number == p.Number ? "is-selected" : null)">
                                    <td><a asp-page="/Studio" asp-route-pr="@p.Number" asp-fragment="proposal">#@p.Number</a></td>
                                    <td>@p.Title</td>
                                    <td><code>@p.Agent</code></td>
                                    <td>@(p.ProposedBy == me.UserId ? "you" : p.ProposedBy)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="section" aria-labelledby="changes-title">
        <div class="section-header">
            <div>
                <h2 class="section-title" id="changes-title">Changes and deployments</h2>
                <p class="section-description">Each change: draft, pull request, checks, merge, deployment to kagent.</p>
            </div>
        </div>
        <div class="card card-flush" data-changes>
            @if (Model.Changes.Count == 0)
            {
                <empty-state icon="i-inbox" title="No changes yet" compact="true">
                    <p>Changes appear here once a form is saved.</p>
                </empty-state>
            }
            @foreach (var c in Model.Changes)
            {
                <article class="change" data-change="@c.Number" aria-labelledby="change-@c.Number">
                    <div class="change-head">
                        <div>
                            <h3 class="tile-title" id="change-@c.Number">
                                @if (c.Status == ChangeStatus.Open)
                                {
                                    <a asp-page="/Studio" asp-route-pr="@c.Number" asp-fragment="proposal">#@c.Number @c.Title</a>
                                }
                                else
                                {
                                    <span>#@c.Number @c.Title</span>
                                }
                            </h3>
                            <p class="tile-sub">@(c.Agent is null ? "" : c.Agent) · proposed by @(c.ProposedBy == me.UserId ? "you" : c.ProposedBy ?? "someone in git")</p>
                        </div>
                        <span class="badges">
                            <status-badge status="@(c.Status == ChangeStatus.Open ? "pending" : c.Status == ChangeStatus.Merged ? "merged" : "neutral")" label="@c.Status.ToString().ToLowerInvariant()" />
                            <status-badge status="@CheckWord(c.Checks.State)" label="@("checks: " + CheckLabel(c.Checks.State))" />
                            @if (c.Deploy is { } d)
                            {
                                <status-badge status="@DeployWord(d.State)" label="@DeployLabel(d)" />
                            }
                            @if (c.Url.Length > 0)
                            {
                                <a class="btn btn-secondary btn-sm" href="@c.Url" target="_blank" rel="noopener noreferrer" data-pr-link>Pull request</a>
                            }
                        </span>
                    </div>
                    <partial name="_ChangeTimeline" model="c.Steps" />
                </article>
            }
        </div>
    </section>

    <section class="section" aria-labelledby="main-title">
        <div class="section-header"><h2 class="section-title" id="main-title">Agents in the repository</h2></div>
        <div class="card card-flush">
            @if (overview.Agents.Count == 0)
            {
                <empty-state icon="i-bot" title="No agents yet" compact="true">
                    <p>The seed agent comes with the install; agents merged here are listed next to it.</p>
                </empty-state>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-stack">
                        <thead><tr><th scope="col">Agent</th><th scope="col">Description</th><th scope="col">In kagent</th><th scope="col" aria-label="Actions"></th></tr></thead>
                        <tbody>
                            @foreach (var a in overview.Agents)
                            {
                                <tr>
                                    <td><code>@a.Name</code></td>
                                    <td>@a.Description</td>
                                    <td><status-badge status="@(a.Live ? "live" : "pending")" label="@(a.Live ? "live (merged)" : "not yet applied")" /></td>
                                    <td>
                                        @if (Model.CanCompose)
                                        {
                                            <div class="row-actions"><a class="btn btn-secondary btn-sm" asp-page="/Studio" asp-route-edit="@a.Name" asp-fragment="compose">@(me.CanMerge ? "Change" : "Propose a change")</a></div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    @if (Model.CanCompose && Model.Options is { } options)
    {
        <section class="section" aria-labelledby="templates-title">
            <div class="section-header">
                <div>
                    <h2 class="section-title" id="templates-title">Start from a template</h2>
                    <p class="section-description">Pick the role closest to what you need; the form below is filled in for you to adjust. No YAML needed.</p>
                </div>
            </div>
            <div class="card-grid" data-templates>
                @foreach (var t in Model.Templates)
                {
                    <article class="card tile@(t.Locked ? " is-locked" : "")" data-template="@t.Id" aria-labelledby="template-@t.Id">
                        <div class="tile-head">
                            <div>
                                <h3 class="tile-title" id="template-@t.Id">@t.Title</h3>
                                <p class="tile-sub">@t.Role</p>
                            </div>
                            @if (t.CloudTools)
                            {
                                <status-badge tone="warning" label="@(t.Locked ? "Paid · locked" : "Paid · cloud tools")" />
                            }
                        </div>
                        <p class="text-secondary text-sm">@t.Summary</p>
                        <div class="tile-actions">
                            @if (t.Locked)
                            {
                                <p class="lock-note" data-locked>Cloud tools are a paid feature. The owner turns them on (the licence Skanyxx:Licence:CloudTools, then Settings → Features).</p>
                            }
                            else
                            {
                                <a class="btn btn-secondary btn-sm" asp-page="/Studio" asp-route-template="@t.Id" asp-fragment="compose">Use this template</a>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        @if (me.CanPropose)
        {
            <section class="section" aria-labelledby="factory-title">
                <div class="section-header">
                    <div>
                        <h2 class="section-title" id="factory-title">Describe an agent</h2>
                        <p class="section-description">The factory drafts the form below from your words. It creates nothing.</p>
                    </div>
                </div>
                <form method="post" asp-page-handler="Factory" class="toolbar" data-once>
                    <input name="FactoryRequest" maxlength="4000" placeholder="e.g. a refund helper that answers from company memory" autocomplete="off" aria-label="Describe the agent" class="flex-1" />
                    <button type="submit" class="btn btn-secondary">Draft</button>
                </form>
            </section>
        }

        <section class="section" aria-labelledby="compose-title">
            <form method="post" asp-page-handler="Propose" class="form" id="compose" data-once>
                <div>
                    <h2 class="section-title" id="compose-title">@(string.IsNullOrEmpty(Model.Edit) ? "Compose an agent" : $"Change {Model.Edit}")</h2>
                    <p class="section-description">@(me.CanMerge
                        ? "Apply now opens a pull request and merges it at once (you may merge). Propose leaves it for review."
                        : "Saving opens a pull request; a supervisor reviews and merges it.")</p>
                </div>
                <div class="field">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" required maxlength="34" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off" aria-describedby="name-hint" />
                    <p class="field-hint" id="name-hint">Lowercase letters, digits and <code>-</code>.</p>
                </div>
                <div class="field">
                    <label asp-for="Description">Description <span class="field-optional">(optional)</span></label>
                    <input asp-for="Description" maxlength="500" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="ModelConfig">Model</label>
                    <select asp-for="ModelConfig">
                        @foreach (var m in options.ModelConfigs)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Instructions">Instructions</label>
                    <textarea asp-for="Instructions" rows="8" maxlength="16000" required aria-describedby="instructions-hint"></textarea>
                    <p class="field-hint" id="instructions-hint">The agent's job, its tone, and what it must not do.</p>
                </div>
                <fieldset class="form-section">
                    <legend>Tools</legend>
                    <p class="form-section-hint">From the allowed tool servers and merged plugin servers.</p>
                    @if (options.McpServers.Count == 0)
                    {
                        <p class="text-muted text-sm">None are allowed yet (Studio:McpServers).</p>
                    }
                    @foreach (var server in options.McpServers)
                    {
                        var paid = options.PaidServers.Contains(server.Server);
                        var locked = Model.Locked(server.Server);
                        <div class="subcard@(locked ? " is-locked" : "")" data-server="@server.Server">
                            <code>@server.Server</code>
                            @if (paid)
                            {
                                <status-badge tone="warning" label="@(locked ? "Paid · locked" : "Paid · cloud tools")" />
                            }
                            @if (locked)
                            {
                                <p class="lock-note" data-locked>Calls a cloud provider's API. Cloud tools are a paid feature that is not turned on; the owner turns it on (the licence Skanyxx:Licence:CloudTools, then Settings → Features). Tools the agent already has stay ticked and keep working; you can untick them, not add more.</p>
                            }
                            <div class="checks">
                                @foreach (var tool in server.Tools)
                                {
                                    var value = $"{server.Server}/{tool}";
                                    var ticked = Model.Ticked(Model.Tools, value);
                                    @* Locked: an unticked tool cannot be added, a ticked one can still be unticked (D388); kept as main has it, the save allows it. *@
                                    <label class="check"><input type="checkbox" name="Tools" value="@value" checked="@ticked" disabled="@(locked && !ticked)" data-locked-kept="@(locked && ticked ? "" : null)" /> @tool</label>
                                }
                            </div>
                        </div>
                    }
                </fieldset>
                <fieldset class="form-section">
                    <legend>Company memory</legend>
                    <p class="form-section-hint">Which cards the agent may search, and where it may save. Team and department grants are merged by the owner.</p>
                    <div class="table-container">
                        <table class="table">
                            <thead><tr><th scope="col">Scope</th><th scope="col">Search</th><th scope="col">Save (upsert)</th></tr></thead>
                            <tbody>
                                @foreach (var scope in options.Scopes)
                                {
                                    <tr>
                                        <td><code>@scope</code>@(scope == "company" ? "" : " (owner merges)")</td>
                                        <td><input type="checkbox" name="Search" value="@scope" checked="@Model.Ticked(Model.Search, scope)" aria-label="Search @scope" /></td>
                                        <td><input type="checkbox" name="Upsert" value="@scope" checked="@Model.Ticked(Model.Upsert, scope)" aria-label="Upsert @scope" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </fieldset>
                <details class="details-admin">
                    <summary>Advanced: skills and kagent memory</summary>
                    <div class="stack">
                        <div class="field">
                            <label asp-for="Skills">Skills <span class="field-optional">(optional)</span></label>
                            <textarea asp-for="Skills" rows="2" aria-describedby="skills-hint"></textarea>
                            <p class="field-hint" id="skills-hint">OCI image references, one per line.</p>
                        </div>
                        <div class="field">
                            <label asp-for="TtlDays">kagent memory, days <span class="field-optional">(optional)</span></label>
                            <input asp-for="TtlDays" type="number" min="1" max="365" aria-describedby="ttl-hint" />
                            <p class="field-hint" id="ttl-hint">Empty = off. What the agent remembers between chats; not the company's cards.</p>
                        </div>
                    </div>
                </details>
                <details class="details-admin" id="yamlPreview">
                    <summary>Show the YAML (optional)</summary>
                    <p class="field-hint">What saving puts in git, checked with the same rules. You never need to edit it.</p>
                    <button type="button" class="btn btn-secondary btn-sm" id="yamlRefresh">Check and show YAML</button>
                    <div id="yamlProblems" aria-live="polite"></div>
                    <pre class="text-block mt-1 yaml-preview" id="yamlAgent" hidden></pre>
                    <pre class="text-block mt-1 yaml-preview" id="yamlGrants" hidden></pre>
                </details>
                <div class="form-actions">
                    @if (me.CanMerge)
                    {
                        <button type="submit" class="btn btn-primary" asp-page-handler="Apply" data-apply>Apply now (merge directly)</button>
                    }
                    @if (me.CanPropose)
                    {
                        <button type="submit" class="btn @(me.CanMerge ? "btn-secondary" : "btn-primary")" data-propose>Propose (opens a pull request)</button>
                    }
                </div>
            </form>
        </section>
    }
}

<section class="section" aria-labelledby="ci-title">
    <details class="details-admin" id="ciTemplate">
        <summary id="ci-title">CI for the agent repo: the workflow file</summary>
        <p class="field-hint">Commit it as <code>.gitea/workflows/validate-agents.yaml</code> (or <code>.github/workflows/</code>). It checks each agent folder with the rules a merge applies; its result shows as "Checks" on every change. The setup guide above has the steps (CI token, Argo CD, licence).</p>
        @if (me.IsOwner && Model.Overview is { RepoProblem: null })
        {
            <form method="post" asp-page-handler="InstallCi" class="mt-1" data-once
                  data-confirm="Skanyxx opens one pull request with only this workflow file and merges it into the agent repo." data-confirm-title="Add CI to the agent repo?" data-confirm-action="Add">
                <button type="submit" class="btn btn-secondary btn-sm" data-install-ci>Add CI to the agent repo</button>
            </form>
        }
        <div class="setup-command"><code id="ciTemplateText" data-ci-template>Loading…</code><copy-button target="#ciTemplateText" label="Copy" /></div>
    </details>
</section>

@functions {
    private static string CheckWord(CheckState state) => state switch
    {
        CheckState.Passed => "succeeded",
        CheckState.Failed => "failed",
        CheckState.Pending => "pending",
        _ => "neutral"
    };

    private static string CheckLabel(CheckState state) => state switch
    {
        CheckState.Passed => "passed",
        CheckState.Failed => "failed",
        CheckState.Pending => "running",
        _ => "no CI"
    };

    private static string DeployWord(DeployState state) => state switch
    {
        DeployState.Healthy => "healthy",
        DeployState.Failed => "failed",
        DeployState.Suspended => "suspended",
        DeployState.Unknown => "unknown",
        _ => "pending"
    };

    private static string DeployLabel(DeployStatus d) => d.State switch
    {
        DeployState.Healthy => $"deployed · {d.Source}",
        DeployState.Syncing => $"syncing · {d.Source}",
        DeployState.Waiting => $"waiting · {d.Source}",
        DeployState.Failed => $"deploy failed · {d.Source}",
        DeployState.Suspended => "suspended",
        _ => $"deploy unknown · {d.Source}"
    };
}

<script>
    (() => {
        const ci = document.getElementById('ciTemplate');
        ci?.addEventListener('toggle', async () => {
            const target = document.getElementById('ciTemplateText');
            if (!ci.open || target.dataset.loaded) return;
            try {
                const response = await fetch('/api/studio/ci-template', { headers: { Accept: 'text/yaml' } });
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                target.textContent = await response.text();
                target.dataset.loaded = '1';
            } catch (error) {
                target.textContent = `The workflow could not be loaded (${error.message}).`;
            }
        });

        const compose = document.getElementById('compose');
        const refresh = document.getElementById('yamlRefresh');
        refresh?.addEventListener('click', async () => {
            const data = new FormData(compose);
            const tools = {};
            for (const value of data.getAll('Tools')) {
                const [server, tool] = value.split('/', 2);
                (tools[server] ??= []).push(tool);
            }
            const search = data.getAll('Search'), upsert = data.getAll('Upsert');
            const scopes = [...new Set([...search, ...upsert])];
            const ttl = parseInt(data.get('TtlDays'), 10);
            const draft = {
                name: data.get('Name') ?? '', description: data.get('Description') ?? '', modelConfig: data.get('ModelConfig') ?? '',
                instructions: data.get('Instructions') ?? '', skills: (data.get('Skills') ?? '').split('\n'),
                mcpTools: Object.entries(tools).map(([server, list]) => ({ server, tools: list })),
                grants: scopes.map(scope => ({ scope, search: search.includes(scope), upsert: upsert.includes(scope) })),
                memoryTtlDays: Number.isNaN(ttl) ? null : ttl
            };
            const problems = document.getElementById('yamlProblems');
            problems.replaceChildren();
            try {
                const preview = await skx.busy(refresh, skx.api('POST', '/api/studio/manifest', draft));
                for (const [id, text] of [['yamlAgent', preview.agentYaml], ['yamlGrants', preview.grantsYaml]]) {
                    const pre = document.getElementById(id);
                    pre.textContent = text;
                    pre.hidden = false;
                }
                const box = document.createElement('div');
                box.className = `alert alert-${preview.problems.length ? 'error' : 'success'} mt-1`;
                box.setAttribute('role', 'status');
                if (preview.problems.length) {
                    const list = document.createElement('ul');
                    for (const problem of preview.problems) {
                        const li = document.createElement('li');
                        li.textContent = problem;
                        list.appendChild(li);
                    }
                    box.append('Fix these before saving:', list);
                } else {
                    box.textContent = 'Looks good: this can be saved.';
                }
                problems.appendChild(box);
            } catch (error) {
                skx.toast(error.message, { tone: 'error' });
            }
        });
    })();
</script>

<script>
    (() => {
        const form = document.getElementById('previewChat');
        if (!form) return;
        const log = document.getElementById('previewLog');
        const input = document.getElementById('previewMessage');
        let conversationId = null;
        const line = (who, text, kind) => {
            const p = document.createElement('div');
            p.className = `transcript-line${kind ? ' ' + kind : ''}`;
            const b = document.createElement('span');
            b.className = 'transcript-who';
            b.textContent = who;
            p.append(b, document.createTextNode(text));
            log.appendChild(p);
            log.scrollTop = log.scrollHeight;
        };
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = input.value.trim();
            if (!message) return;
            input.value = '';
            line('You', message, 'is-you');
            const send = form.querySelector('button[type=submit]');
            try {
                const body = await skx.busy(send, skx.api('POST', `/api/studio/proposals/${form.dataset.number}/chat`, { message, conversationId }));
                conversationId = body.conversationId;
                line('Preview', body.message?.content ?? '');
            } catch (error) {
                line('Error', error.message, 'is-error');
                // kagent's own words, for the studio's builders and up (D556): text only, cut visibly.
                const why = skx.kagentReason(error.data?.kagentReason);
                if (why) {
                    log.lastElementChild.append(why);
                    log.scrollTop = log.scrollHeight;
                }
            }
        });
    })();
</script>
