@page
@model StudioModel
@{
    ViewData["Title"] = "Studio";
    var me = Model.Me;
}
<page-header description="Propose agents for review. Nothing is live until a supervisor merges it; Skanyxx then applies it to kagent.">
    @if (me.CanPropose && Model.Overview is { RepoProblem: null } && Model.Options is not null)
    {
        <a class="btn btn-primary" href="#compose"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-plus"/></svg>Compose an agent</a>
    }
</page-header>
@if (Model.Error is not null)
{
    <alert tone="error">@Model.Error</alert>
}
@if (Model.Message is not null)
{
    <alert tone="success">@Model.Message</alert>
}
@if (Model.Overview?.RepoProblem is { } problem)
{
    <alert tone="error" title="The agent repository cannot be used">@problem</alert>
}

@await Component.InvokeAsync("SetupGuide", new { id = "studio" })

@if (Model.Detail is { } detail)
{
    var s = detail.Summary;
    var canMerge = me.CanMerge && detail.Problems.Count == 0 && (!detail.NeedsOwner || me.IsOwner);
    <section class="card" id="proposal" aria-labelledby="proposal-title">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="proposal-title">#@s.Number @s.Title</h2>
                <p class="card-subtitle">Proposed by @(s.ProposedBy == me.UserId ? "you" : s.ProposedBy)</p>
            </div>
            <span class="badges">
                @if (detail.Problems.Count > 0)
                {
                    <status-badge tone="danger" label="Cannot merge" />
                }
                else
                {
                    <status-badge tone="success" label="Open" />
                }
                @if (detail.NeedsOwner)
                {
                    <status-badge tone="warning" label="Owner merges" />
                }
            </span>
        </div>
        <div class="card-body">
            <dl class="kv">
                <dt>Agent</dt><dd><code>@s.Agent</code></dd>
                <dt>Version</dt><dd><code>@s.HeadSha[..Math.Min(12, s.HeadSha.Length)]</code></dd>
            </dl>
            @if (detail.Problems.Count > 0)
            {
                <alert tone="error" title="Cannot be merged">@string.Join(" ", detail.Problems)</alert>
            }
            @if (detail.NeedsOwner)
            {
                <alert tone="warning" title="Only the owner merges this">@(s.Plugin is null
                    ? "It sets or removes a team or department grant."
                    : "It brings a plugin from git or a zip (third-party content).")</alert>
            }
            @foreach (var note in detail.Notes)
            {
                <p class="text-secondary" data-note>@note</p>
            }
            <details class="details-admin">
                <summary>Files in this proposal (@detail.Files.Count)</summary>
                @foreach (var file in detail.Files)
                {
                    <h3 class="text-sm mt-2"><code>@file.Path</code> <span class="text-muted">@file.Status</span></h3>
                    <pre class="text-block mt-1" data-file="@file.Path">@file.Content</pre>
                }
            </details>
            <div class="form-actions">
                @if (canMerge)
                {
                    <form method="post" asp-page-handler="Merge" asp-route-pr="@s.Number"
                          data-confirm="Skanyxx merges #@s.Number into the agent repo and applies it to kagent: it is live for everyone it is offered to."
                          data-confirm-title="Merge and make live?" data-confirm-action="Merge">
                        <button type="submit" class="btn btn-primary" data-merge="@s.Number">Merge and make live</button>
                    </form>
                }
                @if (detail.Problems.Count == 0)
                {
                    <form method="post" asp-page-handler="Preview" asp-route-pr="@s.Number" data-once>
                        <button type="submit" class="btn btn-secondary" data-preview="@s.Number">@(detail.Preview is null ? "Start preview" : "Refresh preview")</button>
                    </form>
                }
                @if (me.CanMerge || s.ProposedBy == me.UserId)
                {
                    <form method="post" asp-page-handler="Close" asp-route-pr="@s.Number"
                          data-confirm="The proposal closes without changing anything. It can be proposed again." data-confirm-title="Close #@s.Number?"
                          data-confirm-action="Close" data-danger>
                        <button type="submit" class="btn btn-danger-ghost">Close without merging</button>
                    </form>
                }
            </div>
            @if (detail.Preview is { } preview)
            {
                <section aria-labelledby="preview-title">
                    <h3 class="section-title" id="preview-title">Preview chat <status-badge status="@(preview.Ready ? "ready" : "starting")" /></h3>
                    <p class="section-description mb-1"><code>@preview.Name</code> · it searches memory but never saves to it.</p>
                    <div id="previewLog" class="transcript mb-2" aria-live="polite"></div>
                    <form id="previewChat" class="inline-form" data-number="@s.Number">
                        <input id="previewMessage" maxlength="16000" placeholder="Ask the proposed agent" autocomplete="off" aria-label="Message" class="flex-1" />
                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                </section>
            }
        </div>
    </section>
}

@if (Model.Overview is { RepoProblem: null } overview)
{
    <section class="section" aria-labelledby="open-title">
        <div class="section-header"><h2 class="section-title" id="open-title">Open proposals</h2></div>
        <div class="card card-flush">
            @if (overview.Open.Count == 0)
            {
                <empty-state icon="i-studio" title="No open proposals" compact="true">
                    <p>@(me.CanPropose ? "Compose an agent below, or describe one to the factory." : "Proposals appear here when a builder sends one.")</p>
                </empty-state>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-stack">
                        <thead><tr><th scope="col">#</th><th scope="col">Title</th><th scope="col">Agent</th><th scope="col">Proposed by</th></tr></thead>
                        <tbody>
                            @foreach (var p in overview.Open)
                            {
                                <tr class="@(Model.Detail?.Summary.Number == p.Number ? "is-selected" : null)">
                                    <td><a asp-page="/Studio" asp-route-pr="@p.Number" asp-fragment="proposal">#@p.Number</a></td>
                                    <td>@p.Title</td>
                                    <td><code>@p.Agent</code></td>
                                    <td>@(p.ProposedBy == me.UserId ? "you" : p.ProposedBy)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="section" aria-labelledby="main-title">
        <div class="section-header"><h2 class="section-title" id="main-title">Agents in the repository</h2></div>
        <div class="card card-flush">
            @if (overview.Agents.Count == 0)
            {
                <empty-state icon="i-bot" title="No agents yet" compact="true">
                    <p>The seed agent comes with the install; agents merged here are listed next to it.</p>
                </empty-state>
            }
            else
            {
                <div class="table-container">
                    <table class="table table-stack">
                        <thead><tr><th scope="col">Agent</th><th scope="col">Description</th><th scope="col">In kagent</th><th scope="col" aria-label="Actions"></th></tr></thead>
                        <tbody>
                            @foreach (var a in overview.Agents)
                            {
                                <tr>
                                    <td><code>@a.Name</code></td>
                                    <td>@a.Description</td>
                                    <td><status-badge status="@(a.Live ? "live" : "pending")" label="@(a.Live ? "live (merged)" : "not yet applied")" /></td>
                                    <td>
                                        @if (me.CanPropose)
                                        {
                                            <div class="row-actions"><a class="btn btn-secondary btn-sm" asp-page="/Studio" asp-route-edit="@a.Name" asp-fragment="compose">Propose a change</a></div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    @if (me.CanPropose && Model.Options is { } options)
    {
        <section class="section" aria-labelledby="factory-title">
            <div class="section-header">
                <div>
                    <h2 class="section-title" id="factory-title">Describe an agent</h2>
                    <p class="section-description">The factory drafts the form below from your words. It creates nothing.</p>
                </div>
            </div>
            <form method="post" asp-page-handler="Factory" class="toolbar" data-once>
                <input name="FactoryRequest" maxlength="4000" placeholder="e.g. a refund helper that answers from company memory" autocomplete="off" aria-label="Describe the agent" class="flex-1" />
                <button type="submit" class="btn btn-secondary">Draft</button>
            </form>
        </section>

        <section class="section" aria-labelledby="compose-title">
            <form method="post" asp-page-handler="Propose" class="form" id="compose" data-once>
                <div>
                    <h2 class="section-title" id="compose-title">@(string.IsNullOrEmpty(Model.Edit) ? "Compose an agent" : $"Change {Model.Edit}")</h2>
                    <p class="section-description">Saving opens a pull request; a supervisor reviews and merges it.</p>
                </div>
                <div class="field">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" required maxlength="34" pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?" autocomplete="off" aria-describedby="name-hint" />
                    <p class="field-hint" id="name-hint">Lowercase letters, digits and <code>-</code>.</p>
                </div>
                <div class="field">
                    <label asp-for="Description">Description <span class="field-optional">(optional)</span></label>
                    <input asp-for="Description" maxlength="500" autocomplete="off" />
                </div>
                <div class="field">
                    <label asp-for="ModelConfig">Model</label>
                    <select asp-for="ModelConfig">
                        @foreach (var m in options.ModelConfigs)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label asp-for="Instructions">Instructions</label>
                    <textarea asp-for="Instructions" rows="8" maxlength="16000" required aria-describedby="instructions-hint"></textarea>
                    <p class="field-hint" id="instructions-hint">The agent's job, its tone, and what it must not do.</p>
                </div>
                <fieldset class="form-section">
                    <legend>Tools</legend>
                    <p class="form-section-hint">From the allowed tool servers and merged plugin servers.</p>
                    @if (options.McpServers.Count == 0)
                    {
                        <p class="text-muted text-sm">None are allowed yet (Studio:McpServers).</p>
                    }
                    @foreach (var server in options.McpServers)
                    {
                        <div class="subcard">
                            <code>@server.Server</code>
                            <div class="checks">
                                @foreach (var tool in server.Tools)
                                {
                                    var value = $"{server.Server}/{tool}";
                                    <label class="check"><input type="checkbox" name="Tools" value="@value" checked="@Model.Ticked(Model.Tools, value)" /> @tool</label>
                                }
                            </div>
                        </div>
                    }
                </fieldset>
                <fieldset class="form-section">
                    <legend>Company memory</legend>
                    <p class="form-section-hint">Which cards the agent may search, and where it may save. Team and department grants are merged by the owner.</p>
                    <div class="table-container">
                        <table class="table">
                            <thead><tr><th scope="col">Scope</th><th scope="col">Search</th><th scope="col">Save (upsert)</th></tr></thead>
                            <tbody>
                                @foreach (var scope in options.Scopes)
                                {
                                    <tr>
                                        <td><code>@scope</code>@(scope == "company" ? "" : " (owner merges)")</td>
                                        <td><input type="checkbox" name="Search" value="@scope" checked="@Model.Ticked(Model.Search, scope)" aria-label="Search @scope" /></td>
                                        <td><input type="checkbox" name="Upsert" value="@scope" checked="@Model.Ticked(Model.Upsert, scope)" aria-label="Upsert @scope" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </fieldset>
                <details class="details-admin">
                    <summary>Advanced: skills and kagent memory</summary>
                    <div class="stack">
                        <div class="field">
                            <label asp-for="Skills">Skills <span class="field-optional">(optional)</span></label>
                            <textarea asp-for="Skills" rows="2" aria-describedby="skills-hint"></textarea>
                            <p class="field-hint" id="skills-hint">OCI image references, one per line.</p>
                        </div>
                        <div class="field">
                            <label asp-for="TtlDays">kagent memory, days <span class="field-optional">(optional)</span></label>
                            <input asp-for="TtlDays" type="number" min="1" max="365" aria-describedby="ttl-hint" />
                            <p class="field-hint" id="ttl-hint">Empty = off. What the agent remembers between chats; not the company's cards.</p>
                        </div>
                    </div>
                </details>
                <div class="form-actions"><button type="submit" class="btn btn-primary">Propose (opens a pull request)</button></div>
            </form>
        </section>
    }
}

<script>
    (() => {
        const form = document.getElementById('previewChat');
        if (!form) return;
        const log = document.getElementById('previewLog');
        const input = document.getElementById('previewMessage');
        let conversationId = null;
        const line = (who, text, kind) => {
            const p = document.createElement('div');
            p.className = `transcript-line${kind ? ' ' + kind : ''}`;
            const b = document.createElement('span');
            b.className = 'transcript-who';
            b.textContent = who;
            p.append(b, document.createTextNode(text));
            log.appendChild(p);
            log.scrollTop = log.scrollHeight;
        };
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const message = input.value.trim();
            if (!message) return;
            input.value = '';
            line('You', message, 'is-you');
            const send = form.querySelector('button[type=submit]');
            try {
                const body = await skx.busy(send, skx.api('POST', `/api/studio/proposals/${form.dataset.number}/chat`, { message, conversationId }));
                conversationId = body.conversationId;
                line('Preview', body.message?.content ?? '');
            } catch (error) {
                line('Error', error.message, 'is-error');
            }
        });
    })();
</script>
