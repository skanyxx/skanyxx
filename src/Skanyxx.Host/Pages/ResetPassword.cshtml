@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}
@if (Model.Error is not null)
{
    <alert tone="error">@Model.Error</alert>
}
@if (Model.Reset is not null)
{
    <p class="text-secondary">New password for <strong>@Model.Reset.Email</strong>. Saving it signs this account out everywhere.</p>
    <form method="post" class="form auth-form" data-once>
        <input type="hidden" asp-for="Token" />
        <input type="email" value="@Model.Reset.Email" autocomplete="username" readonly hidden />
        <div class="field">
            <label asp-for="Password">New password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" autofocus aria-describedby="Password-hint" />
            <p class="field-hint" id="Password-hint">At least 12 characters.</p>
        </div>
        <button type="submit" class="btn btn-primary">Save the new password</button>
    </form>
}
<p><a href="/Login">Back to sign in</a></p>
