@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}
@if (Model.Error is not null)
{
    <p class="text-error" role="alert">@Model.Error</p>
}
@if (Model.Reset is not null)
{
    <p class="text-muted">New password for <strong>@Model.Reset.Email</strong>. Saving it signs this account out everywhere.</p>
    <form method="post" class="auth-form" onsubmit="this.querySelector('button[type=submit]').disabled = true">
        <input type="hidden" asp-for="Token" />
        <input type="email" value="@Model.Reset.Email" autocomplete="username" readonly hidden />
        <label asp-for="Password">New password (at least 12 characters)</label>
        <input asp-for="Password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" autofocus />
        <button type="submit" class="btn btn-primary">Save the new password</button>
    </form>
}
<p><a href="/Login">Back to sign in</a></p>
