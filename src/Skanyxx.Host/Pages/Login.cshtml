@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
@if (Model.Error is not null)
{
    <alert tone="error">@Model.Error</alert>
}
else if (Model.Reset)
{
    <alert tone="success">Your password was changed and every session ended. Sign in with the new one.</alert>
}
@* data-once: the button is busy after the first click; a second sign-in in flight for the same account is refused as busy. *@
<form method="post" class="form auth-form" data-once>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="field">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="username" required autofocus />
    </div>
    <div class="field">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" autocomplete="current-password" required />
    </div>
    <details class="details-admin">
        <summary>Owner locked out?</summary>
        <div class="field">
            <label asp-for="BootstrapToken">Bootstrap token</label>
            <input asp-for="BootstrapToken" type="password" autocomplete="off" maxlength="512" aria-describedby="BootstrapToken-hint" />
            <p class="field-hint" id="BootstrapToken-hint">The token from the install output (<code>Identity:BootstrapToken</code>). With it, the owner's password works again.</p>
        </div>
    </details>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
@if (Model.PasswordResetByEmail)
{
    <p><a href="/ForgotPassword">Forgot your password?</a></p>
}
@if (Model.MicrosoftSignIn)
{
    @* Fixed, whoever signs in: a Microsoft-managed account's password gets the same "invalid" answer as a wrong one (SEC N3). *@
    <p class="field-hint">@LoginModel.MicrosoftHint</p>
    <form method="post" asp-page-handler="Microsoft" asp-route-returnUrl="@Model.ReturnUrl" class="form auth-form" data-once>
        <button type="submit" class="btn btn-secondary">Sign in with Microsoft</button>
    </form>
}
