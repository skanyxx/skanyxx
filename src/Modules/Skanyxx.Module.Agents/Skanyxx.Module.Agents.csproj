<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\Skanyxx.Core\Skanyxx.Core.csproj" />
  </ItemGroup>
  <!-- Runtime copy comes from the Host (PluginLoadContext shared list); the module ships only its own dll. -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <!-- The built-in plugin catalog (a Claude Code marketplace), read by CatalogPluginSource. -->
  <ItemGroup>
    <EmbeddedResource Include="Plugins/Catalog/**/*" LogicalName="catalog/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The agent repo's CI workflow (D362): one file, shown on /Studio and committed for operators. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../../docs/templates/agents-repo/validate-agents.yaml" LogicalName="studio/validate-agents.yaml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Skanyxx.Host.Tests" />
  </ItemGroup>
  <Target Name="CopyToModules" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\Skanyxx.Host\modules\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(MSBuildThisFileDirectory)..\..\Skanyxx.Host\modules\" />
  </Target>
</Project>
